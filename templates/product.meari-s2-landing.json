    "custom_liquid_bUg4tN": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SmartGadgets.eu — MEARI S2 Plus\n  Section 02: Interactive Product Explorer\n{% endcomment %}\n\n{% assign sg_s2_explorer_image = 'https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_22_2026_01_00_43_PM.png?v=1784718061' %}\n\n<section id=\"sg-s2-explorer-{{ section.id }}\" class=\"sg-s2-explorer\" aria-labelledby=\"sg-s2-explorer-title-{{ section.id }}\">\n  <div class=\"sg-s2-explorer__inner\">\n    <header class=\"sg-s2-explorer__header\">\n      <p class=\"sg-s2-explorer__eyebrow\">ONTDEK DE CAMERA</p>\n      <h2 id=\"sg-s2-explorer-title-{{ section.id }}\">Slim ontworpen. Volledig onder controle.</h2>\n      <p>\n        Bekijk de belangrijkste onderdelen van de MEARI S2 Plus. Selecteer een punt\n        om te zien hoe iedere functie bijdraagt aan betrouwbare beveiliging.\n      </p>\n    </header>\n\n    <div class=\"sg-s2-explorer__stage\">\n      <div class=\"sg-s2-explorer__visual\">\n        <div class=\"sg-s2-explorer__halo\" aria-hidden=\"true\"></div>\n        <div class=\"sg-s2-explorer__rings\" aria-hidden=\"true\"></div>\n\n        <img\n          class=\"sg-s2-explorer__image\"\n          src=\"{{ sg_s2_explorer_image }}\"\n          alt=\"MEARI S2 Plus beveiligingscamera met interactieve functiepunten\"\n          width=\"1313\"\n          height=\"1198\"\n          loading=\"lazy\"\n        >\n\n        <button class=\"sg-s2-hotspot is-active\" type=\"button\" data-feature=\"lens\" style=\"--x:48%;--y:63%;\" aria-label=\"Bekijk 4MP camera\">\n          <span>1</span>\n        </button>\n\n        <button class=\"sg-s2-hotspot\" type=\"button\" data-feature=\"lights\" style=\"--x:49%;--y:73%;\" aria-label=\"Bekijk full-color nachtzicht\">\n          <span>2</span>\n        </button>\n\n        <button class=\"sg-s2-hotspot\" type=\"button\" data-feature=\"ptz\" style=\"--x:68%;--y:57%;\" aria-label=\"Bekijk 355 graden PTZ\">\n          <span>3</span>\n        </button>\n\n        <button class=\"sg-s2-hotspot\" type=\"button\" data-feature=\"wifi\" style=\"--x:72%;--y:20%;\" aria-label=\"Bekijk dual-band verbinding\">\n          <span>4</span>\n        </button>\n      </div>\n\n      <div class=\"sg-s2-explorer__panel\" aria-live=\"polite\">\n        <div class=\"sg-s2-explorer__panel-top\">\n          <span class=\"sg-s2-explorer__number\">01</span>\n          <span class=\"sg-s2-explorer__label\">CAMERA</span>\n        </div>\n\n        <div class=\"sg-s2-feature-copy is-active\" data-content=\"lens\">\n          <h3>4MP Super HD</h3>\n          <p>\n            Leg gezichten, voertuigen en belangrijke details helder vast met een\n            hogere resolutie dan standaard Full HD.\n          </p>\n          <ul>\n            <li>Scherp beeld, overdag en ’s nachts</li>\n            <li>Meer detail bij digitaal inzoomen</li>\n            <li>Geschikt voor tuin, oprit en ingang</li>\n          </ul>\n        </div>\n\n        <div class=\"sg-s2-feature-copy\" data-content=\"lights\">\n          <h3>Full-Color Nachtzicht</h3>\n          <p>\n            De ingebouwde verlichting helpt de camera om ook in het donker\n            meer kleur en bruikbare details te tonen.\n          </p>\n          <ul>\n            <li>Kleurbeeld bij weinig licht</li>\n            <li>Extra zicht rondom de camera</li>\n            <li>Duidelijkere nachtelijke opnames</li>\n          </ul>\n        </div>\n\n        <div class=\"sg-s2-feature-copy\" data-content=\"ptz\">\n          <h3>355° PTZ-bereik</h3>\n          <p>\n            Draai en kantel de camera via de app om een veel groter gebied met\n            één camera te bewaken.\n          </p>\n          <ul>\n            <li>Brede horizontale dekking</li>\n            <li>Bediening via de MEARI-app</li>\n            <li>Automatische tracking bij beweging</li>\n          </ul>\n        </div>\n\n        <div class=\"sg-s2-feature-copy\" data-content=\"wifi\">\n          <h3>Stabiele verbinding</h3>\n          <p>\n            De dubbele antennes ondersteunen een betrouwbare verbinding voor\n            livebeeld, meldingen en bediening op afstand.\n          </p>\n          <ul>\n            <li>WiFi en Ethernet-ondersteuning</li>\n            <li>Live meekijken op uw telefoon</li>\n            <li>Directe slimme meldingen</li>\n          </ul>\n        </div>\n\n        <div class=\"sg-s2-explorer__nav\" aria-label=\"Functies selecteren\">\n          <button type=\"button\" class=\"is-active\" data-feature=\"lens\">4MP</button>\n          <button type=\"button\" data-feature=\"lights\">Nachtzicht</button>\n          <button type=\"button\" data-feature=\"ptz\">PTZ</button>\n          <button type=\"button\" data-feature=\"wifi\">Verbinding</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  #sg-s2-explorer-{{ section.id }} {\n    --sg-blue: #168fff;\n    --sg-blue-soft: #65c5ff;\n    --sg-dark: #020916;\n    --sg-panel: #07162a;\n    position: relative;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 25% 45%, rgba(20, 126, 255, .12), transparent 34%),\n      linear-gradient(180deg, #f8fbff 0%, #eef5fb 100%);\n    color: #071426;\n    padding: 110px 0;\n  }\n\n  #sg-s2-explorer-{{ section.id }} *,\n  #sg-s2-explorer-{{ section.id }} *::before,\n  #sg-s2-explorer-{{ section.id }} *::after {\n    box-sizing: border-box;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__inner {\n    width: min(1420px, calc(100% - 64px));\n    margin: 0 auto;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__header {\n    max-width: 820px;\n    margin: 0 auto 62px;\n    text-align: center;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__eyebrow {\n    margin: 0 0 15px !important;\n    color: var(--sg-blue) !important;\n    font-size: 14px !important;\n    line-height: 1.2 !important;\n    font-weight: 800 !important;\n    letter-spacing: .22em !important;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__header h2 {\n    margin: 0 !important;\n    color: #061426 !important;\n    font-size: clamp(38px, 4.2vw, 68px) !important;\n    line-height: 1.02 !important;\n    letter-spacing: -.045em !important;\n    font-weight: 780 !important;\n    text-transform: none !important;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__header > p:last-child {\n    max-width: 700px;\n    margin: 24px auto 0 !important;\n    color: #526173 !important;\n    font-size: clamp(17px, 1.4vw, 21px) !important;\n    line-height: 1.6 !important;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__stage {\n    display: grid;\n    grid-template-columns: minmax(0, 58%) minmax(360px, 42%);\n    min-height: 700px;\n    border-radius: 34px;\n    overflow: hidden;\n    background: #020a17;\n    box-shadow: 0 34px 90px rgba(16, 52, 92, .20);\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__visual {\n    position: relative;\n    min-height: 700px;\n    overflow: hidden;\n    display: grid;\n    place-items: center;\n    background:\n      radial-gradient(circle at 50% 48%, rgba(30, 146, 255, .40), transparent 32%),\n      radial-gradient(circle at 50% 50%, rgba(9, 75, 160, .22), transparent 56%),\n      linear-gradient(145deg, #020a17, #04162c 62%, #061b35);\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__visual::after {\n    content: \"\";\n    position: absolute;\n    left: 8%;\n    right: 8%;\n    bottom: 6%;\n    height: 13%;\n    border-radius: 50%;\n    background: radial-gradient(ellipse, rgba(46, 166, 255, .36), transparent 70%);\n    filter: blur(13px);\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__halo {\n    position: absolute;\n    width: 620px;\n    height: 620px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(83, 194, 255, .34), rgba(20, 116, 226, .12) 42%, transparent 70%);\n    filter: blur(3px);\n    animation: sgS2ExplorerPulse 5s ease-in-out infinite;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__rings {\n    position: absolute;\n    width: 560px;\n    height: 560px;\n    border: 1px solid rgba(86, 181, 255, .22);\n    border-radius: 50%;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__rings::before,\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__rings::after {\n    content: \"\";\n    position: absolute;\n    border: 1px solid rgba(86, 181, 255, .16);\n    border-radius: 50%;\n    inset: 11%;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__rings::after {\n    inset: 23%;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__image {\n    position: relative;\n    z-index: 2;\n    width: min(610px, 75%);\n    max-width: none;\n    height: auto;\n    filter:\n      drop-shadow(0 34px 34px rgba(0, 0, 0, .42))\n      drop-shadow(0 0 28px rgba(70, 176, 255, .30));\n    animation: sgS2ExplorerFloat 5.5s ease-in-out infinite;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot {\n    --size: 46px;\n    position: absolute;\n    z-index: 5;\n    left: var(--x);\n    top: var(--y);\n    width: var(--size);\n    height: var(--size);\n    transform: translate(-50%, -50%);\n    border: 1px solid rgba(255,255,255,.75);\n    border-radius: 50%;\n    background: rgba(5, 22, 43, .72);\n    color: white;\n    cursor: pointer;\n    box-shadow: 0 0 0 9px rgba(34, 151, 255, .12), 0 0 26px rgba(36, 160, 255, .50);\n    transition: transform .25s ease, background .25s ease, box-shadow .25s ease;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot::after {\n    content: \"\";\n    position: absolute;\n    inset: -11px;\n    border: 1px solid rgba(80, 185, 255, .35);\n    border-radius: 50%;\n    animation: sgS2ExplorerPing 2.4s ease-out infinite;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot span {\n    font-size: 15px;\n    font-weight: 800;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot:hover,\n  #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot.is-active {\n    transform: translate(-50%, -50%) scale(1.12);\n    background: var(--sg-blue);\n    box-shadow: 0 0 0 10px rgba(34, 151, 255, .18), 0 0 34px rgba(36, 160, 255, .72);\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__panel {\n    min-height: 700px;\n    padding: 64px 54px 48px;\n    display: flex;\n    flex-direction: column;\n    background:\n      linear-gradient(160deg, rgba(14, 38, 67, .98), rgba(4, 16, 31, .98)),\n      #061426;\n    color: white;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__panel-top {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    margin-bottom: 52px;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__number {\n    color: var(--sg-blue);\n    font-size: 38px;\n    font-weight: 850;\n    line-height: 1;\n    letter-spacing: -.04em;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__label {\n    color: #9fb3c8;\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .18em;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy {\n    display: none;\n    animation: sgS2ExplorerFade .35s ease;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy.is-active {\n    display: block;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy h3 {\n    margin: 0 0 20px !important;\n    color: white !important;\n    font-size: clamp(32px, 3vw, 52px) !important;\n    line-height: 1.03 !important;\n    letter-spacing: -.04em !important;\n    font-weight: 780 !important;\n    text-transform: none !important;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy > p {\n    margin: 0 0 28px !important;\n    color: #b7c6d6 !important;\n    font-size: 18px !important;\n    line-height: 1.65 !important;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy ul {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy li {\n    position: relative;\n    margin: 0;\n    padding: 14px 0 14px 31px;\n    color: #eef7ff;\n    font-size: 16px;\n    border-bottom: 1px solid rgba(255,255,255,.08);\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy li::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    color: var(--sg-blue-soft);\n    font-weight: 900;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__nav {\n    margin-top: auto;\n    padding-top: 38px;\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 10px;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__nav button {\n    min-height: 48px;\n    padding: 10px 14px;\n    border: 1px solid rgba(87, 162, 231, .24);\n    border-radius: 12px;\n    background: rgba(255,255,255,.04);\n    color: #b8c9da;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 750;\n    cursor: pointer;\n    transition: .25s ease;\n  }\n\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__nav button:hover,\n  #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__nav button.is-active {\n    border-color: rgba(60, 171, 255, .74);\n    background: rgba(20, 141, 255, .16);\n    color: white;\n  }\n\n  @keyframes sgS2ExplorerFloat {\n    0%, 100% { transform: translateY(0) rotate(-.2deg); }\n    50% { transform: translateY(-11px) rotate(.2deg); }\n  }\n\n  @keyframes sgS2ExplorerPulse {\n    0%, 100% { opacity: .7; transform: scale(.96); }\n    50% { opacity: 1; transform: scale(1.04); }\n  }\n\n  @keyframes sgS2ExplorerPing {\n    0% { transform: scale(.72); opacity: .7; }\n    80%, 100% { transform: scale(1.45); opacity: 0; }\n  }\n\n  @keyframes sgS2ExplorerFade {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (max-width: 1050px) {\n    #sg-s2-explorer-{{ section.id }} {\n      padding: 80px 0;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__inner {\n      width: min(100% - 40px, 900px);\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__stage {\n      grid-template-columns: 1fr;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__visual {\n      min-height: 620px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__panel {\n      min-height: auto;\n    }\n  }\n\n  @media (max-width: 620px) {\n    #sg-s2-explorer-{{ section.id }} {\n      padding: 58px 0;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__inner {\n      width: calc(100% - 26px);\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__header {\n      margin-bottom: 34px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__stage {\n      border-radius: 22px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__visual {\n      min-height: 430px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__image {\n      width: min(440px, 91%);\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__halo {\n      width: 390px;\n      height: 390px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__rings {\n      width: 350px;\n      height: 350px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot {\n      --size: 39px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__panel {\n      padding: 38px 24px 28px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__panel-top {\n      margin-bottom: 30px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__number {\n      font-size: 30px;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy > p {\n      font-size: 16px !important;\n    }\n\n    #sg-s2-explorer-{{ section.id }} .sg-s2-feature-copy li {\n      font-size: 14px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__image,\n    #sg-s2-explorer-{{ section.id }} .sg-s2-explorer__halo,\n    #sg-s2-explorer-{{ section.id }} .sg-s2-hotspot::after {\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const root = document.getElementById('sg-s2-explorer-{{ section.id }}');\n    if (!root) return;\n\n    const triggers = root.querySelectorAll('[data-feature]');\n    const copies = root.querySelectorAll('[data-content]');\n    const number = root.querySelector('.sg-s2-explorer__number');\n    const label = root.querySelector('.sg-s2-explorer__label');\n\n    const labels = {\n      lens: ['01', 'CAMERA'],\n      lights: ['02', 'NACHTZICHT'],\n      ptz: ['03', 'BEWEGING'],\n      wifi: ['04', 'VERBINDING']\n    };\n\n    const activate = (feature) => {\n      triggers.forEach((trigger) => {\n        trigger.classList.toggle('is-active', trigger.dataset.feature === feature);\n      });\n\n      copies.forEach((copy) => {\n        copy.classList.toggle('is-active', copy.dataset.content === feature);\n      });\n\n      if (labels[feature]) {\n        number.textContent = labels[feature][0];\n        label.textContent = labels[feature][1];\n      }\n    };\n\n    triggers.forEach((trigger) => {\n      trigger.addEventListener('click', () => activate(trigger.dataset.feature));\n    });\n  })();\n</script>",
