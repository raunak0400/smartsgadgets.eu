            "custom_liquid": "<div style=\"background: {{ background | default: \"#ffffff\" }}; padding: {{ container_padding | default: \"60px 20px\" }}; text-align: center;\">\n  <div style=\"display: flex; justify-content: center; gap: {{ image_gap | default: \"16px\" }}; margin-bottom: {{ images_margin_bottom | default: \"40px\" }}; flex-wrap: wrap;\">\n    <img src=\"{{ image_1 | default: \"https://smartsgadgets.eu/cdn/shop/files/Xenon_Smart_Baby_Camera_with_Monitor_Main_Image.png?v=1763490696&width=1500\" }}\" alt=\"photo\" style=\"width: {{ image_width | default: \"100px\" }}; height: auto; border-radius: {{ image_border_radius | default: \"8px\" }}; transform: rotate(-8deg); box-shadow: {{ image_shadow | default: \"0 4px 10px rgba(0,0,0,0.2)\" }};\">\n    <img src=\"{{ image_2 | default: \"https://smartsgadgets.eu/cdn/shop/files/Xenon_Smart_Water_Fountain_Main_Image.png?v=1763482887&width=1500\" }}\" alt=\"photo\" style=\"width: {{ image_width | default: \"100px\" }}; height: auto; border-radius: {{ image_border_radius | default: \"8px\" }}; transform: scale(1.1); z-index: 2; box-shadow: {{ image_shadow | default: \"0 4px 10px rgba(0,0,0,0.2)\" }};\">\n    <img src=\"{{ image_3 | default: \"https://smartsgadgets.eu/cdn/shop/files/Xenon_Smart_LED_Bulb_X7021_Main_Image.png?v=1763469537&width=1500\" }}\" alt=\"photo\" style=\"width: {{ image_width | default: \"100px\" }}; height: auto; border-radius: {{ image_border_radius | default: \"8px\" }}; transform: rotate(8deg); box-shadow: {{ image_shadow | default: \"0 4px 10px rgba(0,0,0,0.2)\" }};\">\n  </div>\n\n  <div style=\"font-size: {{ title_font_size | default: \"22px\" }}; font-weight: bold; color: {{ title_color | default: \"#E64E30\" }}; margin-bottom: {{ title_margin_bottom | default: \"12px\" }};\">\n    {{ title_first_part | default: \"Geld terug\" }} <span style=\"color: {{ title_highlight_color | default: \"#E64E30\" }};\">{{ title_second_part | default: \"Garantie\" }}</span>\n  </div>\n\n  <div style=\"color: {{ description_color | default: \"#000000\" }}; font-size: {{ description_font_size | default: \"15px\" }}; max-width: {{ description_max_width | default: \"600px\" }}; margin: 0 auto {{ description_margin_bottom | default: \"30px\" }} auto;\">\n    {% if description_text %}\n      {{ description_text }}\n    {% else %}\n    Wij zijn zo overtuigd van de kwaliteit van ons product dat wij een tevredenheidsgarantie bieden. Als u niet volledig tevreden bent met uw aankoop, retourneert u het artikel eenvoudig binnen 30 dagen voor een volledige terugbetaling\n    {% endif %}\n  </div>\n\n  <div style=\"margin: {{ button_margin | default: \"30px auto 20px\" }};\">\n    <a href=\"{{ button_link | default: \"https://smartsgadgets.eu/collections/xenon-smart\" }}\" style=\"display: inline-block; background: {{ button_bg | default: \"#E64E30\" }}; color: {{ button_text_color | default: \"white\" }}; padding: {{ button_padding | default: \"16px 40px\" }}; border-radius: {{ button_border_radius | default: \"12px\" }}; font-weight: {{ button_font_weight | default: \"700\" }}; font-size: {{ button_font_size | default: \"15px\" }}; letter-spacing: 1px; text-decoration: none;\">\n      {{ button_text | default: \"KOOP NU\" }}\n    </a>\n  </div>\n\n  <div style=\"margin-top: {{ features_margin_top | default: \"24px\" }}; font-size: {{ features_font_size | default: \"14px\" }}; color: {{ features_color | default: \"#000000\" }}; display: flex; gap: {{ features_gap | default: \"16px\" }}; justify-content: center; flex-wrap: wrap; align-items: center;\">\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_1_text | default: \"100% Tevredenheid\" }}</span>\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_2_text | default: \"Snelle Verzending\" }}</span>\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_3_text | default: \"Eenvoudig Retourneren\" }}</span>\n  </div>\n</div>"
