    "custom_liquid_e4QYpp": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SmartGadgets.eu — MEARI S2 Plus Premium Hero v4\n  Complete coded hero: editable text, separate transparent camera image,\n  responsive feature cards and bottom connectivity bar.\n\n  Replace only the image URL below with the transparent PNG URL from Shopify Files.\n{% endcomment %}\n\n{% assign sg_s2_image_url = 'https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_22_2026_01_00_43_PM.png?v=1784718061' %}\n\n<section id=\"sg-s2-hero-{{ section.id }}\" class=\"sg-s2-hero\" aria-label=\"MEARI S2 Plus beveiligingscamera\">\n  <div class=\"sg-s2-hero__atmosphere\" aria-hidden=\"true\">\n    <span class=\"sg-s2-hero__orb sg-s2-hero__orb--one\"></span>\n    <span class=\"sg-s2-hero__orb sg-s2-hero__orb--two\"></span>\n    <span class=\"sg-s2-hero__beam\"></span>\n    <span class=\"sg-s2-hero__wall\"></span>\n    <span class=\"sg-s2-hero__floor\"></span>\n    <span class=\"sg-s2-hero__floor-line\"></span>\n    <span class=\"sg-s2-hero__reflection\"></span>\n    <span class=\"sg-s2-hero__particle sg-s2-hero__particle--1\"></span>\n    <span class=\"sg-s2-hero__particle sg-s2-hero__particle--2\"></span>\n    <span class=\"sg-s2-hero__particle sg-s2-hero__particle--3\"></span>\n    <span class=\"sg-s2-hero__particle sg-s2-hero__particle--4\"></span>\n    <span class=\"sg-s2-hero__particle sg-s2-hero__particle--5\"></span>\n  </div>\n\n  <div class=\"sg-s2-hero__inner\">\n    <div class=\"sg-s2-hero__content\">\n      <p class=\"sg-s2-hero__eyebrow\">MEARI S2 PLUS</p>\n\n      <h1 class=\"sg-s2-hero__title\">\n        <span class=\"sg-s2-hero__title-main\">Slimme beveiliging.</span>\n        <span class=\"sg-s2-hero__title-accent\">Altijd een gerust gevoel.</span>\n      </h1>\n\n      <p class=\"sg-s2-hero__intro\">\n        De MEARI S2 Plus houdt uw woning, tuin en oprit in de gaten met\n        AI-detectie, 4MP helder beeld en 355° PTZ-overzicht.\n      </p>\n\n      <div class=\"sg-s2-hero__features\" role=\"list\" aria-label=\"Belangrijkste kenmerken\">\n        <article class=\"sg-s2-feature\" role=\"listitem\">\n          <div class=\"sg-s2-feature__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 48 48\" fill=\"none\">\n              <path d=\"M16 10h16M13 13v7M35 13v7M13 35v-7M35 35v-7\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n              <path d=\"M24 16c5 0 8 3.6 8 8.2 0 3.4-1.7 5.5-4.2 7.3-.9.7-1.5 1.8-1.5 3v.5h-4.6v-.5c0-1.2-.6-2.3-1.5-3C17.7 29.7 16 27.6 16 24.2 16 19.6 19 16 24 16Z\" stroke=\"currentColor\" stroke-width=\"2.2\"/>\n              <path d=\"M21 23.5h6M24 20.5v6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <h2>AI Detectie</h2>\n          <p>Slimme persoons-, voertuig- en bewegingsdetectie</p>\n        </article>\n\n        <article class=\"sg-s2-feature\" role=\"listitem\">\n          <div class=\"sg-s2-feature__icon sg-s2-feature__icon--text\" aria-hidden=\"true\">4MP</div>\n          <h2>4MP Super HD</h2>\n          <p>Kristalhelder beeld met scherpe details</p>\n        </article>\n\n        <article class=\"sg-s2-feature\" role=\"listitem\">\n          <div class=\"sg-s2-feature__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 48 48\" fill=\"none\">\n              <path d=\"M10 23c1.2-7.4 7-13 14-13 4.1 0 7.8 1.8 10.4 4.7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n              <path d=\"m31 10 4 5.2-6.2 1.5\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <path d=\"M38 25c-1.2 7.4-7 13-14 13-4.1 0-7.8-1.8-10.4-4.7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n              <path d=\"m17 38-4-5.2 6.2-1.5\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <text x=\"24\" y=\"28\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"10\" font-weight=\"800\">355°</text>\n            </svg>\n          </div>\n          <h2>355° PTZ</h2>\n          <p>Draaien, kantelen en zoomen via de app</p>\n        </article>\n\n        <article class=\"sg-s2-feature\" role=\"listitem\">\n          <div class=\"sg-s2-feature__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 48 48\" fill=\"none\">\n              <path d=\"M31.5 34.5A14 14 0 0 1 19 10a14.5 14.5 0 1 0 12.5 24.5Z\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linejoin=\"round\"/>\n              <path d=\"m34 11 1.2 3.2 3.3 1.2-3.3 1.2L34 20l-1.2-3.4-3.3-1.2 3.3-1.2L34 11Z\" fill=\"currentColor\"/>\n              <path d=\"m39 24 .8 2.1 2.2.8-2.2.8L39 30l-.8-2.3-2.2-.8 2.2-.8L39 24Z\" fill=\"currentColor\"/>\n            </svg>\n          </div>\n          <h2>Full-Color Nachtzicht</h2>\n          <p>Zie meer kleuren, zelfs in het donker</p>\n        </article>\n      </div>\n\n      <div class=\"sg-s2-hero__connectivity\" aria-label=\"Connectiviteit en opslag\">\n        <div class=\"sg-s2-connectivity-item\">\n          <svg viewBox=\"0 0 48 48\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M8 18c9-8 23-8 32 0M13 24c6-5.5 16-5.5 22 0M19 30c3-2.7 7-2.7 10 0\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\"/>\n            <circle cx=\"24\" cy=\"36\" r=\"2.7\" fill=\"currentColor\"/>\n          </svg>\n          <span>WiFi &amp; Ethernet</span>\n        </div>\n        <span class=\"sg-s2-connectivity-divider\" aria-hidden=\"true\"></span>\n        <div class=\"sg-s2-connectivity-item\">\n          <svg viewBox=\"0 0 48 48\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M15 37h20a8 8 0 0 0 1.3-15.9A12 12 0 0 0 13.2 18 9.5 9.5 0 0 0 15 37Z\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linejoin=\"round\"/>\n          </svg>\n          <span>Cloud &amp; SD-opslag</span>\n        </div>\n        <span class=\"sg-s2-connectivity-divider\" aria-hidden=\"true\"></span>\n        <div class=\"sg-s2-connectivity-item\">\n          <svg viewBox=\"0 0 48 48\" fill=\"none\" aria-hidden=\"true\">\n            <rect x=\"15\" y=\"6\" width=\"18\" height=\"36\" rx=\"3.5\" stroke=\"currentColor\" stroke-width=\"2.6\"/>\n            <path d=\"M21 10h6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n            <circle cx=\"24\" cy=\"37\" r=\"1.5\" fill=\"currentColor\"/>\n          </svg>\n          <span>MEARI App</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"sg-s2-hero__visual\" aria-label=\"MEARI S2 Plus camera\">\n      <div class=\"sg-s2-hero__camera-glow\" aria-hidden=\"true\"></div>\n      {% if sg_s2_image_url contains 'PASTE_YOUR' %}\n        <div class=\"sg-s2-hero__image-placeholder\">\n          Voeg bovenaan de code de URL van de transparante camera-afbeelding toe.\n        </div>\n      {% else %}\n        <img\n          class=\"sg-s2-hero__camera\"\n          src=\"{{ sg_s2_image_url }}\"\n          alt=\"MEARI S2 Plus Outdoor AI beveiligingscamera\"\n          width=\"1313\"\n          height=\"1198\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      {% endif %}\n    </div>\n  </div>\n</section>\n\n<style>\n  #sg-s2-hero-{{ section.id }} {\n    --sg-blue: #148dff;\n    --sg-blue-light: #52b7ff;\n    --sg-ink: #f7fbff;\n    --sg-muted: #b5c3d3;\n    position: relative;\n    width: 100%;\n    min-height: 760px;\n    overflow: hidden;\n    isolation: isolate;\n    background:\n      radial-gradient(circle at 70% 43%, rgba(10, 126, 255, .34) 0, rgba(9, 83, 164, .16) 25%, transparent 51%),\n      radial-gradient(circle at 27% 20%, rgba(16, 83, 160, .14), transparent 38%),\n      linear-gradient(112deg, #010916 0%, #031225 45%, #061b33 72%, #071426 100%);\n    color: var(--sg-ink);\n    font-family: inherit;\n  }\n\n  #sg-s2-hero-{{ section.id }} *,\n  #sg-s2-hero-{{ section.id }} *::before,\n  #sg-s2-hero-{{ section.id }} *::after { box-sizing: border-box; }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__atmosphere,\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__atmosphere > * {\n    position: absolute;\n    pointer-events: none;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__atmosphere { inset: 0; z-index: -1; }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__wall {\n    right: -3%; top: -4%; width: 26%; height: 104%;\n    background:\n      linear-gradient(90deg, rgba(255,255,255,.04), rgba(255,255,255,.11) 6%, rgba(255,255,255,.035) 16%, transparent 17%),\n      linear-gradient(90deg, #17293a, #26394a 42%, #142536);\n    border-left: 1px solid rgba(142, 203, 255, .24);\n    box-shadow: -30px 0 80px rgba(0, 112, 255, .19), inset 16px 0 28px rgba(255,255,255,.04);\n    opacity: .75;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__wall::after {\n    content: \"\"; position: absolute; inset: 0;\n    background-image: repeating-linear-gradient(83deg, rgba(255,255,255,.018) 0 1px, transparent 1px 5px);\n    mix-blend-mode: screen; opacity: .45;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__floor {\n    left: 0; right: 0; bottom: 0; height: 26%;\n    background:\n      radial-gradient(ellipse at 74% 15%, rgba(31,151,255,.32), transparent 35%),\n      linear-gradient(180deg, rgba(4,19,35,.05), rgba(3,13,25,.88));\n    transform: perspective(520px) rotateX(55deg) scaleX(1.2);\n    transform-origin: bottom center;\n    opacity: .9;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__floor-line {\n    left: 0; right: 0; bottom: 22%; height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(65,165,255,.22) 55%, rgba(145,214,255,.7) 74%, transparent 94%);\n    box-shadow: 0 0 24px rgba(26,142,255,.45);\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__reflection {\n    right: 8%; bottom: 2%; width: 34%; height: 13%;\n    background: radial-gradient(ellipse, rgba(55,174,255,.3), rgba(18,112,210,.09) 42%, transparent 72%);\n    filter: blur(12px); transform: scaleY(.55);\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__beam {\n    right: 19%; top: 0; width: 30%; height: 100%;\n    background: linear-gradient(95deg, transparent, rgba(76,174,255,.08), rgba(111,201,255,.16), transparent 73%);\n    filter: blur(4px); transform: skewX(-7deg); opacity: .85;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__orb--one {\n    right: 12%; top: 17%; width: 43vw; height: 43vw; max-width: 660px; max-height: 660px;\n    border-radius: 50%; border: 1px solid rgba(61,166,255,.17);\n    box-shadow: inset 0 0 80px rgba(14,120,230,.07), 0 0 100px rgba(0,100,230,.08);\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__orb--two {\n    right: 18%; top: 26%; width: 30vw; height: 30vw; max-width: 470px; max-height: 470px;\n    border-radius: 50%; border: 1px solid rgba(86,188,255,.14);\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle {\n    width: 4px; height: 4px; border-radius: 50%; background: rgba(128,205,255,.8); box-shadow: 0 0 11px rgba(89,185,255,.8);\n    animation: sgS2Particle 6s ease-in-out infinite;\n  }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle--1 { left: 62%; top: 24%; animation-delay: 0s; }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle--2 { left: 72%; top: 66%; animation-delay: -1.7s; }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle--3 { left: 54%; top: 71%; animation-delay: -3.1s; width: 2px; height: 2px; }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle--4 { left: 88%; top: 31%; animation-delay: -4.2s; width: 3px; height: 3px; }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__particle--5 { left: 43%; top: 18%; animation-delay: -2.2s; width: 2px; height: 2px; }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__inner {\n    position: relative; z-index: 2;\n    width: min(1440px, calc(100% - 72px));\n    min-height: 760px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: minmax(0, 56%) minmax(360px, 44%);\n    align-items: center;\n    gap: 24px;\n    padding: 70px 0 58px;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__content { position: relative; z-index: 4; max-width: 790px; }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__eyebrow {\n    margin: 0 0 24px !important;\n    color: var(--sg-blue) !important;\n    font-size: clamp(15px, 1.35vw, 22px) !important;\n    font-weight: 750 !important;\n    letter-spacing: .28em !important;\n    line-height: 1.2 !important;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__title {\n    margin: 0 !important;\n    padding: 0 !important;\n    max-width: 760px !important;\n    font-size: clamp(46px, 5vw, 82px) !important;\n    line-height: .99 !important;\n    letter-spacing: -.055em !important;\n    font-weight: 780 !important;\n    text-transform: none !important;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__title span { display: block; }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__title-main { color: #f8fbff !important; text-shadow: 0 7px 30px rgba(0,0,0,.2); }\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__title-accent {\n    margin-top: 7px;\n    color: #168fff !important;\n    background: linear-gradient(90deg, #168fff 0%, #1598ff 55%, #64c2ff 100%);\n    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__intro {\n    max-width: 620px;\n    margin: 30px 0 30px !important;\n    color: var(--sg-muted) !important;\n    font-size: clamp(18px, 1.55vw, 24px) !important;\n    line-height: 1.52 !important;\n    font-weight: 400 !important;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-hero__features {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 18px;\n    max-width: 760px;\n  }\n\n  #sg-s2-hero-{{ section.id }} .sg-s2-feature {\n    min-height: 236px;\n    padding: 25px 14px 20px;\n    border: 1px solid rgba(41,153,255,.65);\n    border-radius: 16px;\n    background: linear-gradient(145deg, rgba(7,25,46,.72), rgba(2,14,28,.74));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.035), 0 