n.id }} .sg-s2-hero__connectivity {\n    max-width: 745px;\n    min-height: 80px;\n    margin-top: 24px;\n    border-radius: 18px;\n  }\n\n  @keyframes sgS2FloatV5 {\n    0%,100% { transform: translateY(1%) rotate(-.18deg); }\n    50% { transform: translateY(calc(1% - 9px)) rotate(.18deg); }\n  }\n\n  @keyframes sgS2Aura {\n    0%,100% { opacity: .78; transform: scale(.97); }\n    50% { opacity: 1; transform: scale(1.035); }\n  }\n\n  @media (max-width: 1180px) {\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__inner {\n      width: min(100% - 40px, 1180px);\n      grid-template-columns: minmax(0, 59%) minmax(350px, 41%);\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera {\n      width: min(620px, 50vw);\n      margin-right: -15%;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera-glow {\n      right: -20%;\n      width: 650px;\n      height: 650px;\n    }\n  }\n\n  @media (max-width: 900px) {\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__inner {\n      grid-template-columns: 1fr;\n      width: min(100% - 34px, 760px);\n      padding-top: 34px;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual {\n      min-height: 500px;\n      order: -1;\n      justify-content: center;\n      margin-bottom: -54px;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera {\n      width: min(540px, 83vw);\n      margin-right: 0;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera-glow {\n      left: 50%;\n      right: auto;\n      top: 48%;\n      width: 650px;\n      height: 650px;\n      transform: translate(-50%, -50%);\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual::before {\n      left: 50%;\n      right: auto;\n      width: 620px;\n      height: 620px;\n      transform: translateX(-50%);\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual::after {\n      left: 50%;\n      right: auto;\n      width: 470px;\n      transform: translateX(-50%);\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__wall { width: 34%; opacity: .62; }\n  }\n\n  @media (max-width: 620px) {\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual {\n      min-height: 375px;\n      margin-bottom: -22px;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera {\n      width: min(430px, 96vw);\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__camera-glow {\n      width: 500px;\n      height: 500px;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual::before {\n      width: 500px;\n      height: 500px;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual::after {\n      width: 360px;\n      bottom: 2%;\n    }\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__title {\n      font-size: clamp(37px, 11.8vw, 54px) !important;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #sg-s2-hero-{{ section.id }} .sg-s2-hero__visual::before { animation: none !important; }\n  }\n</style>",
