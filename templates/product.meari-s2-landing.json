    "custom_liquid_BDjd6B": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% liquid\n  assign sg_final_image = product.featured_image\n\n  if product.images.size > 1\n    assign sg_final_image = product.images[1]\n  endif\n%}\n\n<style>\n/* =========================================================\n   MEARI N2 — FINAL PREMIUM CONVERSION SECTION\n   ========================================================= */\n\n.shopify-section:has(.sg-n2-final),\n.shopify-section:has(.sg-n2-final) > div {\n  width: 100% !important;\n  max-width: none !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.shopify-section:has(.sg-n2-final) .section,\n.shopify-section:has(.sg-n2-final) .section__inner,\n.shopify-section:has(.sg-n2-final) .container,\n.shopify-section:has(.sg-n2-final) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-n2-final,\n.sg-n2-final * {\n  box-sizing: border-box;\n}\n\n.sg-n2-final {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #51afff;\n  --sg-dark: #061524;\n  --sg-dark-soft: #0b253e;\n  --sg-orange: #ff6a13;\n  --sg-orange-light: #ff873f;\n  --sg-green: #20c47a;\n  --sg-white: #ffffff;\n  --sg-muted: #b3c7da;\n  --sg-line: rgba(255, 255, 255, 0.12);\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-white);\n  background:\n    radial-gradient(\n      circle at 12% 20%,\n      rgba(22, 134, 232, 0.22),\n      transparent 29%\n    ),\n    radial-gradient(\n      circle at 90% 75%,\n      rgba(255, 106, 19, 0.12),\n      transparent 29%\n    ),\n    linear-gradient(\n      140deg,\n      #040f1c 0%,\n      #071c30 48%,\n      #0a2947 100%\n    );\n  font-family: inherit;\n}\n\n.sg-n2-final::before {\n  content: \"\";\n  position: absolute;\n  top: -180px;\n  right: -130px;\n  width: 570px;\n  height: 570px;\n  border: 1px solid rgba(87, 182, 255, 0.09);\n  border-radius: 50%;\n  box-shadow:\n    0 0 0 75px rgba(87, 182, 255, 0.025),\n    0 0 0 150px rgba(87, 182, 255, 0.015);\n  pointer-events: none;\n}\n\n.sg-n2-final::after {\n  content: \"\";\n  position: absolute;\n  bottom: -200px;\n  left: -180px;\n  width: 520px;\n  height: 520px;\n  border-radius: 50%;\n  background:\n    radial-gradient(\n      circle,\n      rgba(22, 134, 232, 0.13),\n      transparent 67%\n    );\n  pointer-events: none;\n}\n\n.sg-n2-final__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1400px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 100px 0 50px;\n}\n\n/* Main conversion panel */\n\n.sg-n2-final__panel {\n  position: relative;\n  overflow: hidden;\n  display: grid;\n  grid-template-columns:\n    minmax(0, 1.08fr)\n    minmax(390px, 0.92fr);\n  gap: 70px;\n  align-items: center;\n  padding: 64px;\n  border: 1px solid rgba(112, 194, 255, 0.18);\n  border-radius: 32px;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(255, 255, 255, 0.075),\n      rgba(255, 255, 255, 0.025)\n    );\n  box-shadow:\n    0 35px 90px rgba(0, 0, 0, 0.34),\n    inset 0 1px 0 rgba(255, 255, 255, 0.09);\n  backdrop-filter: blur(16px);\n}\n\n.sg-n2-final__panel::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(\n      115deg,\n      transparent 0%,\n      rgba(255, 255, 255, 0.035) 45%,\n      transparent 70%\n    );\n}\n\n.sg-n2-final__content {\n  position: relative;\n  z-index: 2;\n}\n\n.sg-n2-final__eyebrow {\n  margin: 0 0 16px;\n  color: #69bdff;\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n}\n\n.sg-n2-final h2 {\n  max-width: 760px;\n  margin: 0 0 21px;\n  color: var(--sg-white);\n  font-size: clamp(43px, 5.2vw, 72px);\n  line-height: 1.01;\n  letter-spacing: -0.052em;\n  font-weight: 860;\n}\n\n.sg-n2-final h2 span {\n  color: var(--sg-blue-light);\n}\n\n.sg-n2-final__intro {\n  max-width: 680px;\n  margin: 0 0 31px;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.7;\n}\n\n/* Feature checklist */\n\n.sg-n2-final__features {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 13px 22px;\n  margin-bottom: 34px;\n}\n\n.sg-n2-final__feature {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  color: #eef7ff;\n  font-size: 14px;\n  line-height: 1.45;\n  font-weight: 680;\n}\n\n.sg-n2-final__feature-icon {\n  width: 29px;\n  height: 29px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #77c7ff;\n  border: 1px solid rgba(87, 183, 255, 0.22);\n  border-radius: 9px;\n  background: rgba(22, 134, 232, 0.13);\n}\n\n.sg-n2-final__feature-icon svg {\n  width: 16px;\n  height: 16px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Price and button */\n\n.sg-n2-final__purchase-row {\n  display: flex;\n  align-items: center;\n  gap: 25px;\n  flex-wrap: wrap;\n}\n\n.sg-n2-final__price {\n  min-width: 145px;\n}\n\n.sg-n2-final__price-label {\n  display: block;\n  margin-bottom: 5px;\n  color: #95abc0;\n  font-size: 12px;\n  line-height: 1.2;\n  font-weight: 750;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.sg-n2-final__price-current {\n  display: block;\n  color: #ffffff;\n  font-size: 35px;\n  line-height: 1;\n  letter-spacing: -0.04em;\n  font-weight: 880;\n}\n\n.sg-n2-final__price-compare {\n  display: inline-block;\n  margin-top: 7px;\n  color: #879db1;\n  font-size: 14px;\n  line-height: 1;\n  text-decoration: line-through;\n}\n\n.sg-n2-final__button {\n  min-height: 61px;\n  padding: 17px 31px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n  color: #ffffff;\n  border: 0;\n  border-radius: 13px;\n  background:\n    linear-gradient(\n      135deg,\n      var(--sg-orange-light),\n      var(--sg-orange)\n    );\n  box-shadow:\n    0 18px 42px rgba(255, 106, 19, 0.30);\n  font-family: inherit;\n  font-size: 17px;\n  line-height: 1;\n  font-weight: 840;\n  cursor: pointer;\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n}\n\n.sg-n2-final__button:hover {\n  transform: translateY(-3px);\n  box-shadow:\n    0 25px 55px rgba(255, 106, 19, 0.42);\n}\n\n.sg-n2-final__button svg {\n  width: 21px;\n  height: 21px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Product visual */\n\n.sg-n2-final__visual {\n  position: relative;\n  min-height: 520px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sg-n2-final__glow {\n  position: absolute;\n  width: 390px;\n  height: 390px;\n  border-radius: 50%;\n  background:\n    radial-gradient(\n      circle,\n      rgba(63, 170, 255, 0.27),\n      rgba(22, 134, 232, 0.08) 48%,\n      transparent 70%\n    );\n  filter: blur(2px);\n}\n\n.sg-n2-final__ring {\n  position: absolute;\n  width: 410px;\n  height: 410px;\n  border: 1px solid rgba(104, 194, 255, 0.16);\n  border-radius: 50%;\n  animation: sgFinalRotate 19s linear infinite;\n}\n\n.sg-n2-final__ring::before,\n.sg-n2-final__ring::after {\n  content: \"\";\n  position: absolute;\n  border-radius: 50%;\n}\n\n.sg-n2-final__ring::before {\n  inset: 36px;\n  border: 1px dashed rgba(104, 194, 255, 0.13);\n}\n\n.sg-n2-final__ring::after {\n  top: -6px;\n  left: 50%;\n  width: 12px;\n  height: 12px;\n  background: var(--sg-blue-light);\n  box-shadow:\n    0 0 24px rgba(81, 175, 255, 0.78);\n}\n\n@keyframes sgFinalRotate {\n  from {\n    transform: rotate(0deg);\n  }\n\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.sg-n2-final__image-wrap {\n  position: relative;\n  z-index: 2;\n  width: min(100%, 440px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  animation: sgFinalFloat 5s ease-in-out infinite;\n}\n\n@keyframes sgFinalFloat {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-13px);\n  }\n}\n\n.sg-n2-final__image {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-height: 500px;\n  object-fit: contain;\n  filter:\n    drop-shadow(0 32px 34px rgba(0, 0, 0, 0.38))\n    drop-shadow(0 7px 14px rgba(72, 176, 255, 0.14));\n}\n\n.sg-n2-final__floating-badge {\n  position: absolute;\n  z-index: 3;\n  min-width: 150px;\n  padding: 13px 16px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid rgba(126, 203, 255, 0.20);\n  border-radius: 14px;\n  background: rgba(5, 24, 42, 0.80);\n  box-shadow:\n    0 14px 36px rgba(0, 0, 0, 0.25);\n  backdrop-filter: blur(12px);\n}\n\n.sg-n2-final__floating-badge--top {\n  top: 70px;\n  left: 0;\n}\n\n.sg-n2-final__floating-badge--bottom {\n  right: 0;\n  bottom: 82px;\n}\n\n.sg-n2-final__floating-icon {\n  width: 35px;\n  height: 35px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #71c5ff;\n  border-radius: 10px;\n  background: rgba(22, 134, 232, 0.15);\n}\n\n.sg-n2-final__floating-icon svg {\n  width: 19px;\n  height: 19px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-n2-final__floating-badge strong {\n  display: block;\n  margin-bottom: 2px;\n  color: #ffffff;\n  font-size: 12px;\n  line-height: 1.2;\n  font-weight: 820;\n}\n\n.sg-n2-final__floating-badge span {\n  display: block;\n  color: #94abc0;\n  font-size: 10px;\n  line-height: 1.3;\n}\n\n/* Trust cards */\n\n.sg-n2-final__trust-grid {\n  margin-top: 28px;\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 13px;\n}\n\n.sg-n2-final__trust-card {\n  min-width: 0;\n  padding: 20px 15px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  border: 1px solid var(--sg-line);\n  border-radius: 16px;\n  background: rgba(255, 255, 255, 0.045);\n  transition:\n    transform 0.22s ease,\n    background 0.22s ease,\n    border-color 0.22s ease;\n}\n\n.sg-n2-final__trust-card:hover {\n  transform: translateY(-4px);\n  border-color: rgba(100, 193, 255, 0.25);\n  background: rgba(255, 255, 255, 0.072);\n}\n\n.sg-n2-final__trust-icon {\n  width: 41px;\n  height: 41px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #72c4ff;\n  border-radius: 12px;\n  background: rgba(22, 134, 232, 0.13);\n}\n\n.sg-n2-final__trust-icon--green {\n  color: #53dc9b;\n  background: rgba(32, 196, 122, 0.11);\n}\n\n.sg-n2-final__trust-icon--orange {\n  color: #ff9c61;\n  background: rgba(255, 106, 19, 0.11);\n}\n\n.sg-n2-final__trust-icon svg {\n  width: 21px;\n  height: 21px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-n2-final__trust-text {\n  min-width: 0;\n}\n\n.sg-n2-final__trust-text strong {\n  display: block;\n  margin-bottom: 3px;\n  overflow: hidden;\n  color: #ffffff;\n  font-size: 12px;\n  line-height: 1.25;\n  font-weight: 820;\n  text-overflow: ellipsis;\n}\n\n.sg-n2-final__trust-text span {\n  display: block;\n  color: #8fa7bc;\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n/* Payment area */\n\n.sg-n2-final__payment-area {\n  margin-top: 26px;\n  padding: 24px 27px;\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid var(--sg-line);\n  border-radius: 17px;\n  background: rgba(255, 255, 255, 0.038);\n}\n\n.sg-n2-final__payment-label strong {\n  display: block;\n  margin-bottom: 4px;\n  color: #ffffff;\n  font-size: 13px;\n  line-height: 1.3;\n  font-weight: 820;\n}\n\n.sg-n2-final__payment-label span {\n  display: block;\n  color: #8fa7bc;\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.sg-n2-final__payment-icons {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.sg-n2-final__payment-icon {\n  width: 47px;\n  height: 29px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sg-n2-final__payment-icon svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  max-width: 47px;\n  max-height: 29px;\n}\n\n.sg-n2-final__secure {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: #a7bfd4;\n  font-size: 11px;\n  line-height: 1.35;\n  font-weight: 700;\n  white-space: nowrap;\n}\n\n.sg-n2-final__secure svg {\n  width: 18px;\n  height: 18px;\n  flex: 0 0 auto;\n  fill: none;\n  stroke: #53dc9b;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Shipping pills */\n\n.sg-n2-final__shipping {\n  margin-top: 17px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 9px;\n}\n\n.sg-n2-final__shipping-label {\n  margin-right: 3px;\n  color: #8fa7bc;\n  font-size: 11px;\n  line-height: 1.3;\n  font-weight: 720;\n}\n\n.sg-n2-final__shipping-pill {\n  min-height: 31px;\n  padding: 7px 13px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: #dcecff;\n  border: 1px solid rgba(255, 255, 255, 0.11);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.045);\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 780;\n}\n\n/* Bottom legal-style note */\n\n.sg-n2-final__note {\n  max-width: 900px;\n  margin: 23px auto 0;\n  color: #718ca4;\n  font-size: 10px;\n  line-height: 1.55;\n  text-align: center;\n}\n\n@media screen and (max-width: 1160px) {\n  .sg-n2-final__panel {\n    gap: 42px;\n    padding: 50px;\n  }\n\n  .sg-n2-final__trust-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .sg-n2-final__trust-card:nth-child(4),\n  .sg-n2-final__trust-card:nth-child(5) {\n    grid-column: span 1;\n  }\n}\n\n@media screen and (max-width: 960px) {\n  .sg-n2-final__panel {\n    grid-template-columns: 1fr;\n  }\n\n  .sg-n2-final__content {\n    text-align: center;\n  }\n\n  .sg-n2-final__intro {\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .sg-n2-final__features {\n    max-width: 680px;\n    margin-right: auto;\n    margin-left: auto;\n    text-align: left;\n  }\n\n  .sg-n2-final__purchase-row {\n    justify-content: center;\n  }\n\n  .sg-n2-final__visual {\n    min-height: 480px;\n  }\n\n  .sg-n2-final__payment-area {\n    grid-template-columns: 1fr;\n    text-align: center;\n  }\n\n  .sg-n2-final__secure {\n    justify-content: center;\n  }\n}\n\n@media screen and (max-width: 720px) {\n  .sg-n2-final__inner {\n    width: min(100% - 28px, 680px);\n    padding: 70px 0 35px;\n  }\n\n  .sg-n2-final__panel {\n    padding: 35px 25px;\n    border-radius: 25px;\n  }\n\n  .sg-n2-final h2 {\n    font-size: 45px;\n  }\n\n  .sg-n2-final__intro {\n    font-size: 16px;\n  }\n\n  .sg-n2-final__features {\n    grid-template-columns: 1fr;\n    max-width: 440px;\n  }\n\n  .sg-n2-final__purchase-row {\n    flex-direction: column;\n  }\n\n  .sg-n2-final__button {\n    width: 100%;\n    max-width: 360px;\n  }\n\n  .sg-n2-final__visual {\n    min-height: 420px;\n  }\n\n  .sg-n2-final__ring {\n    width: 340px;\n    height: 340px;\n  }\n\n  .sg-n2-final__glow {\n    width: 330px;\n    height: 330px;\n  }\n\n  .sg-n2-final__image-wrap {\n    width: min(90%, 370px);\n  }\n\n  .sg-n2-final__floating-badge--top {\n    top: 42px;\n    left: -5px;\n  }\n\n  .sg-n2-final__floating-badge--bottom {\n    right: -5px;\n    bottom: 55px;\n  }\n\n  .sg-n2-final__trust-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .sg-n2-final__trust-card:last-child {\n    grid-column: 1 / -1;\n  }\n}\n\n@media screen and (max-width: 500px) {\n  .sg-n2-final__inner {\n    width: calc(100% - 24px);\n    padding-top: 55px;\n  }\n\n  .sg-n2-final__panel {\n    padding: 29px 19px;\n    border-radius: 21px;\n  }\n\n  .sg-n2-final h2 {\n    font-size: 37px;\n  }\n\n  .sg-n2-final__price-current {\n    font-size: 31px;\n  }\n\n  .sg-n2-final__visual {\n    min-height: 360px;\n  }\n\n  .sg-n2-final__ring {\n    width: 280px;\n    height: 280px;\n  }\n\n  .sg-n2-final__glow {\n    width: 280px;\n    height: 280px;\n  }\n\n  .sg-n2-final__image-wrap {\n    width: min(90%, 300px);\n  }\n\n  .sg-n2-final__floating-badge {\n    min-width: 125px;\n    padding: 10px 11px;\n  }\n\n  .sg-n2-final__floating-badge--top {\n    top: 28px;\n  }\n\n  .sg-n2-final__floating-badge--bottom {\n    bottom: 35px;\n  }\n\n  .sg-n2-final__floating-icon {\n    width: 30px;\n    height: 30px;\n  }\n\n  .sg-n2-final__trust-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .sg-n2-final__trust-card:last-child {\n    grid-column: auto;\n  }\n\n  .sg-n2-final__payment-area {\n    padding: 21px 16px;\n  }\n\n  .sg-n2-final__shipping {\n    margin-top: 14px;\n  }\n\n  .sg-n2-final__shipping-label {\n    width: 100%;\n    margin: 0 0 2px;\n    text-align: center;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sg-n2-final__ring,\n  .sg-n2-final__image-wrap {\n    animation: none;\n  }\n\n  .sg-n2-final__button,\n  .sg-n2-final__trust-card {\n    transition: none;\n  }\n}\n</style>\n\n<section class=\"sg-n2-final\">\n  <div class=\"sg-n2-final__inner\">\n\n    <div class=\"sg-n2-final__panel\">\n\n      <div class=\"sg-n2-final__content\">\n\n        <div class=\"sg-n2-final__eyebrow\">\n          Slimme beveiliging begint hier\n        </div>\n\n        <h2>\n          Bescherm uw woning.\n          <span>Waar u ook bent.</span>\n        </h2>\n\n        <p class=\"sg-n2-final__intro\">\n          Houd uw woning, tuin of oprit eenvoudig in de gaten met slimme\n          detectie, helder nachtzicht en directe toegang via de MEARI-app.\n        </p>\n\n        <div class=\"sg-n2-final__features\">\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Slimme persoonsdetectie\n          </div>\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Full-color nachtzicht\n          </div>\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Oplaadbare batterij\n          </div>\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Ondersteuning voor zonnepaneel\n          </div>\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Tweeweg-audio\n          </div>\n\n          <div class=\"sg-n2-final__feature\">\n            <span class=\"sg-n2-final__feature-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </span>\n            Beheer via de MEARI-app\n          </div>\n\n        </div>\n\n        <div class=\"sg-n2-final__purchase-row\">\n\n          <div class=\"sg-n2-final__price\">\n\n            <span class=\"sg-n2-final__price-label\">\n              Huidige prijs\n            </span>\n\n            <span class=\"sg-n2-final__price-current\">\n              {{ product.price | money }}\n            </span>\n\n            {% if product.compare_at_price > product.price %}\n              <span class=\"sg-n2-final__price-compare\">\n                {{ product.compare_at_price | money }}\n              </span>\n            {% endif %}\n\n          </div>\n\n          <button\n            type=\"button\"\n            class=\"sg-n2-final__button\"\n            data-sg-final-buy\n          >\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M4 5h2l2 10h9l2-7H7\"></path>\n              <circle cx=\"10\" cy=\"19\" r=\"1\"></circle>\n              <circle cx=\"17\" cy=\"19\" r=\"1\"></circle>\n            </svg>\n\n            Bestel de MEARI N2\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12h14\"></path>\n              <path d=\"m13 6 6 6-6 6\"></path>\n            </svg>\n          </button>\n\n        </div>\n\n      </div>\n\n      <div class=\"sg-n2-final__visual\">\n\n        <div class=\"sg-n2-final__glow\"></div>\n        <div class=\"sg-n2-final__ring\"></div>\n\n        {% if sg_final_image != blank %}\n          <div class=\"sg-n2-final__image-wrap\">\n\n            {{\n              sg_final_image\n              | image_url: width: 1100\n              | image_tag:\n                class: 'sg-n2-final__image',\n                loading: 'lazy',\n                widths: '400, 600, 800, 1000, 1100',\n                sizes: '(max-width: 720px) 85vw, 440px',\n                alt: product.title\n            }}\n\n          </div>\n        {% endif %}\n\n        <div class=\"sg-n2-final__floating-badge sg-n2-final__floating-badge--top\">\n\n          <div class=\"sg-n2-final__floating-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9\"></path>\n              <path d=\"M10 21h4\"></path>\n            </svg>\n          </div>\n\n          <div>\n            <strong>Directe meldingen</strong>\n            <span>Via uw smartphone</span>\n          </div>\n\n        </div>\n\n        <div class=\"sg-n2-final__floating-badge sg-n2-final__floating-badge--bottom\">\n\n          <div class=\"sg-n2-final__floating-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M12 3 4.5 6v5.4c0 4.6 3.1 7.8 7.5 9.6 4.4-1.8 7.5-5 7.5-9.6V6L12 3Z\"></path>\n              <path d=\"m8.5 12 2.2 2.2 4.8-5\"></path>\n            </svg>\n          </div>\n\n          <div>\n            <strong>Meer controle</strong>\n            <span>Dag en nacht</span>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"sg-n2-final__trust-grid\">\n\n      <div class=\"sg-n2-final__trust-card\">\n\n        <div class=\"sg-n2-final__trust-icon sg-n2-final__trust-icon--green\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"5\" y=\"10\" width=\"14\" height=\"10\" rx=\"2\"></rect>\n            <path d=\"M8 10V7a4 4 0 0 1 8 0v3\"></path>\n          </svg>\n        </div>\n\n        <div class=\"sg-n2-final__trust-text\">\n          <strong>Veilig betalen</strong>\n          <span>Beveiligde betaalomgeving</span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-n2-final__trust-card\">\n\n        <div class=\"sg-n2-final__trust-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M3 7h11v10H3V7Z\"></path>\n            <path d=\"M14 10h4l3 3v4h-7v-7Z\"></path>\n            <circle cx=\"7\" cy=\"18\" r=\"2\"></circle>\n            <circle cx=\"18\" cy=\"18\" r=\"2\"></circle>\n          </svg>\n        </div>\n\n        <div class=\"sg-n2-final__trust-text\">\n          <strong>Snelle levering</strong>\n          <span>Zorgvuldig verpakt en verzonden</span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-n2-final__trust-card\">\n\n        <div class=\"sg-n2-final__trust-icon sg-n2-final__trust-icon--orange\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n            <path d=\"M4 5v5h5\"></path>\n          </svg>\n        </div>\n\n        <div class=\"sg-n2-final__trust-text\">\n          <strong>60 dagen retour</strong>\n          <span>Bekijk onze retourvoorwaarden</span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-n2-final__trust-card\">\n\n        <div class=\"sg-n2-final__trust-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 3 4.5 6v5.4c0 4.6 3.1 7.8 7.5 9.6 4.4-1.8 7.5-5 7.5-9.6V6L12 3Z\"></path>\n            <path d=\"m8.5 12 2.2 2.2 4.8-5\"></path>\n          </svg>\n        </div>\n\n        <div class=\"sg-n2-final__trust-text\">\n          <strong>Betrouwbare service</strong>\n          <span>Ondersteuning na uw aankoop</span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-n2-final__trust-card\">\n\n        <div class=\"sg-n2-final__trust-icon sg-n2-final__trust-icon--green\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 5h16v11H8l-4 4V5Z\"></path>\n            <path d=\"M8 10h8M8 13h5\"></path>\n          </svg>\n        </div>\n\n        <div class=\"sg-n2-final__trust-text\">\n          <strong>Klantenservice</strong>\n          <span>Hulp bij vragen en installatie</span>\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"sg-n2-final__payment-area\">\n\n      <div class=\"sg-n2-final__payment-label\">\n        <strong>Betaal veilig met</strong>\n        <span>Vertrouwde betaalmethoden</span>\n      </div>\n\n      <div class=\"sg-n2-final__payment-icons\">\n\n        {% assign sg_payment_types = 'ideal,bancontact,visa,master,american_express,paypal,apple_pay,google_pay' | split: ',' %}\n\n        {% for type in sg_payment_types %}\n          <span class=\"sg-n2-final__payment-icon\">\n            {{ type | payment_type_svg_tag }}\n          </span>\n        {% endfor %}\n\n      </div>\n\n      <div class=\"sg-n2-final__secure\">\n        <svg viewBox=\"0 0 24 24\">\n          <rect x=\"5\" y=\"10\" width=\"14\" height=\"10\" rx=\"2\"></rect>\n          <path d=\"M8 10V7a4 4 0 0 1 8 0v3\"></path>\n        </svg>\n\n        SSL-beveiligde betaling\n      </div>\n\n    </div>\n\n    <div class=\"sg-n2-final__shipping\">\n\n      <span class=\"sg-n2-final__shipping-label\">\n        Verzending mogelijk via:\n      </span>\n\n      <span class=\"sg-n2-final__shipping-pill\">\n        PostNL\n      </span>\n\n      <span class=\"sg-n2-final__shipping-pill\">\n        DHL\n      </span>\n\n      <span class=\"sg-n2-final__shipping-pill\">\n        DPD\n      </span>\n\n      <span class=\"sg-n2-final__shipping-pill\">\n        GLS\n      </span>\n\n    </div>\n\n    <p class=\"sg-n2-final__note\">\n      Beschikbare betaalmethoden, vervoerders, levertijden en\n      retourvoorwaarden kunnen per bestelling en afleveradres verschillen.\n      Raadpleeg de informatie tijdens het afrekenen en het retourbeleid van\n      SmartGadgets.eu.\n    </p>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function findMeariProductArea() {\n    return (\n      document.querySelector('#ProductSection') ||\n      document.querySelector('product-form') ||\n      document.querySelector('form[action*=\"/cart/add\"]') ||\n      document.querySelector('.product-form') ||\n      document.querySelector('.buy-buttons') ||\n      document.querySelector('button[name=\"add\"]')\n    );\n  }\n\n  function initializeMeariFinalSection() {\n    document\n      .querySelectorAll('[data-sg-final-buy]')\n      .forEach(function (button) {\n\n        if (button.dataset.sgFinalInitialized === 'true') return;\n\n        button.dataset.sgFinalInitialized = 'true';\n\n        button.addEventListener('click', function () {\n          var target = findMeariProductArea();\n\n          if (target) {\n            target.scrollIntoView({\n              behavior: 'smooth',\n              block: 'center'\n            });\n          }\n        });\n      });\n  }\n\n  document.addEventListener(\n    'DOMContentLoaded',\n    initializeMeariFinalSection\n  );\n\n  document.addEventListener(\n    'shopify:section:load',\n    initializeMeariFinalSection\n  );\n\n  initializeMeariFinalSection();\n})();\n</script>",
        "section_height": "default",
        "full_width": false,
        "dividers": "none",
        "prevent_animation": false
      }
