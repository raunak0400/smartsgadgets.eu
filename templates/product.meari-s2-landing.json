    "custom_liquid_cC43pd": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   MEARI N2 — PREMIUM CUSTOMER REVIEWS\n   Replace example reviews with genuine feedback\n   before publishing.\n   ================================================== */\n\n.shopify-section:has(.sg-meari-reviews),\n.shopify-section:has(.sg-meari-reviews) > div {\n  width: 100% !important;\n  max-width: none !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.shopify-section:has(.sg-meari-reviews) .section,\n.shopify-section:has(.sg-meari-reviews) .section__inner,\n.shopify-section:has(.sg-meari-reviews) .container,\n.shopify-section:has(.sg-meari-reviews) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-reviews,\n.sg-meari-reviews * {\n  box-sizing: border-box;\n}\n\n.sg-meari-reviews {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #43a8ff;\n  --sg-navy: #07172a;\n  --sg-orange: #ff6a13;\n  --sg-text: #142237;\n  --sg-muted: #65758a;\n  --sg-line: #dce8f4;\n  --sg-green: #138a58;\n  --sg-star: #ffac16;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-text);\n  background:\n    radial-gradient(\n      circle at 8% 18%,\n      rgba(22, 134, 232, 0.08),\n      transparent 27%\n    ),\n    radial-gradient(\n      circle at 94% 86%,\n      rgba(255, 106, 19, 0.05),\n      transparent 26%\n    ),\n    linear-gradient(\n      180deg,\n      #ffffff 0%,\n      #f5faff 100%\n    );\n  font-family: inherit;\n}\n\n.sg-meari-reviews::before {\n  content: \"\";\n  position: absolute;\n  top: 65px;\n  left: -120px;\n  width: 310px;\n  height: 310px;\n  border: 1px solid rgba(22, 134, 232, 0.09);\n  border-radius: 50%;\n  box-shadow:\n    0 0 0 55px rgba(22, 134, 232, 0.025),\n    0 0 0 110px rgba(22, 134, 232, 0.015);\n  pointer-events: none;\n}\n\n.sg-meari-reviews__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1400px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 90px 0 96px;\n}\n\n.sg-meari-reviews__header {\n  max-width: 820px;\n  margin: 0 auto 48px;\n  text-align: center;\n}\n\n.sg-meari-reviews__eyebrow {\n  margin: 0 0 13px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-reviews h2 {\n  margin: 0 0 17px;\n  color: var(--sg-navy);\n  font-size: clamp(39px, 4.8vw, 64px);\n  line-height: 1.04;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-reviews h2 span {\n  color: var(--sg-blue);\n}\n\n.sg-meari-reviews__intro {\n  max-width: 710px;\n  margin: 0 auto;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n/* Rating summary */\n\n.sg-meari-reviews__summary {\n  max-width: 920px;\n  margin: 0 auto 34px;\n  padding: 25px 30px;\n  display: grid;\n  grid-template-columns:\n    minmax(210px, 0.8fr)\n    minmax(280px, 1.2fr)\n    minmax(170px, 0.7fr);\n  gap: 28px;\n  align-items: center;\n  border: 1px solid rgba(22, 134, 232, 0.14);\n  border-radius: 22px;\n  background: rgba(255, 255, 255, 0.88);\n  box-shadow:\n    0 18px 46px rgba(24, 68, 112, 0.08),\n    inset 0 1px 0 rgba(255, 255, 255, 0.8);\n  backdrop-filter: blur(12px);\n}\n\n.sg-meari-reviews__rating-main {\n  padding-right: 27px;\n  border-right: 1px solid var(--sg-line);\n}\n\n.sg-meari-reviews__rating-number {\n  display: flex;\n  align-items: flex-end;\n  gap: 7px;\n  margin-bottom: 7px;\n}\n\n.sg-meari-reviews__rating-number strong {\n  color: var(--sg-navy);\n  font-size: 48px;\n  line-height: 0.95;\n  letter-spacing: -0.05em;\n  font-weight: 880;\n}\n\n.sg-meari-reviews__rating-number span {\n  padding-bottom: 5px;\n  color: var(--sg-muted);\n  font-size: 16px;\n  font-weight: 700;\n}\n\n.sg-meari-reviews__stars {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  color: var(--sg-star);\n}\n\n.sg-meari-reviews__stars svg {\n  width: 20px;\n  height: 20px;\n  fill: currentColor;\n  stroke: currentColor;\n}\n\n.sg-meari-reviews__rating-note {\n  margin-top: 7px;\n  color: var(--sg-muted);\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.sg-meari-reviews__bars {\n  display: grid;\n  gap: 8px;\n}\n\n.sg-meari-reviews__bar {\n  display: grid;\n  grid-template-columns: 45px minmax(0, 1fr) 36px;\n  gap: 10px;\n  align-items: center;\n  color: #4b6075;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.sg-meari-reviews__track {\n  height: 7px;\n  overflow: hidden;\n  border-radius: 999px;\n  background: #e7eff7;\n}\n\n.sg-meari-reviews__fill {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background:\n    linear-gradient(\n      90deg,\n      var(--sg-blue),\n      var(--sg-blue-light)\n    );\n}\n\n.sg-meari-reviews__fill--five {\n  width: 92%;\n}\n\n.sg-meari-reviews__fill--four {\n  width: 7%;\n}\n\n.sg-meari-reviews__fill--three {\n  width: 1%;\n}\n\n.sg-meari-reviews__fill--two,\n.sg-meari-reviews__fill--one {\n  width: 0%;\n}\n\n.sg-meari-reviews__trust {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n}\n\n.sg-meari-reviews__trust-icon {\n  width: 48px;\n  height: 48px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-green);\n  border: 1px solid rgba(19, 138, 88, 0.17);\n  border-radius: 15px;\n  background: rgba(19, 138, 88, 0.08);\n}\n\n.sg-meari-reviews__trust-icon svg {\n  width: 25px;\n  height: 25px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-reviews__trust strong {\n  display: block;\n  margin-bottom: 4px;\n  color: var(--sg-navy);\n  font-size: 15px;\n  line-height: 1.2;\n  font-weight: 820;\n}\n\n.sg-meari-reviews__trust span {\n  display: block;\n  color: var(--sg-muted);\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n/* Review cards */\n\n.sg-meari-reviews__grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 22px;\n}\n\n.sg-meari-reviews__card {\n  position: relative;\n  min-width: 0;\n  min-height: 330px;\n  padding: 27px;\n  display: flex;\n  flex-direction: column;\n  border: 1px solid rgba(23, 105, 179, 0.13);\n  border-radius: 22px;\n  background: #ffffff;\n  box-shadow:\n    0 16px 42px rgba(24, 68, 112, 0.08),\n    0 2px 7px rgba(24, 68, 112, 0.035);\n  transition:\n    transform 0.28s ease,\n    box-shadow 0.28s ease,\n    border-color 0.28s ease;\n}\n\n.sg-meari-reviews__card:hover {\n  transform: translateY(-7px);\n  border-color: rgba(22, 134, 232, 0.30);\n  box-shadow:\n    0 25px 60px rgba(24, 68, 112, 0.14),\n    0 7px 18px rgba(22, 134, 232, 0.05);\n}\n\n.sg-meari-reviews__card::before {\n  content: \"“\";\n  position: absolute;\n  top: 14px;\n  right: 22px;\n  color: rgba(22, 134, 232, 0.10);\n  font-family: Georgia, serif;\n  font-size: 92px;\n  line-height: 1;\n  font-weight: 700;\n}\n\n.sg-meari-reviews__card-top {\n  position: relative;\n  z-index: 2;\n  margin-bottom: 21px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.sg-meari-reviews__card .sg-meari-reviews__stars svg {\n  width: 18px;\n  height: 18px;\n}\n\n.sg-meari-reviews__example {\n  padding: 7px 9px;\n  color: #7a5c15;\n  border: 1px solid #f2d58a;\n  border-radius: 999px;\n  background: #fff8df;\n  font-size: 9px;\n  line-height: 1;\n  font-weight: 850;\n  letter-spacing: 0.07em;\n  text-transform: uppercase;\n}\n\n.sg-meari-reviews__title {\n  position: relative;\n  z-index: 2;\n  margin: 0 0 12px;\n  color: var(--sg-navy);\n  font-size: 20px;\n  line-height: 1.25;\n  font-weight: 830;\n}\n\n.sg-meari-reviews__quote {\n  position: relative;\n  z-index: 2;\n  flex: 1;\n  margin: 0 0 25px;\n  color: #506278;\n  font-size: 15px;\n  line-height: 1.7;\n}\n\n.sg-meari-reviews__author {\n  position: relative;\n  z-index: 2;\n  padding-top: 20px;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  border-top: 1px solid #e6eef6;\n}\n\n.sg-meari-reviews__avatar {\n  width: 46px;\n  height: 46px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #ffffff;\n  border-radius: 50%;\n  background:\n    linear-gradient(\n      135deg,\n      var(--sg-blue-light),\n      var(--sg-blue)\n    );\n  box-shadow:\n    0 10px 22px rgba(22, 134, 232, 0.22);\n  font-size: 14px;\n  line-height: 1;\n  font-weight: 850;\n}\n\n.sg-meari-reviews__author-info {\n  min-width: 0;\n  flex: 1;\n}\n\n.sg-meari-reviews__author-info strong {\n  display: block;\n  margin-bottom: 3px;\n  overflow: hidden;\n  color: var(--sg-navy);\n  font-size: 14px;\n  line-height: 1.25;\n  font-weight: 820;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sg-meari-reviews__author-info span {\n  display: block;\n  color: var(--sg-muted);\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.sg-meari-reviews__verified {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  margin-top: 4px;\n  color: var(--sg-green);\n  font-size: 10px;\n  line-height: 1.2;\n  font-weight: 800;\n}\n\n.sg-meari-reviews__verified svg {\n  width: 13px;\n  height: 13px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Important editor note */\n\n.sg-meari-reviews__editor-note {\n  max-width: 850px;\n  margin: 32px auto 0;\n  padding: 16px 18px;\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  color: #664d0d;\n  border: 1px solid #f0d78d;\n  border-radius: 15px;\n  background: #fff9e7;\n  font-size: 13px;\n  line-height: 1.55;\n}\n\n.sg-meari-reviews__editor-note-icon {\n  width: 30px;\n  height: 30px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #a87700;\n  border-radius: 9px;\n  background: rgba(255, 182, 0, 0.12);\n}\n\n.sg-meari-reviews__editor-note-icon svg {\n  width: 18px;\n  height: 18px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/*\n  Hide this editor notice after you replace all three reviews\n  and rating values with genuine customer feedback:\n\n  .sg-meari-reviews__editor-note {\n    display: none;\n  }\n\n  Also remove the visible \"Voorbeeldreview\" badges if the\n  displayed reviews are genuine.\n*/\n\n/* CTA */\n\n.sg-meari-reviews__footer {\n  margin-top: 40px;\n  display: flex;\n  justify-content: center;\n}\n\n.sg-meari-reviews__button {\n  min-height: 57px;\n  padding: 16px 31px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n  color: #ffffff;\n  border: 0;\n  border-radius: 12px;\n  background:\n    linear-gradient(\n      135deg,\n      #ff7b28,\n      var(--sg-orange)\n    );\n  box-shadow:\n    0 16px 38px rgba(255, 106, 19, 0.27);\n  font-family: inherit;\n  font-size: 17px;\n  line-height: 1;\n  font-weight: 820;\n  cursor: pointer;\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n}\n\n.sg-meari-reviews__button:hover {\n  transform: translateY(-3px);\n  box-shadow:\n    0 22px 48px rgba(255, 106, 19, 0.36);\n}\n\n.sg-meari-reviews__button svg {\n  width: 20px;\n  height: 20px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n@media screen and (max-width: 1050px) {\n  .sg-meari-reviews__summary {\n    grid-template-columns: 0.8fr 1.2fr;\n  }\n\n  .sg-meari-reviews__trust {\n    grid-column: 1 / -1;\n    padding-top: 20px;\n    justify-content: center;\n    border-top: 1px solid var(--sg-line);\n    text-align: left;\n  }\n\n  .sg-meari-reviews__grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .sg-meari-reviews__card:last-child {\n    grid-column: 1 / -1;\n    max-width: calc(50% - 11px);\n    width: 100%;\n    justify-self: center;\n  }\n}\n\n@media screen and (max-width: 720px) {\n  .sg-meari-reviews__inner {\n    width: min(100% - 28px, 680px);\n    padding: 68px 0 72px;\n  }\n\n  .sg-meari-reviews__header {\n    margin-bottom: 36px;\n  }\n\n  .sg-meari-reviews__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-reviews__summary {\n    padding: 24px;\n    grid-template-columns: 1fr;\n    gap: 23px;\n  }\n\n  .sg-meari-reviews__rating-main {\n    padding: 0 0 22px;\n    border-right: 0;\n    border-bottom: 1px solid var(--sg-line);\n    text-align: center;\n  }\n\n  .sg-meari-reviews__rating-number,\n  .sg-meari-reviews__rating-main .sg-meari-reviews__stars {\n    justify-content: center;\n  }\n\n  .sg-meari-reviews__trust {\n    grid-column: auto;\n    padding-top: 22px;\n  }\n\n  .sg-meari-reviews__grid {\n    grid-template-columns: 1fr;\n  }\n\n  .sg-meari-reviews__card,\n  .sg-meari-reviews__card:last-child {\n    grid-column: auto;\n    max-width: none;\n    min-height: 0;\n  }\n}\n\n@media screen and (max-width: 500px) {\n  .sg-meari-reviews__inner {\n    width: calc(100% - 24px);\n    padding: 55px 0 60px;\n  }\n\n  .sg-meari-reviews h2 {\n    font-size: 37px;\n  }\n\n  .sg-meari-reviews__summary {\n    padding: 21px;\n    border-radius: 19px;\n  }\n\n  .sg-meari-reviews__rating-number strong {\n    font-size: 43px;\n  }\n\n  .sg-meari-reviews__card {\n    padding: 23px;\n  }\n\n  .sg-meari-reviews__button {\n    width: 100%;\n    max-width: 340px;\n  }\n}\n</style>\n\n<section class=\"sg-meari-reviews\">\n  <div class=\"sg-meari-reviews__inner\">\n\n    <div class=\"sg-meari-reviews__header\">\n\n      <div class=\"sg-meari-reviews__eyebrow\">\n        Ervaringen van klanten\n      </div>\n\n      <h2>\n        Wat klanten\n        <span>waarderen.</span>\n      </h2>\n\n      <p class=\"sg-meari-reviews__intro\">\n        Lees hoe gebruikers de installatie, beeldkwaliteit en slimme\n        beveiligingsfuncties van de MEARI N2 ervaren.\n      </p>\n\n    </div>\n\n    <!--\n      IMPORTANT:\n      The rating below is placeholder content.\n      Replace it with a genuine rating and real review count.\n    -->\n    <div class=\"sg-meari-reviews__summary\">\n\n      <div class=\"sg-meari-reviews__rating-main\">\n\n        <div class=\"sg-meari-reviews__rating-number\">\n          <strong>4,9</strong>\n          <span>/ 5</span>\n        </div>\n\n        <div class=\"sg-meari-reviews__stars\" aria-label=\"4,9 van 5 sterren\">\n\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n          </svg>\n\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n          </svg>\n\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n          </svg>\n\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n          </svg>\n\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n          </svg>\n\n        </div>\n\n        <div class=\"sg-meari-reviews__rating-note\">\n          Voorbeeldscore – vervang door echte gegevens\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-reviews__bars\">\n\n        <div class=\"sg-meari-reviews__bar\">\n          <span>5 sterren</span>\n          <div class=\"sg-meari-reviews__track\">\n            <span class=\"sg-meari-reviews__fill sg-meari-reviews__fill--five\"></span>\n          </div>\n          <span>92%</span>\n        </div>\n\n        <div class=\"sg-meari-reviews__bar\">\n          <span>4 sterren</span>\n          <div class=\"sg-meari-reviews__track\">\n            <span class=\"sg-meari-reviews__fill sg-meari-reviews__fill--four\"></span>\n          </div>\n          <span>7%</span>\n        </div>\n\n        <div class=\"sg-meari-reviews__bar\">\n          <span>3 sterren</span>\n          <div class=\"sg-meari-reviews__track\">\n            <span class=\"sg-meari-reviews__fill sg-meari-reviews__fill--three\"></span>\n          </div>\n          <span>1%</span>\n        </div>\n\n        <div class=\"sg-meari-reviews__bar\">\n          <span>2 sterren</span>\n          <div class=\"sg-meari-reviews__track\">\n            <span class=\"sg-meari-reviews__fill sg-meari-reviews__fill--two\"></span>\n          </div>\n          <span>0%</span>\n        </div>\n\n        <div class=\"sg-meari-reviews__bar\">\n          <span>1 ster</span>\n          <div class=\"sg-meari-reviews__track\">\n            <span class=\"sg-meari-reviews__fill sg-meari-reviews__fill--one\"></span>\n          </div>\n          <span>0%</span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-reviews__trust\">\n\n        <div class=\"sg-meari-reviews__trust-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 3 4.5 6v5.4c0 4.6 3.1 7.8 7.5 9.6 4.4-1.8 7.5-5 7.5-9.6V6L12 3Z\"></path>\n            <path d=\"m8.5 12 2.2 2.2 4.8-5\"></path>\n          </svg>\n        </div>\n\n        <div>\n          <strong>Echte ervaringen</strong>\n          <span>\n            Publiceer uitsluitend reviews die werkelijk door klanten zijn geplaatst.\n          </span>\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"sg-meari-reviews__grid\">\n\n      <!-- EXAMPLE REVIEW 1 -->\n      <article class=\"sg-meari-reviews__card\">\n\n        <div class=\"sg-meari-reviews__card-top\">\n\n          <div class=\"sg-meari-reviews__stars\" aria-label=\"5 van 5 sterren\">\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n          </div>\n\n          <span class=\"sg-meari-reviews__example\">\n            Voorbeeldreview\n          </span>\n\n        </div>\n\n        <h3 class=\"sg-meari-reviews__title\">\n          Eenvoudig te installeren\n        </h3>\n\n        <p class=\"sg-meari-reviews__quote\">\n          “De installatie verliep snel en de camera was binnen enkele\n          minuten gekoppeld aan de app. De meldingen komen direct binnen\n          en zijn eenvoudig te bekijken.”\n        </p>\n\n        <div class=\"sg-meari-reviews__author\">\n\n          <div class=\"sg-meari-reviews__avatar\">\n            KL\n          </div>\n\n          <div class=\"sg-meari-reviews__author-info\">\n            <strong>Naam echte klant</strong>\n            <span>Plaats of provincie</span>\n\n            <div class=\"sg-meari-reviews__verified\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n              Voeg status toe na verificatie\n            </div>\n          </div>\n\n        </div>\n\n      </article>\n\n      <!-- EXAMPLE REVIEW 2 -->\n      <article class=\"sg-meari-reviews__card\">\n\n        <div class=\"sg-meari-reviews__card-top\">\n\n          <div class=\"sg-meari-reviews__stars\" aria-label=\"5 van 5 sterren\">\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n          </div>\n\n          <span class=\"sg-meari-reviews__example\">\n            Voorbeeldreview\n          </span>\n\n        </div>\n\n        <h3 class=\"sg-meari-reviews__title\">\n          Duidelijk beeld, ook in het donker\n        </h3>\n\n        <p class=\"sg-meari-reviews__quote\">\n          “De beeldkwaliteit is helder en het nachtzicht geeft veel meer\n          detail dan mijn vorige camera. Via de app kan ik de oprit\n          eenvoudig controleren.”\n        </p>\n\n        <div class=\"sg-meari-reviews__author\">\n\n          <div class=\"sg-meari-reviews__avatar\">\n            KL\n          </div>\n\n          <div class=\"sg-meari-reviews__author-info\">\n            <strong>Naam echte klant</strong>\n            <span>Plaats of provincie</span>\n\n            <div class=\"sg-meari-reviews__verified\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n              Voeg status toe na verificatie\n            </div>\n          </div>\n\n        </div>\n\n      </article>\n\n      <!-- EXAMPLE REVIEW 3 -->\n      <article class=\"sg-meari-reviews__card\">\n\n        <div class=\"sg-meari-reviews__card-top\">\n\n          <div class=\"sg-meari-reviews__stars\" aria-label=\"5 van 5 sterren\">\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.4 6.3-.9L12 2.8Z\"></path>\n            </svg>\n\n          </div>\n\n          <span class=\"sg-meari-reviews__example\">\n            Voorbeeldreview\n          </span>\n\n        </div>\n\n        <h3 class=\"sg-meari-reviews__title\">\n          Handige automatische tracking\n        </h3>\n\n        <p class=\"sg-meari-reviews__quote\">\n          “De camera volgt beweging goed en ik ontvang snel een melding\n          op mijn telefoon. Vooral voor de tuin en achterdeur is dit\n          erg praktisch.”\n        </p>\n\n        <div class=\"sg-meari-reviews__author\">\n\n          <div class=\"sg-meari-reviews__avatar\">\n            KL\n          </div>\n\n          <div class=\"sg-meari-reviews__author-info\">\n            <strong>Naam echte klant</strong>\n            <span>Plaats of provincie</span>\n\n            <div class=\"sg-meari-reviews__verified\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n              Voeg status toe na verificatie\n            </div>\n          </div>\n\n        </div>\n\n      </article>\n\n    </div>\n\n    <div class=\"sg-meari-reviews__editor-note\">\n\n      <div class=\"sg-meari-reviews__editor-note-icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n          <path d=\"M12 10v6M12 7h.01\"></path>\n        </svg>\n      </div>\n\n      <div>\n        <strong>Belangrijk vóór publicatie:</strong>\n        vervang de voorbeeldscore, percentages, teksten, namen en locaties\n        door echte klantreviews. Verwijder daarna de gele\n        “Voorbeeldreview”-labels en verberg deze melding.\n      </div>\n\n    </div>\n\n    <div class=\"sg-meari-reviews__footer\">\n\n      <button\n        type=\"button\"\n        class=\"sg-meari-reviews__button\"\n        data-sg-reviews-buy\n      >\n        Bestel de MEARI N2\n\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M5 12h14\"></path>\n          <path d=\"m13 6 6 6-6 6\"></path>\n        </svg>\n      </button>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function initializeMeariReviews() {\n    document\n      .querySelectorAll('[data-sg-reviews-buy]')\n      .forEach(function (button) {\n\n        if (button.dataset.initialized === 'true') return;\n\n        button.dataset.initialized = 'true';\n\n        button.addEventListener('click', function () {\n\n          var target =\n            document.querySelector('product-form') ||\n            document.querySelector('form[action*=\"/cart/add\"]') ||\n            document.querySelector('.product-form') ||\n            document.querySelector('.buy-buttons') ||\n            document.querySelector('button[name=\"add\"]');\n\n          if (target) {\n            target.scrollIntoView({\n              behavior: 'smooth',\n              block: 'center'\n            });\n          }\n        });\n      });\n  }\n\n  document.addEventListener(\n    'DOMContentLoaded',\n    initializeMeariReviews\n  );\n\n  document.addEventListener(\n    'shopify:section:load',\n    initializeMeariReviews\n  );\n\n  initializeMeariReviews();\n})();\n</script>",
        "section_height": "default",
        "full_width": false,
        "dividers": "none",
        "prevent_animation": false
      }
