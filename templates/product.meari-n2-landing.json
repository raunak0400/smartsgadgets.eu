      "settings": {
        "custom_liquid": "{% liquid\n  assign sg_showcase_image = product.featured_image\n\n  if product.images.size > 4\n    assign sg_showcase_image = product.images[4]\n  elsif product.images.size > 1\n    assign sg_showcase_image = product.images[1]\n  endif\n%}\n\n<style>\n/* ==================================================\n   MEARI N2 — PREMIUM DARK SHOWCASE\n   ================================================== */\n\n.shopify-section:has(.sg-meari-showcase),\n.shopify-section:has(.sg-meari-showcase) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-showcase) .section,\n.shopify-section:has(.sg-meari-showcase) .section__inner,\n.shopify-section:has(.sg-meari-showcase) .container,\n.shopify-section:has(.sg-meari-showcase) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-showcase,\n.sg-meari-showcase * {\n  box-sizing: border-box;\n}\n\n.sg-meari-showcase {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #49b0ff;\n  --sg-orange: #ff6a13;\n  --sg-white: #ffffff;\n  --sg-muted: #b7c8dc;\n  --sg-navy: #04101e;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-white);\n  background:\n    radial-gradient(\n      circle at 50% 38%,\n      rgba(33, 143, 255, 0.23),\n      transparent 29%\n    ),\n    radial-gradient(\n      circle at 15% 75%,\n      rgba(17, 98, 190, 0.16),\n      transparent 29%\n    ),\n    radial-gradient(\n      circle at 88% 18%,\n      rgba(55, 163, 255, 0.12),\n      transparent 25%\n    ),\n    linear-gradient(\n      145deg,\n      #020914 0%,\n      #06192d 51%,\n      #020b16 100%\n    );\n  font-family: inherit;\n}\n\n.sg-meari-showcase::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: 0.16;\n  background-image:\n    linear-gradient(\n      rgba(255,255,255,.035) 1px,\n      transparent 1px\n    ),\n    linear-gradient(\n      90deg,\n      rgba(255,255,255,.035) 1px,\n      transparent 1px\n    );\n  background-size: 58px 58px;\n}\n\n.sg-meari-showcase::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: -330px;\n  z-index: 0;\n  width: 760px;\n  height: 760px;\n  border: 1px solid rgba(74, 177, 255, 0.10);\n  border-radius: 50%;\n  transform: translateX(-50%);\n  box-shadow:\n    0 0 0 85px rgba(67,168,255,.022),\n    0 0 0 170px rgba(67,168,255,.016),\n    0 0 0 255px rgba(67,168,255,.010);\n}\n\n.sg-meari-showcase__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1420px, calc(100% - 48px));\n  min-height: 850px;\n  margin: 0 auto;\n  padding: 90px 0 92px;\n}\n\n.sg-meari-showcase__header {\n  position: relative;\n  z-index: 5;\n  max-width: 860px;\n  margin: 0 auto 45px;\n  text-align: center;\n}\n\n.sg-meari-showcase__eyebrow {\n  margin: 0 0 14px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-showcase h2 {\n  margin: 0 0 19px;\n  color: #ffffff;\n  font-size: clamp(44px, 5.8vw, 78px);\n  line-height: 0.98;\n  letter-spacing: -0.052em;\n  font-weight: 860;\n}\n\n.sg-meari-showcase h2 span {\n  display: block;\n  color: var(--sg-blue-light);\n}\n\n.sg-meari-showcase__intro {\n  max-width: 730px;\n  margin: 0 auto;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.67;\n}\n\n.sg-meari-showcase__stage {\n  position: relative;\n  min-height: 500px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sg-meari-showcase__halo {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 540px;\n  height: 540px;\n  border-radius: 50%;\n  background:\n    radial-gradient(\n      circle,\n      rgba(67, 168, 255, 0.32) 0%,\n      rgba(22, 134, 232, 0.13) 42%,\n      transparent 70%\n    );\n  filter: blur(8px);\n  transform: translate(-50%, -50%);\n}\n\n.sg-meari-showcase__ring {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 440px;\n  height: 440px;\n  border: 1px solid rgba(93, 190, 255, 0.20);\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  animation: sgMeariRing 8s linear infinite;\n}\n\n.sg-meari-showcase__ring::before,\n.sg-meari-showcase__ring::after {\n  content: \"\";\n  position: absolute;\n  border: 1px solid rgba(93, 190, 255, 0.11);\n  border-radius: 50%;\n}\n\n.sg-meari-showcase__ring::before {\n  inset: 34px;\n}\n\n.sg-meari-showcase__ring::after {\n  inset: 74px;\n}\n\n.sg-meari-showcase__ring-dot {\n  position: absolute;\n  top: 19px;\n  left: 50%;\n  width: 11px;\n  height: 11px;\n  border-radius: 50%;\n  background: var(--sg-blue-light);\n  box-shadow:\n    0 0 12px rgba(73,176,255,.9),\n    0 0 28px rgba(73,176,255,.65);\n  transform: translateX(-50%);\n}\n\n.sg-meari-showcase__product {\n  position: relative;\n  z-index: 4;\n  width: min(460px, 42vw);\n  animation: sgMeariFloat 5.5s ease-in-out infinite;\n  filter:\n    drop-shadow(0 38px 38px rgba(0,0,0,.36))\n    drop-shadow(0 0 38px rgba(25,137,238,.14));\n}\n\n.sg-meari-showcase__image {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-height: 470px;\n  object-fit: contain;\n  object-position: center;\n}\n\n.sg-meari-showcase__floor {\n  position: absolute;\n  left: 50%;\n  bottom: 46px;\n  width: 420px;\n  height: 65px;\n  border-radius: 50%;\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(0,0,0,.56) 0%,\n      rgba(0,0,0,.23) 46%,\n      transparent 72%\n    );\n  filter: blur(7px);\n  transform: translateX(-50%);\n}\n\n.sg-meari-showcase__card {\n  position: absolute;\n  z-index: 7;\n  width: 260px;\n  min-height: 104px;\n  padding: 17px 18px;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  border: 1px solid rgba(91, 184, 255, 0.25);\n  border-radius: 17px;\n  background: rgba(6, 27, 49, 0.78);\n  box-shadow:\n    0 22px 50px rgba(0,0,0,.28),\n    inset 0 1px 0 rgba(255,255,255,.04);\n  backdrop-filter: blur(16px);\n  transition:\n    transform 0.28s ease,\n    border-color 0.28s ease,\n    background 0.28s ease;\n}\n\n.sg-meari-showcase__card:hover {\n  transform: translateY(-5px);\n  border-color: rgba(91, 184, 255, 0.48);\n  background: rgba(8, 37, 66, 0.90);\n}\n\n.sg-meari-showcase__card--one {\n  top: 70px;\n  left: 2%;\n}\n\n.sg-meari-showcase__card--two {\n  top: 70px;\n  right: 2%;\n}\n\n.sg-meari-showcase__card--three {\n  left: 7%;\n  bottom: 62px;\n}\n\n.sg-meari-showcase__card--four {\n  right: 7%;\n  bottom: 62px;\n}\n\n.sg-meari-showcase__icon {\n  width: 48px;\n  height: 48px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue-light);\n  border: 1px solid rgba(73,176,255,.22);\n  border-radius: 14px;\n  background: rgba(22,134,232,.13);\n}\n\n.sg-meari-showcase__icon svg {\n  width: 25px;\n  height: 25px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-showcase__card strong {\n  display: block;\n  margin-bottom: 5px;\n  color: #ffffff;\n  font-size: 17px;\n  line-height: 1.2;\n  font-weight: 820;\n}\n\n.sg-meari-showcase__card span {\n  display: block;\n  color: var(--sg-muted);\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n\n\n@keyframes sgMeariFloat {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-14px);\n  }\n}\n\n@keyframes sgMeariRing {\n  from {\n    transform: translate(-50%, -50%) rotate(0deg);\n  }\n\n  to {\n    transform: translate(-50%, -50%) rotate(360deg);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sg-meari-showcase__ring,\n  .sg-meari-showcase__product {\n    animation: none;\n  }\n}\n\n@media screen and (max-width: 1150px) {\n  .sg-meari-showcase__inner {\n    min-height: 940px;\n  }\n\n  .sg-meari-showcase__stage {\n    min-height: 600px;\n  }\n\n  .sg-meari-showcase__card--one {\n    top: 20px;\n    left: 1%;\n  }\n\n  .sg-meari-showcase__card--two {\n    top: 20px;\n    right: 1%;\n  }\n\n  .sg-meari-showcase__card--three {\n    left: 1%;\n    bottom: 40px;\n  }\n\n  .sg-meari-showcase__card--four {\n    right: 1%;\n    bottom: 40px;\n  }\n}\n\n@media screen and (max-width: 900px) {\n  .sg-meari-showcase__inner {\n    width: min(100% - 28px, 760px);\n    min-height: auto;\n    padding: 72px 0 76px;\n  }\n\n  .sg-meari-showcase__header {\n    margin-bottom: 38px;\n  }\n\n  .sg-meari-showcase__stage {\n    min-height: auto;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 16px;\n    padding-top: 390px;\n  }\n\n  .sg-meari-showcase__halo,\n  .sg-meari-showcase__ring,\n  .sg-meari-showcase__product,\n  .sg-meari-showcase__floor {\n    position: absolute;\n  }\n\n  .sg-meari-showcase__product {\n    top: 12px;\n    left: 50%;\n    width: 340px;\n    transform: translateX(-50%);\n    animation: none;\n  }\n\n  .sg-meari-showcase__image {\n    max-height: 350px;\n  }\n\n  .sg-meari-showcase__halo {\n    top: 170px;\n    width: 440px;\n    height: 440px;\n  }\n\n  .sg-meari-showcase__ring {\n    top: 170px;\n    width: 350px;\n    height: 350px;\n  }\n\n  .sg-meari-showcase__floor {\n    top: 320px;\n    bottom: auto;\n    width: 340px;\n  }\n\n  .sg-meari-showcase__card,\n  .sg-meari-showcase__card--one,\n  .sg-meari-showcase__card--two,\n  .sg-meari-showcase__card--three,\n  .sg-meari-showcase__card--four {\n    position: relative;\n    inset: auto;\n    width: 100%;\n    min-height: 100px;\n  }\n\n  .sg-meari-showcase__footer {\n    margin-top: 34px;\n  }\n}\n\n@media screen and (max-width: 580px) {\n  .sg-meari-showcase__inner {\n    width: calc(100% - 24px);\n    padding: 56px 0 60px;\n  }\n\n  .sg-meari-showcase h2 {\n    font-size: 40px;\n  }\n\n  .sg-meari-showcase__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-showcase__stage {\n    grid-template-columns: 1fr;\n    gap: 13px;\n    padding-top: 325px;\n  }\n\n  .sg-meari-showcase__product {\n    width: 285px;\n  }\n\n  .sg-meari-showcase__image {\n    max-height: 285px;\n  }\n\n  .sg-meari-showcase__halo {\n    top: 140px;\n    width: 340px;\n    height: 340px;\n  }\n\n  .sg-meari-showcase__ring {\n    top: 140px;\n    width: 275px;\n    height: 275px;\n  }\n\n  .sg-meari-showcase__floor {\n    top: 267px;\n    width: 275px;\n  }\n\n  .sg-meari-showcase__card {\n    padding: 15px;\n  }\n\n  \n}\n</style>\n\n<section class=\"sg-meari-showcase\">\n  <div class=\"sg-meari-showcase__inner\">\n\n    <div class=\"sg-meari-showcase__header\">\n\n      <div class=\"sg-meari-showcase__eyebrow\">\n        Slimme bewaking, dag en nacht\n      </div>\n\n      <h2>\n        Zie ieder detail.\n        <span>Mis geen moment.</span>\n      </h2>\n\n      <p class=\"sg-meari-showcase__intro\">\n        De MEARI N2 combineert scherpe 3MP-beelden met intelligente\n        detectie, automatische tracking en helder nachtzicht voor\n        complete controle rondom uw woning.\n      </p>\n\n    </div>\n\n    <div class=\"sg-meari-showcase__stage\">\n\n      <div class=\"sg-meari-showcase__halo\"></div>\n\n      <div class=\"sg-meari-showcase__ring\">\n        <span class=\"sg-meari-showcase__ring-dot\"></span>\n      </div>\n\n      <div class=\"sg-meari-showcase__floor\"></div>\n\n      <div class=\"sg-meari-showcase__product\">\n\n        {% if sg_showcase_image %}\n          {{\n            sg_showcase_image\n            | image_url: width: 1200\n            | image_tag:\n              class: 'sg-meari-showcase__image',\n              loading: 'lazy',\n              widths: '420, 640, 800, 1000, 1200',\n              sizes: '(max-width: 580px) 285px, (max-width: 900px) 340px, 460px',\n              alt: 'MEARI N2 Outdoor AI beveiligingscamera'\n          }}\n        {% endif %}\n\n      </div>\n\n      <div class=\"sg-meari-showcase__card sg-meari-showcase__card--one\">\n\n        <div class=\"sg-meari-showcase__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"></rect>\n            <path d=\"M7 9h10M7 13h6\"></path>\n          </svg>\n        </div>\n\n        <div>\n          <strong>3MP beeldkwaliteit</strong>\n          <span>\n            Scherpe beelden voor herkenbare details rond uw woning.\n          </span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-showcase__card sg-meari-showcase__card--two\">\n\n        <div class=\"sg-meari-showcase__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"7\" r=\"3\"></circle>\n            <path d=\"M6 20c.9-4.2 3-6.3 6-6.3S17.1 15.8 18 20\"></path>\n            <path d=\"M3 8V4h4M21 8V4h-4\"></path>\n          </svg>\n        </div>\n\n        <div>\n          <strong>AI-detectie</strong>\n          <span>\n            Ontvang gerichte meldingen wanneer een persoon wordt gezien.\n          </span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-showcase__card sg-meari-showcase__card--three\">\n\n        <div class=\"sg-meari-showcase__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n            <path d=\"M17 3v4M15 5h4\"></path>\n          </svg>\n        </div>\n\n        <div>\n          <strong>Full-color nachtzicht</strong>\n          <span>\n            Bekijk heldere beelden, ook wanneer het buiten donker is.\n          </span>\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-showcase__card sg-meari-showcase__card--four\">\n\n        <div class=\"sg-meari-showcase__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n            <path d=\"M4 5v5h5\"></path>\n            <path d=\"M9 12h6\"></path>\n          </svg>\n        </div>\n\n        <div>\n          <strong>Auto Tracking</strong>\n          <span>\n            De camera volgt beweging automatisch voor betere dekking.\n          </span>\n        </div>\n</div>\n</section>",
