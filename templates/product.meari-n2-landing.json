e=\"color: {{ description_color | default: \"#000000\" }}; font-size: {{ description_font_size | default: \"15px\" }}; max-width: {{ description_max_width | default: \"600px\" }}; margin: 0 auto {{ description_margin_bottom | default: \"30px\" }} auto;\">\n    {% if description_text %}\n      {{ description_text }}\n    {% else %}\n    Wij zijn zo overtuigd van de kwaliteit van ons product dat wij een tevredenheidsgarantie bieden. Als u niet volledig tevreden bent met uw aankoop, retourneert u het artikel eenvoudig binnen 30 dagen voor een volledige terugbetaling\n    {% endif %}\n  </div>\n\n  <div style=\"margin: {{ button_margin | default: \"30px auto 20px\" }};\">\n    <a href=\"{{ button_link | default: \"https://smartsgadgets.eu/collections/xenon-smart\" }}\" style=\"display: inline-block; background: {{ button_bg | default: \"#E64E30\" }}; color: {{ button_text_color | default: \"white\" }}; padding: {{ button_padding | default: \"16px 40px\" }}; border-radius: {{ button_border_radius | default: \"12px\" }}; font-weight: {{ button_font_weight | default: \"700\" }}; font-size: {{ button_font_size | default: \"15px\" }}; letter-spacing: 1px; text-decoration: none;\">\n      {{ button_text | default: \"KOOP NU\" }}\n    </a>\n  </div>\n\n  <div style=\"margin-top: {{ features_margin_top | default: \"24px\" }}; font-size: {{ features_font_size | default: \"14px\" }}; color: {{ features_color | default: \"#000000\" }}; display: flex; gap: {{ features_gap | default: \"16px\" }}; justify-content: center; flex-wrap: wrap; align-items: center;\">\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_1_text | default: \"100% Tevredenheid\" }}</span>\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_2_text | default: \"Snelle Verzending\" }}</span>\n    <span style=\"display: flex; align-items: center; gap: 6px;\"><svg width=\"16\" height=\"16\" fill=\"{{ check_icon_color | default: \"#E64E30\" }}\" viewBox=\"0 0 24 24\"><path d=\"M20.292 5.708a1 1 0 0 1 0 1.414L9 18.414l-5.292-5.292a1 1 0 0 1 1.414-1.414L9 15.586l10.292-10.292a1 1 0 0 1 1.414 0z\"/></svg>{{ feature_3_text | default: \"Eenvoudig Retourneren\" }}</span>\n  </div>\n</div>"
