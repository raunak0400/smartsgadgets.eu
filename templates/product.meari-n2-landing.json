    "custom_liquid_e4QYpp": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% assign sg_bundle_n2_image = \"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_21_2026_11_10_04_AM.png?v=1784625017\" %}\n{% assign sg_bundle_s1_image = \"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_21_2026_11_02_43_AM.png?v=1784624579\" %}\n{% assign sg_bundle_product_url = \"PASTE_PRODUCT_URL_HERE\" %}\n\n<style>\n/* ==================================================\n   SMARTSGADGETS — RESPONSIVE MEARI BUNDLE\n   ================================================== */\n\n.shopify-section:has(.sg-meari-bundle),\n.shopify-section:has(.sg-meari-bundle) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-bundle) .section,\n.shopify-section:has(.sg-meari-bundle) .section__inner,\n.shopify-section:has(.sg-meari-bundle) .container,\n.shopify-section:has(.sg-meari-bundle) .page-width {\n  margin: 0 !important;\n  padding: 0 !important;\n  max-width: none !important;\n}\n\n.sg-meari-bundle,\n.sg-meari-bundle * {\n  box-sizing: border-box;\n}\n\n.sg-meari-bundle {\n  --sg-orange: #ff6a00;\n  --sg-orange-light: #ff8a24;\n  --sg-navy: #071b36;\n  --sg-text: #14243b;\n  --sg-muted: #68768a;\n\n  width: 100%;\n  margin: 0;\n  padding: 56px 20px;\n  overflow: hidden;\n  font-family: inherit;\n  background:\n    radial-gradient(circle at 15% 15%, rgba(255, 132, 24, 0.12), transparent 30%),\n    linear-gradient(180deg, #fffaf6 0%, #fff5eb 100%);\n}\n\n.sg-meari-bundle__card {\n  width: min(1180px, 100%);\n  margin: 0 auto;\n  overflow: hidden;\n  border: 1px solid rgba(255, 106, 0, 0.22);\n  border-radius: 34px;\n  background: #ffffff;\n  box-shadow: 0 24px 70px rgba(31, 52, 77, 0.12);\n}\n\n.sg-meari-bundle__header {\n  padding: 46px 36px 36px;\n  text-align: center;\n  color: #ffffff;\n  background:\n    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.16), transparent 28%),\n    linear-gradient(135deg, var(--sg-orange) 0%, var(--sg-orange-light) 100%);\n}\n\n.sg-meari-bundle__badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  margin-bottom: 22px;\n  padding: 11px 19px;\n  border-radius: 999px;\n  color: var(--sg-orange);\n  background: #ffffff;\n  box-shadow: 0 10px 24px rgba(104, 46, 0, 0.15);\n  font-size: 12px;\n  line-height: 1;\n  font-weight: 850;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.sg-meari-bundle__badge svg {\n  width: 20px;\n  height: 20px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-bundle__header h2 {\n  max-width: 850px;\n  margin: 0 auto 18px;\n  color: #ffffff;\n  font-size: clamp(36px, 5vw, 62px);\n  line-height: 1.04;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-bundle__header h2 span {\n  color: var(--sg-navy);\n}\n\n.sg-meari-bundle__intro {\n  max-width: 760px;\n  margin: 0 auto;\n  color: rgba(255, 255, 255, 0.94);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-bundle__products {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 76px minmax(0, 1fr);\n  align-items: center;\n  gap: 20px;\n  padding: 48px 52px 34px;\n}\n\n.sg-meari-bundle__product {\n  min-width: 0;\n  text-align: center;\n}\n\n.sg-meari-bundle__image-area {\n  height: 300px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 20px;\n}\n\n.sg-meari-bundle__image {\n  display: block;\n  width: 100%;\n  max-width: 360px;\n  max-height: 290px;\n  object-fit: contain;\n  filter: drop-shadow(0 20px 20px rgba(20, 42, 68, 0.16));\n}\n\n.sg-meari-bundle__product-card {\n  min-height: 120px;\n  padding: 22px 18px;\n  border: 1px solid rgba(20, 42, 68, 0.08);\n  border-radius: 22px;\n  background: #ffffff;\n  box-shadow: 0 12px 34px rgba(20, 42, 68, 0.08);\n}\n\n.sg-meari-bundle__product-card strong {\n  display: block;\n  margin-bottom: 6px;\n  color: var(--sg-navy);\n  font-size: 25px;\n  line-height: 1.2;\n  font-weight: 850;\n}\n\n.sg-meari-bundle__product-card span {\n  color: var(--sg-orange);\n  font-size: 16px;\n  line-height: 1.4;\n  font-weight: 750;\n}\n\n.sg-meari-bundle__plus {\n  width: 70px;\n  height: 70px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  justify-self: center;\n  border-radius: 50%;\n  color: #ffffff;\n  background: linear-gradient(135deg, var(--sg-orange), var(--sg-orange-light));\n  box-shadow: 0 14px 28px rgba(255, 106, 0, 0.25);\n  font-size: 42px;\n  line-height: 1;\n  font-weight: 500;\n}\n\n.sg-meari-bundle__offer {\n  margin: 10px 52px 48px;\n  padding: 34px;\n  text-align: center;\n  border: 1px solid rgba(255, 106, 0, 0.24);\n  border-radius: 26px;\n  background:\n    radial-gradient(circle at 90% 10%, rgba(255,106,0,0.08), transparent 30%),\n    #fffaf6;\n}\n\n.sg-meari-bundle__gift-icon {\n  width: 70px;\n  height: 70px;\n  margin: -68px auto 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 7px solid #ffffff;\n  border-radius: 50%;\n  color: #ffffff;\n  background: linear-gradient(135deg, var(--sg-orange), var(--sg-orange-light));\n  box-shadow: 0 12px 25px rgba(255, 106, 0, 0.22);\n}\n\n.sg-meari-bundle__gift-icon svg {\n  width: 31px;\n  height: 31px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-bundle__offer h3 {\n  max-width: 780px;\n  margin: 0 auto 25px;\n  color: var(--sg-navy);\n  font-size: clamp(25px, 3vw, 34px);\n  line-height: 1.3;\n  font-weight: 850;\n}\n\n.sg-meari-bundle__offer h3 span {\n  color: var(--sg-orange);\n}\n\n.sg-meari-bundle__benefits {\n  max-width: 780px;\n  margin: 0 auto 28px;\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 14px 28px;\n}\n\n.sg-meari-bundle__benefit {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--sg-text);\n  font-size: 15px;\n  line-height: 1.4;\n  font-weight: 700;\n}\n\n.sg-meari-bundle__check {\n  flex: 0 0 auto;\n  width: 27px;\n  height: 27px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  color: var(--sg-orange);\n  background: #ffffff;\n  box-shadow: 0 5px 14px rgba(36, 53, 75, 0.10);\n}\n\n.sg-meari-bundle__check svg {\n  width: 15px;\n  height: 15px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-bundle__button {\n  min-height: 54px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 15px 30px;\n  border: 0;\n  border-radius: 999px;\n  color: #ffffff !important;\n  background: var(--sg-navy);\n  box-shadow: 0 12px 28px rgba(7, 27, 54, 0.20);\n  text-decoration: none !important;\n  font-size: 16px;\n  line-height: 1.2;\n  font-weight: 800;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.sg-meari-bundle__button:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 16px 34px rgba(7, 27, 54, 0.26);\n}\n\n.sg-meari-bundle__stock {\n  margin: 18px 0 0;\n  color: var(--sg-muted);\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n/* =========================\n   TABLET\n   ========================= */\n\n@media screen and (max-width: 900px) {\n  .sg-meari-bundle {\n    padding: 40px 16px;\n  }\n\n  .sg-meari-bundle__products {\n    padding: 38px 28px 30px;\n  }\n\n  .sg-meari-bundle__image-area {\n    height: 240px;\n  }\n\n  .sg-meari-bundle__image {\n    max-height: 230px;\n  }\n\n  .sg-meari-bundle__offer {\n    margin: 10px 28px 38px;\n  }\n}\n\n/* =========================\n   MOBILE\n   ========================= */\n\n@media screen and (max-width: 600px) {\n  .sg-meari-bundle {\n    padding: 24px 12px;\n  }\n\n  .sg-meari-bundle__card {\n    border-radius: 24px;\n  }\n\n  .sg-meari-bundle__header {\n    padding: 30px 18px 27px;\n  }\n\n  .sg-meari-bundle__badge {\n    margin-bottom: 17px;\n    padding: 10px 15px;\n    font-size: 10px;\n  }\n\n  .sg-meari-bundle__header h2 {\n    margin-bottom: 14px;\n    font-size: 34px;\n    line-height: 1.08;\n  }\n\n  .sg-meari-bundle__intro {\n    font-size: 15px;\n    line-height: 1.55;\n  }\n\n  .sg-meari-bundle__products {\n    grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr);\n    gap: 7px;\n    padding: 28px 12px 28px;\n  }\n\n  .sg-meari-bundle__image-area {\n    height: 145px;\n    margin-bottom: 12px;\n  }\n\n  .sg-meari-bundle__image {\n    max-width: 150px;\n    max-height: 140px;\n  }\n\n  .sg-meari-bundle__product-card {\n    min-height: 92px;\n    padding: 15px 7px;\n    border-radius: 16px;\n  }\n\n  .sg-meari-bundle__product-card strong {\n    margin-bottom: 4px;\n    font-size: 17px;\n  }\n\n  .sg-meari-bundle__product-card span {\n    font-size: 12px;\n    line-height: 1.3;\n  }\n\n  .sg-meari-bundle__plus {\n    width: 42px;\n    height: 42px;\n    font-size: 28px;\n  }\n\n  .sg-meari-bundle__offer {\n    margin: 6px 12px 24px;\n    padding: 28px 16px 24px;\n    border-radius: 20px;\n  }\n\n  .sg-meari-bundle__gift-icon {\n    width: 58px;\n    height: 58px;\n    margin-top: -58px;\n    margin-bottom: 16px;\n    border-width: 6px;\n  }\n\n  .sg-meari-bundle__gift-icon svg {\n    width: 25px;\n    height: 25px;\n  }\n\n  .sg-meari-bundle__offer h3 {\n    margin-bottom: 20px;\n    font-size: 22px;\n    line-height: 1.3;\n  }\n\n  .sg-meari-bundle__benefits {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 11px;\n    margin-bottom: 22px;\n    text-align: left;\n  }\n\n  .sg-meari-bundle__benefit {\n    font-size: 14px;\n  }\n\n  .sg-meari-bundle__button {\n    width: 100%;\n    min-height: 52px;\n    padding: 14px 18px;\n    font-size: 15px;\n  }\n\n  .sg-meari-bundle__stock {\n    margin-top: 14px;\n    font-size: 12px;\n  }\n}\n\n@media screen and (max-width: 390px) {\n  .sg-meari-bundle__header h2 {\n    font-size: 30px;\n  }\n\n  .sg-meari-bundle__products {\n    grid-template-columns: minmax(0, 1fr) 36px minmax(0, 1fr);\n    padding-left: 8px;\n    padding-right: 8px;\n  }\n\n  .sg-meari-bundle__plus {\n    width: 36px;\n    height: 36px;\n    font-size: 24px;\n  }\n\n  .sg-meari-bundle__image-area {\n    height: 125px;\n  }\n\n  .sg-meari-bundle__image {\n    max-width: 130px;\n    max-height: 120px;\n  }\n\n  .sg-meari-bundle__product-card strong {\n    font-size: 15px;\n  }\n\n  .sg-meari-bundle__product-card span {\n    font-size: 11px;\n  }\n}\n</style>\n\n<section class=\"sg-meari-bundle\">\n  <div class=\"sg-meari-bundle__card\">\n\n    <div class=\"sg-meari-bundle__header\">\n\n      <div class=\"sg-meari-bundle__badge\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"2\"></rect>\n          <path d=\"M12 8v13M3 12h18M7.5 8C5 8 4.5 4.5 7 4.5c2 0 3.5 3.5 5 3.5M16.5 8c2.5 0 3-3.5.5-3.5-2 0-3.5 3.5-5 3.5\"></path>\n        </svg>\n        Tijdelijke actie\n      </div>\n\n      <h2>\n        Beveilig buiten én binnen.\n        <span>Ontvang de S1 Plus gratis.</span>\n      </h2>\n\n      <p class=\"sg-meari-bundle__intro\">\n        Koop de MEARI N2 Outdoor-camera en ontvang tijdelijk een\n        MEARI S1 Plus indoorcamera cadeau.\n      </p>\n\n    </div>\n\n    <div class=\"sg-meari-bundle__products\">\n\n      <div class=\"sg-meari-bundle__product\">\n        <div class=\"sg-meari-bundle__image-area\">\n          {% if sg_bundle_n2_image != blank %}\n            <img\n              src=\"{{ sg_bundle_n2_image }}\"\n              alt=\"MEARI N2 Outdoor beveiligingscamera\"\n              class=\"sg-meari-bundle__image\"\n              loading=\"lazy\"\n            >\n          {% endif %}\n        </div>\n\n        <div class=\"sg-meari-bundle__product-card\">\n          <strong>MEARI N2</strong>\n          <span>Outdoor beveiligingscamera</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-bundle__plus\" aria-hidden=\"true\">\n        +\n      </div>\n\n      <div class=\"sg-meari-bundle__product\">\n        <div class=\"sg-meari-bundle__image-area\">\n          {% if sg_bundle_s1_image != blank %}\n            <img\n              src=\"{{ sg_bundle_s1_image }}\"\n              alt=\"MEARI S1 Plus indoorcamera\"\n              class=\"sg-meari-bundle__image\"\n              loading=\"lazy\"\n            >\n          {% endif %}\n        </div>\n\n        <div class=\"sg-meari-bundle__product-card\">\n          <strong>MEARI S1 Plus</strong>\n          <span>Indoorcamera · Gratis</span>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"sg-meari-bundle__offer\">\n\n      <div class=\"sg-meari-bundle__gift-icon\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"2\"></rect>\n          <path d=\"M12 8v13M3 12h18M7.5 8C5 8 4.5 4.5 7 4.5c2 0 3.5 3.5 5 3.5M16.5 8c2.5 0 3-3.5.5-3.5-2 0-3.5 3.5-5 3.5\"></path>\n        </svg>\n      </div>\n\n      <h3>\n        Voeg de MEARI N2 en MEARI S1 Plus toe aan uw winkelmandje en ontvang de\n        MEARI S1 Plus <span>helemaal gratis!</span>\n      </h3>\n\n      <div class=\"sg-meari-bundle__benefits\">\n\n        <div class=\"sg-meari-bundle__benefit\">\n          <span class=\"sg-meari-bundle__check\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m5 12 4 4L19 6\"></path>\n            </svg>\n          </span>\n          Complete beveiliging voor binnen en buiten\n        </div>\n\n        <div class=\"sg-meari-bundle__benefit\">\n          <span class=\"sg-meari-bundle__check\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m5 12 4 4L19 6\"></path>\n            </svg>\n          </span>\n          Beide camera’s beheren via één app\n        </div>\n\n        <div class=\"sg-meari-bundle__benefit\">\n          <span class=\"sg-meari-bundle__check\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"m5 12 4 4L19 6\"></path>\n            </svg>\n          </span>\n          Geen kortingscode nodig\n        </div>\n\n      </div>\n\n      {% if sg_bundle_product_url != blank %}\n        <a\n      {% endif %}\n\n      <p class=\"sg-meari-bundle__stock\">\n        Tijdelijke actie zolang de voorraad strekt.\n      </p>\n\n    </div>\n\n  </div>\n</section>",
