    "custom_liquid_9x3HM6": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   MEARI N2 — PREMIUM FAQ ACCORDION\n   ================================================== */\n\n.shopify-section:has(.sg-meari-faq),\n.shopify-section:has(.sg-meari-faq) > div {\n  width: 100% !important;\n  max-width: none !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.shopify-section:has(.sg-meari-faq) .section,\n.shopify-section:has(.sg-meari-faq) .section__inner,\n.shopify-section:has(.sg-meari-faq) .container,\n.shopify-section:has(.sg-meari-faq) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-faq,\n.sg-meari-faq * {\n  box-sizing: border-box;\n}\n\n.sg-meari-faq {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #43a8ff;\n  --sg-navy: #07172a;\n  --sg-orange: #ff6a13;\n  --sg-text: #142237;\n  --sg-muted: #65758a;\n  --sg-line: #dbe7f2;\n  --sg-soft: #f4f9fe;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-text);\n  background:\n    radial-gradient(\n      circle at 10% 16%,\n      rgba(22, 134, 232, 0.08),\n      transparent 28%\n    ),\n    radial-gradient(\n      circle at 91% 84%,\n      rgba(22, 134, 232, 0.06),\n      transparent 27%\n    ),\n    linear-gradient(\n      180deg,\n      #f7fbff 0%,\n      #ffffff 100%\n    );\n  font-family: inherit;\n}\n\n.sg-meari-faq::before {\n  content: \"\";\n  position: absolute;\n  right: -140px;\n  top: 95px;\n  width: 360px;\n  height: 360px;\n  border: 1px solid rgba(22, 134, 232, 0.08);\n  border-radius: 50%;\n  box-shadow:\n    0 0 0 65px rgba(22, 134, 232, 0.022),\n    0 0 0 130px rgba(22, 134, 232, 0.014);\n  pointer-events: none;\n}\n\n.sg-meari-faq__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1320px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 90px 0 96px;\n}\n\n.sg-meari-faq__header {\n  max-width: 820px;\n  margin: 0 auto 47px;\n  text-align: center;\n}\n\n.sg-meari-faq__eyebrow {\n  margin: 0 0 13px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-faq h2 {\n  margin: 0 0 17px;\n  color: var(--sg-navy);\n  font-size: clamp(39px, 4.8vw, 64px);\n  line-height: 1.04;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-faq h2 span {\n  color: var(--sg-blue);\n}\n\n.sg-meari-faq__intro {\n  max-width: 720px;\n  margin: 0 auto;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-faq__layout {\n  display: grid;\n  grid-template-columns:\n    minmax(0, 0.72fr)\n    minmax(0, 1.28fr);\n  gap: 28px;\n  align-items: start;\n}\n\n/* Left information card */\n\n.sg-meari-faq__support {\n  position: sticky;\n  top: 24px;\n  overflow: hidden;\n  padding: 32px;\n  border: 1px solid rgba(22, 134, 232, 0.15);\n  border-radius: 24px;\n  background:\n    radial-gradient(\n      circle at 85% 15%,\n      rgba(67, 168, 255, 0.17),\n      transparent 31%\n    ),\n    linear-gradient(\n      145deg,\n      #07172a,\n      #0b2a49\n    );\n  box-shadow:\n    0 20px 52px rgba(21, 62, 102, 0.16);\n}\n\n.sg-meari-faq__support-icon {\n  width: 58px;\n  height: 58px;\n  margin-bottom: 23px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue-light);\n  border: 1px solid rgba(73, 176, 255, 0.23);\n  border-radius: 18px;\n  background: rgba(22, 134, 232, 0.14);\n}\n\n.sg-meari-faq__support-icon svg {\n  width: 29px;\n  height: 29px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-faq__support h3 {\n  margin: 0 0 13px;\n  color: #ffffff;\n  font-size: 29px;\n  line-height: 1.13;\n  letter-spacing: -0.03em;\n  font-weight: 840;\n}\n\n.sg-meari-faq__support > p {\n  margin: 0 0 25px;\n  color: #b9cbdd;\n  font-size: 15px;\n  line-height: 1.66;\n}\n\n.sg-meari-faq__support-points {\n  display: grid;\n  gap: 13px;\n}\n\n.sg-meari-faq__support-point {\n  display: flex;\n  align-items: flex-start;\n  gap: 11px;\n  color: #e5f2ff;\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n.sg-meari-faq__support-check {\n  width: 24px;\n  height: 24px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #7cc6ff;\n  border: 1px solid rgba(73, 176, 255, 0.22);\n  border-radius: 8px;\n  background: rgba(22, 134, 232, 0.12);\n}\n\n.sg-meari-faq__support-check svg {\n  width: 14px;\n  height: 14px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n\n\n\n\n\n/* Accordion */\n\n.sg-meari-faq__list {\n  display: grid;\n  gap: 14px;\n}\n\n.sg-meari-faq__item {\n  overflow: hidden;\n  border: 1px solid rgba(23, 105, 179, 0.13);\n  border-radius: 18px;\n  background: #ffffff;\n  box-shadow:\n    0 11px 30px rgba(24, 68, 112, 0.065);\n  transition:\n    border-color 0.24s ease,\n    box-shadow 0.24s ease,\n    transform 0.24s ease;\n}\n\n.sg-meari-faq__item:hover {\n  border-color: rgba(22, 134, 232, 0.27);\n  box-shadow:\n    0 16px 39px rgba(24, 68, 112, 0.10);\n}\n\n.sg-meari-faq__item.is-open {\n  border-color: rgba(22, 134, 232, 0.32);\n  box-shadow:\n    0 18px 46px rgba(24, 68, 112, 0.11);\n}\n\n.sg-meari-faq__question {\n  width: 100%;\n  min-height: 80px;\n  padding: 20px 22px;\n  display: grid;\n  grid-template-columns: 44px minmax(0, 1fr) 38px;\n  gap: 14px;\n  align-items: center;\n  color: var(--sg-navy);\n  border: 0;\n  background: transparent;\n  font-family: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.sg-meari-faq__question-icon {\n  width: 44px;\n  height: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue);\n  border: 1px solid rgba(22, 134, 232, 0.16);\n  border-radius: 13px;\n  background: rgba(22, 134, 232, 0.07);\n}\n\n.sg-meari-faq__question-icon svg {\n  width: 22px;\n  height: 22px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-faq__question-text {\n  font-size: 17px;\n  line-height: 1.35;\n  font-weight: 820;\n}\n\n.sg-meari-faq__toggle {\n  position: relative;\n  width: 36px;\n  height: 36px;\n  border: 1px solid rgba(22, 134, 232, 0.15);\n  border-radius: 50%;\n  background: var(--sg-soft);\n  transition:\n    background 0.22s ease,\n    transform 0.28s ease,\n    border-color 0.22s ease;\n}\n\n.sg-meari-faq__toggle::before,\n.sg-meari-faq__toggle::after {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 14px;\n  height: 2px;\n  border-radius: 999px;\n  background: var(--sg-blue);\n  transform: translate(-50%, -50%);\n}\n\n.sg-meari-faq__toggle::after {\n  transform:\n    translate(-50%, -50%)\n    rotate(90deg);\n  transition:\n    transform 0.25s ease,\n    opacity 0.25s ease;\n}\n\n.sg-meari-faq__item.is-open .sg-meari-faq__toggle {\n  border-color: var(--sg-blue);\n  background: var(--sg-blue);\n  transform: rotate(180deg);\n}\n\n.sg-meari-faq__item.is-open .sg-meari-faq__toggle::before,\n.sg-meari-faq__item.is-open .sg-meari-faq__toggle::after {\n  background: #ffffff;\n}\n\n.sg-meari-faq__item.is-open .sg-meari-faq__toggle::after {\n  opacity: 0;\n  transform:\n    translate(-50%, -50%)\n    rotate(0deg);\n}\n\n.sg-meari-faq__answer-wrap {\n  max-height: 0;\n  overflow: hidden;\n  opacity: 0;\n  transition:\n    max-height 0.38s ease,\n    opacity 0.28s ease;\n}\n\n.sg-meari-faq__answer {\n  margin: 0 22px 22px 80px;\n  padding: 19px 20px;\n  color: #54677c;\n  border-top: 1px solid var(--sg-line);\n  border-radius: 0 0 13px 13px;\n  background: #fbfdff;\n  font-size: 15px;\n  line-height: 1.7;\n}\n\n.sg-meari-faq__answer p {\n  margin: 0;\n}\n\n.sg-meari-faq__answer p + p {\n  margin-top: 10px;\n}\n\n.sg-meari-faq__answer strong {\n  color: var(--sg-navy);\n  font-weight: 800;\n}\n\n.sg-meari-faq__item.is-open .sg-meari-faq__answer-wrap {\n  opacity: 1;\n}\n\n/* Bottom CTA */\n\n\n\n\n\n\n\n\n\n\n\n\n\n@media screen and (max-width: 980px) {\n  .sg-meari-faq__layout {\n    grid-template-columns: 1fr;\n  }\n\n  .sg-meari-faq__support {\n    position: relative;\n    top: auto;\n  }\n}\n\n@media screen and (max-width: 720px) {\n  .sg-meari-faq__inner {\n    width: min(100% - 28px, 680px);\n    padding: 68px 0 72px;\n  }\n\n  .sg-meari-faq__header {\n    margin-bottom: 36px;\n  }\n\n  .sg-meari-faq__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-faq__support {\n    padding: 27px;\n    border-radius: 21px;\n  }\n\n  .sg-meari-faq__question {\n    padding: 18px;\n    grid-template-columns: 40px minmax(0, 1fr) 34px;\n    gap: 12px;\n  }\n\n  .sg-meari-faq__question-icon {\n    width: 40px;\n    height: 40px;\n  }\n\n  .sg-meari-faq__question-text {\n    font-size: 16px;\n  }\n\n  .sg-meari-faq__answer {\n    margin: 0 18px 18px;\n  }\n\n  \n\n@media screen and (max-width: 500px) {\n  .sg-meari-faq__inner {\n    width: calc(100% - 24px);\n    padding: 55px 0 60px;\n  }\n\n  .sg-meari-faq h2 {\n    font-size: 37px;\n  }\n\n  .sg-meari-faq__support {\n    padding: 23px;\n  }\n\n  .sg-meari-faq__support h3 {\n    font-size: 26px;\n  }\n\n  .sg-meari-faq__question {\n    min-height: 74px;\n    padding: 15px;\n    grid-template-columns: 36px minmax(0, 1fr) 32px;\n    gap: 10px;\n  }\n\n  .sg-meari-faq__question-icon {\n    width: 36px;\n    height: 36px;\n    border-radius: 11px;\n  }\n\n  .sg-meari-faq__question-icon svg {\n    width: 19px;\n    height: 19px;\n  }\n\n  .sg-meari-faq__toggle {\n    width: 32px;\n    height: 32px;\n  }\n\n  .sg-meari-faq__question-text {\n    font-size: 15px;\n  }\n\n  .sg-meari-faq__answer {\n    padding: 16px;\n    font-size: 14px;\n  }\n\n  \n</style>\n\n<section class=\"sg-meari-faq\">\n  <div class=\"sg-meari-faq__inner\">\n\n    <div class=\"sg-meari-faq__header\">\n\n      <div class=\"sg-meari-faq__eyebrow\">\n        Veelgestelde vragen\n      </div>\n\n      <h2>\n        Alles duidelijk\n        <span>vóór uw bestelling.</span>\n      </h2>\n\n      <p class=\"sg-meari-faq__intro\">\n        Hier vindt u duidelijke antwoorden over installatie, WiFi,\n        batterijgebruik, opslag, de MEARI-app en dagelijks gebruik.\n      </p>\n\n    </div>\n\n    <div class=\"sg-meari-faq__layout\">\n\n      <aside class=\"sg-meari-faq__support\">\n\n        <div class=\"sg-meari-faq__support-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 5h16v11H8l-4 4V5Z\"></path>\n            <path d=\"M9.5 9.5a2.5 2.5 0 1 1 3.7 2.2c-.8.4-1.2.9-1.2 1.8\"></path>\n            <path d=\"M12 16h.01\"></path>\n          </svg>\n        </div>\n\n        <h3>Nog een vraag?</h3>\n\n        <p>\n          De MEARI N2 is ontworpen voor eenvoudig dagelijks gebruik.\n          De belangrijkste vragen vindt u hiernaast overzichtelijk uitgelegd.\n        </p>\n\n        <div class=\"sg-meari-faq__support-points\">\n\n          <div class=\"sg-meari-faq__support-point\">\n            <div class=\"sg-meari-faq__support-check\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </div>\n            Geen vaste stroomkabel nodig\n          </div>\n\n          <div class=\"sg-meari-faq__support-point\">\n            <div class=\"sg-meari-faq__support-check\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </div>\n            Beheer via de MEARI-app\n          </div>\n\n          <div class=\"sg-meari-faq__support-point\">\n            <div class=\"sg-meari-faq__support-check\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </div>\n            Geschikt voor gebruik buitenshuis\n          </div>\n\n          <div class=\"sg-meari-faq__support-point\">\n            <div class=\"sg-meari-faq__support-check\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"m5 12 4 4L19 6\"></path>\n              </svg>\n            </div>\n            Slimme meldingen op uw telefoon\n          </div>\n\n        </div>\n\n        \n\n      </aside>\n\n      <div class=\"sg-meari-faq__list\">\n\n        <!-- FAQ 1 -->\n        <article class=\"sg-meari-faq__item is-open\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"true\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M4 20V8l8-5 8 5v12\"></path>\n                <path d=\"M8 20v-7h8v7\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Is de MEARI N2 eenvoudig te installeren?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                Ja. U laadt de camera op, monteert hem op de gewenste plaats\n                en voegt hem vervolgens toe in de MEARI-app.\n              </p>\n\n              <p>\n                Omdat de camera met een oplaadbare batterij werkt, is er\n                normaal gesproken geen vaste stroomkabel naar de camera nodig.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 2 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M5 9a10 10 0 0 1 14 0\"></path>\n                <path d=\"M8 12a6 6 0 0 1 8 0\"></path>\n                <path d=\"M11 15a2 2 0 0 1 2 0\"></path>\n                <path d=\"M12 19h.01\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Met welk WiFi-netwerk werkt de camera?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                Verbind de camera met het WiFi-netwerk dat door het product\n                en de MEARI-app wordt ondersteund.\n              </p>\n\n              <p>\n                Plaats de camera binnen een stabiel bereik van uw router.\n                Een zwak signaal kan de snelheid van livebeelden en meldingen\n                beïnvloeden.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 3 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <rect x=\"4\" y=\"7\" width=\"15\" height=\"10\" rx=\"2\"></rect>\n                <path d=\"M19 10h2v4h-2M8 10v4M11 10v4\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Hoe lang gaat de batterij mee?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                De gebruiksduur is afhankelijk van instellingen en gebruik.\n                Veel beweging, vaak live kijken, langere opnames en een zwak\n                WiFi-signaal kunnen de batterij sneller verbruiken.\n              </p>\n\n              <p>\n                Door detectiezones en meldingsinstellingen zorgvuldig in te\n                stellen, kunt u onnodige activering helpen beperken.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 4 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M5 10h14l-1 9H6l-1-9Z\"></path>\n                <path d=\"M8 10l1-5h6l1 5\"></path>\n                <path d=\"M12 2v2M4.5 4.5 6 6M19.5 4.5 18 6\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Kan ik een zonnepaneel gebruiken?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                Ja, de camera ondersteunt gebruik met een compatibel\n                zonnepaneel. Dit kan helpen om de batterij gemakkelijker\n                op peil te houden.\n              </p>\n\n              <p>\n                De laadprestatie hangt onder andere af van de hoeveelheid\n                zonlicht, de plaatsing en het energieverbruik van de camera.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 5 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <rect x=\"7\" y=\"2\" width=\"10\" height=\"20\" rx=\"2\"></rect>\n                <path d=\"M10 5h4M11 18h2\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Wat kan ik via de MEARI-app doen?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                Via de app kunt u livebeelden bekijken, meldingen ontvangen,\n                terugspreken via de camera en beschikbare opnames terugkijken.\n              </p>\n\n              <p>\n                U kunt daarnaast instellingen beheren en, waar ondersteund,\n                toegang delen met gezinsleden.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 6 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n                <path d=\"M4 5v5h5\"></path>\n                <path d=\"M9 12h6\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Hoe werken AI-detectie en Auto Tracking?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                AI-persoonsdetectie helpt onderscheid te maken tussen personen\n                en algemene beweging. Daardoor kunnen meldingen relevanter zijn.\n              </p>\n\n              <p>\n                Met Auto Tracking kan de camera een bewegend onderwerp\n                automatisch volgen binnen het beschikbare draaibereik.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 7 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n                <path d=\"M17 3v4M15 5h4\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Geeft de camera ook in het donker kleurbeelden?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                De camera ondersteunt full-color nachtzicht met behulp van\n                ingebouwde verlichting.\n              </p>\n\n              <p>\n                Het uiteindelijke beeld hangt af van de afstand, de omgeving\n                en de beschikbare verlichting rond de camera.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 8 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M6 4h12l2 4v10H4V8l2-4Z\"></path>\n                <path d=\"M8 13h8M12 9v8\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Waar worden de opnames opgeslagen?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                De beschikbare opslagmogelijkheden hangen af van de\n                cameraspecificaties en de instellingen in de MEARI-app.\n              </p>\n\n              <p>\n                Controleer op de productpagina welke lokale opslag en\n                eventuele cloudopties voor deze uitvoering worden ondersteund.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 9 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M7 18a5 5 0 0 1 1-9.9A6 6 0 0 1 19 11a4 4 0 0 1-1 7H7Z\"></path>\n                <path d=\"M9 21h.01M13 21h.01M17 21h.01\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Kan de camera buiten in regen en kou worden gebruikt?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                De MEARI N2 is ontworpen voor gebruik buitenshuis en heeft\n                een weerbestendige behuizing.\n              </p>\n\n              <p>\n                Monteer de camera stevig en volg altijd de meegeleverde\n                plaatsings- en gebruiksinstructies.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n        <!-- FAQ 10 -->\n        <article class=\"sg-meari-faq__item\">\n\n          <button\n            type=\"button\"\n            class=\"sg-meari-faq__question\"\n            aria-expanded=\"false\"\n          >\n\n            <span class=\"sg-meari-faq__question-icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9\"></path>\n                <path d=\"M10 21h4\"></path>\n              </svg>\n            </span>\n\n            <span class=\"sg-meari-faq__question-text\">\n              Ontvang ik direct een melding bij beweging?\n            </span>\n\n            <span class=\"sg-meari-faq__toggle\"></span>\n\n          </button>\n\n          <div class=\"sg-meari-faq__answer-wrap\">\n\n            <div class=\"sg-meari-faq__answer\">\n              <p>\n                Wanneer meldingen zijn ingeschakeld, kan de camera een\n                notificatie naar uw telefoon sturen zodra relevante beweging\n                wordt gedetecteerd.\n              </p>\n\n              <p>\n                De snelheid van de melding is mede afhankelijk van uw\n                internetverbinding, WiFi-signaal en telefooninstellingen.\n              </p>\n            </div>\n\n          </div>\n        </article>\n\n      </div>\n\n    </div>\n\n    </div>\n</section>\n\n<script>\n(function () {\n  function setFaqHeight(item, shouldOpen) {\n    var answerWrap = item.querySelector('.sg-meari-faq__answer-wrap');\n    var question = item.querySelector('.sg-meari-faq__question');\n\n    if (!answerWrap || !question) return;\n\n    if (shouldOpen) {\n      item.classList.add('is-open');\n      question.setAttribute('aria-expanded', 'true');\n      answerWrap.style.maxHeight = answerWrap.scrollHeight + 'px';\n    } else {\n      item.classList.remove('is-open');\n      question.setAttribute('aria-expanded', 'false');\n      answerWrap.style.maxHeight = '0px';\n    }\n  }\n\n  function initializeMeariFaq() {\n    document\n      .querySelectorAll('.sg-meari-faq')\n      .forEach(function (section) {\n        if (section.dataset.initialized === 'true') return;\n\n        section.dataset.initialized = 'true';\n\n        var items = section.querySelectorAll('.sg-meari-faq__item');\n\n        items.forEach(function (item) {\n          var question = item.querySelector('.sg-meari-faq__question');\n\n          if (!question) return;\n\n          setFaqHeight(\n            item,\n            item.classList.contains('is-open')\n          );\n\n          question.addEventListener('click', function () {\n            var isOpen = item.classList.contains('is-open');\n\n            items.forEach(function (otherItem) {\n              setFaqHeight(otherItem, false);\n            });\n\n            if (!isOpen) {\n              setFaqHeight(item, true);\n            }\n          });\n        });\n      });\n  }\n\n  function resizeOpenFaqs() {\n    document\n      .querySelectorAll('.sg-meari-faq__item.is-open')\n      .forEach(function (item) {\n        var answerWrap =\n          item.querySelector('.sg-meari-faq__answer-wrap');\n\n        if (answerWrap) {\n          answerWrap.style.maxHeight =\n            answerWrap.scrollHeight + 'px';\n        }\n      });\n  }\n\n  document.addEventListener(\n    'DOMContentLoaded',\n    initializeMeariFaq\n  );\n\n  document.addEventListener(\n    'shopify:section:load',\n    initializeMeariFaq\n  );\n\n  window.addEventListener(\n    'resize',\n    resizeOpenFaqs\n  );\n\n  initializeMeariFaq();\n})();\n</script>",
        "section_height": "default",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
