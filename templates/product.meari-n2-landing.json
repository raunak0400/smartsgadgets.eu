    "custom_liquid_yQJcwQ": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% liquid\n  assign sg_feature_fallback = product.featured_image\n\n  assign sg_feature_image_1 = sg_feature_fallback\n  assign sg_feature_image_2 = sg_feature_fallback\n  assign sg_feature_image_3 = sg_feature_fallback\n  assign sg_feature_image_4 = sg_feature_fallback\n  assign sg_feature_image_5 = sg_feature_fallback\n  assign sg_feature_image_6 = sg_feature_fallback\n\n  if product.images.size > 1\n    assign sg_feature_image_1 = product.images[1]\n  endif\n\n  if product.images.size > 2\n    assign sg_feature_image_2 = product.images[2]\n  endif\n\n  if product.images.size > 3\n    assign sg_feature_image_3 = product.images[3]\n  endif\n\n  if product.images.size > 4\n    assign sg_feature_image_4 = product.images[4]\n  endif\n\n  if product.images.size > 5\n    assign sg_feature_image_5 = product.images[5]\n  endif\n\n  if product.images.size > 6\n    assign sg_feature_image_6 = product.images[6]\n  endif\n%}\n\n<style>\n/* ==================================================\n   MEARI N2 — FEATURE CARDS\n   Alles wat u nodig heeft\n   ================================================== */\n\n.shopify-section:has(.sg-meari-features),\n.shopify-section:has(.sg-meari-features) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-features) .section,\n.shopify-section:has(.sg-meari-features) .section__inner,\n.shopify-section:has(.sg-meari-features) .container,\n.shopify-section:has(.sg-meari-features) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-features,\n.sg-meari-features * {\n  box-sizing: border-box;\n}\n\n.sg-meari-features {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #43a8ff;\n  --sg-navy: #07172a;\n  --sg-orange: #ff6a13;\n  --sg-text: #142237;\n  --sg-muted: #65758a;\n  --sg-line: #dce8f4;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-text);\n  background:\n    radial-gradient(\n      circle at 10% 10%,\n      rgba(22, 134, 232, 0.08),\n      transparent 28%\n    ),\n    radial-gradient(\n      circle at 90% 90%,\n      rgba(22, 134, 232, 0.07),\n      transparent 28%\n    ),\n    #f7fbff;\n  font-family: inherit;\n}\n\n.sg-meari-features__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1400px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 86px 0 92px;\n}\n\n.sg-meari-features__header {\n  max-width: 790px;\n  margin: 0 auto 46px;\n  text-align: center;\n}\n\n.sg-meari-features__eyebrow {\n  margin: 0 0 13px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-features h2 {\n  margin: 0 0 17px;\n  color: var(--sg-navy);\n  font-size: clamp(39px, 4.8vw, 64px);\n  line-height: 1.04;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-features h2 span {\n  color: var(--sg-blue);\n}\n\n.sg-meari-features__intro {\n  max-width: 720px;\n  margin: 0 auto;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-features__grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 22px;\n}\n\n.sg-meari-features__card {\n  position: relative;\n  min-width: 0;\n  overflow: hidden;\n  border: 1px solid rgba(23, 105, 179, 0.13);\n  border-radius: 22px;\n  background: #ffffff;\n  box-shadow:\n    0 16px 42px rgba(24, 68, 112, 0.09),\n    0 2px 7px rgba(24, 68, 112, 0.04);\n  transition:\n    transform 0.28s ease,\n    box-shadow 0.28s ease,\n    border-color 0.28s ease;\n}\n\n.sg-meari-features__card:hover {\n  transform: translateY(-7px);\n  border-color: rgba(22, 134, 232, 0.30);\n  box-shadow:\n    0 25px 60px rgba(24, 68, 112, 0.15),\n    0 8px 18px rgba(22, 134, 232, 0.06);\n}\n\n.sg-meari-features__media {\n  position: relative;\n  height: 245px;\n  overflow: hidden;\n  background:\n    radial-gradient(\n      circle at 50% 42%,\n      rgba(67, 168, 255, 0.14),\n      transparent 42%\n    ),\n    linear-gradient(145deg, #edf7ff, #f9fcff);\n}\n\n.sg-meari-features__media::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(\n      180deg,\n      transparent 58%,\n      rgba(4, 24, 44, 0.07)\n    );\n}\n\n.sg-meari-features__image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  transition: transform 0.45s ease;\n}\n\n.sg-meari-features__card:hover .sg-meari-features__image {\n  transform: scale(1.045);\n}\n\n.sg-meari-features__badge {\n  position: absolute;\n  z-index: 3;\n  top: 17px;\n  left: 17px;\n  min-height: 34px;\n  padding: 8px 11px;\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  color: #ffffff;\n  border: 1px solid rgba(255,255,255,.20);\n  border-radius: 999px;\n  background: rgba(5, 30, 56, 0.80);\n  box-shadow: 0 9px 25px rgba(0,0,0,.17);\n  backdrop-filter: blur(10px);\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.sg-meari-features__badge-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--sg-blue-light);\n  box-shadow: 0 0 12px rgba(67,168,255,.75);\n}\n\n.sg-meari-features__content {\n  padding: 25px 25px 27px;\n}\n\n.sg-meari-features__title-row {\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n}\n\n.sg-meari-features__icon {\n  width: 44px;\n  height: 44px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue);\n  border: 1px solid rgba(22, 134, 232, 0.17);\n  border-radius: 13px;\n  background: rgba(22, 134, 232, 0.07);\n}\n\n.sg-meari-features__icon svg {\n  width: 24px;\n  height: 24px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-features__card h3 {\n  margin: 0;\n  color: var(--sg-navy);\n  font-size: 21px;\n  line-height: 1.2;\n  font-weight: 820;\n}\n\n.sg-meari-features__card p {\n  margin: 0;\n  color: var(--sg-muted);\n  font-size: 15px;\n  line-height: 1.62;\n}\n\n\n\n@media screen and (max-width: 1080px) {\n  .sg-meari-features__grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media screen and (max-width: 720px) {\n  .sg-meari-features__inner {\n    width: min(100% - 28px, 680px);\n    padding: 66px 0 70px;\n  }\n\n  .sg-meari-features__header {\n    margin-bottom: 35px;\n  }\n\n  .sg-meari-features__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-features__media {\n    height: 220px;\n  }\n}\n\n@media screen and (max-width: 540px) {\n  .sg-meari-features__inner {\n    width: calc(100% - 24px);\n    padding: 54px 0 58px;\n  }\n\n  .sg-meari-features h2 {\n    font-size: 37px;\n  }\n\n  .sg-meari-features__grid {\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n\n  .sg-meari-features__media {\n    height: 220px;\n  }\n\n  .sg-meari-features__content {\n    padding: 22px;\n  }\n\n  \n}\n</style>\n\n<section class=\"sg-meari-features\">\n  <div class=\"sg-meari-features__inner\">\n\n    <div class=\"sg-meari-features__header\">\n\n      <div class=\"sg-meari-features__eyebrow\">\n        Complete bescherming\n      </div>\n\n      <h2>\n        Alles wat u\n        <span>nodig heeft.</span>\n      </h2>\n\n      <p class=\"sg-meari-features__intro\">\n        Zes slimme functies werken samen om uw woning, tuin en oprit\n        dag en nacht beter te beveiligen.\n      </p>\n\n    </div>\n\n    <div class=\"sg-meari-features__grid\">\n\n      <!-- Card 1 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_1 %}\n            {{\n              sg_feature_image_1\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 AI-persoonsdetectie'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Slimme AI\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <circle cx=\"12\" cy=\"7\" r=\"3\"></circle>\n                <path d=\"M6 20c.9-4.2 3-6.3 6-6.3S17.1 15.8 18 20\"></path>\n                <path d=\"M3 8V4h4M21 8V4h-4\"></path>\n              </svg>\n            </div>\n\n            <h3>AI-persoonsdetectie</h3>\n\n          </div>\n\n          <p>\n            Ontvang gerichtere meldingen wanneer de camera een persoon\n            bij uw woning of oprit detecteert.\n          </p>\n\n        </div>\n      </article>\n\n      <!-- Card 2 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_2 %}\n            {{\n              sg_feature_image_2\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 automatische tracking'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Automatisch volgen\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n                <path d=\"M4 5v5h5\"></path>\n                <path d=\"M9 12h6\"></path>\n              </svg>\n            </div>\n\n            <h3>Auto Tracking</h3>\n\n          </div>\n\n          <p>\n            Bewegende personen blijven automatisch beter in beeld,\n            zodat u belangrijke momenten niet mist.\n          </p>\n\n        </div>\n      </article>\n\n      <!-- Card 3 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_3 %}\n            {{\n              sg_feature_image_3\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 355 graden pan en 90 graden tilt'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Brede dekking\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n                <path d=\"M4 5v5h5\"></path>\n                <path d=\"M12 7v10\"></path>\n              </svg>\n            </div>\n\n            <h3>355° Pan & 90° Tilt</h3>\n\n          </div>\n\n          <p>\n            Bedien de camera via de app en bekijk een groot deel van\n            uw tuin, entree of oprit vanuit één positie.\n          </p>\n\n        </div>\n      </article>\n\n      <!-- Card 4 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_4 %}\n            {{\n              sg_feature_image_4\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 full-color nachtzicht'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Dag en nacht\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n                <path d=\"M17 3v4M15 5h4\"></path>\n              </svg>\n            </div>\n\n            <h3>Full-color nachtzicht</h3>\n\n          </div>\n\n          <p>\n            Bekijk heldere beelden in donkere situaties dankzij\n            ingebouwde verlichting en kleurennachtzicht.\n          </p>\n\n        </div>\n      </article>\n\n      <!-- Card 5 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_5 %}\n            {{\n              sg_feature_image_5\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 tweeweg audio'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Luisteren en spreken\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"></rect>\n                <path d=\"M5 10a7 7 0 0 0 14 0M12 17v4M9 21h6\"></path>\n              </svg>\n            </div>\n\n            <h3>Tweeweg audio</h3>\n\n          </div>\n\n          <p>\n            Luister mee en praat rechtstreeks met bezoekers via\n            de ingebouwde microfoon, speaker en mobiele app.\n          </p>\n\n        </div>\n      </article>\n\n      <!-- Card 6 -->\n      <article class=\"sg-meari-features__card\">\n\n        <div class=\"sg-meari-features__media\">\n\n          {% if sg_feature_image_6 %}\n            {{\n              sg_feature_image_6\n              | image_url: width: 900\n              | image_tag:\n                class: 'sg-meari-features__image',\n                loading: 'lazy',\n                widths: '360, 540, 720, 900',\n                sizes: '(max-width: 540px) 100vw, (max-width: 1080px) 50vw, 33vw',\n                alt: 'MEARI N2 zonnepaneel ondersteuning'\n            }}\n          {% endif %}\n\n          <div class=\"sg-meari-features__badge\">\n            <span class=\"sg-meari-features__badge-dot\"></span>\n            Minder opladen\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-features__content\">\n\n          <div class=\"sg-meari-features__title-row\">\n\n            <div class=\"sg-meari-features__icon\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M5 10h14l-1 9H6l-1-9Z\"></path>\n                <path d=\"M8 10l1-5h6l1 5\"></path>\n                <path d=\"M12 2v2M4.5 4.5 6 6M19.5 4.5 18 6\"></path>\n              </svg>\n            </div>\n\n            <h3>Solar support</h3>\n\n          </div>\n\n          <p>\n            Gebruik de camera met een compatibel zonnepaneel om\n            de batterij eenvoudiger op peil te houden.\n          </p>\n\n        </div>\n      </article>\n\n    </div>\n\n    \n</section>",
        "section_height": "default",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
