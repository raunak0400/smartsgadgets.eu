    "custom_liquid_CUgQHh": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   MEARI N2 — INSTALLATION + COMPARISON\n   ================================================== */\n\n.shopify-section:has(.sg-meari-install),\n.shopify-section:has(.sg-meari-install) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-install) .section,\n.shopify-section:has(.sg-meari-install) .section__inner,\n.shopify-section:has(.sg-meari-install) .container,\n.shopify-section:has(.sg-meari-install) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-install,\n.sg-meari-install * {\n  box-sizing: border-box;\n}\n\n.sg-meari-install {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #43a8ff;\n  --sg-navy: #07172a;\n  --sg-orange: #ff6a13;\n  --sg-text: #142237;\n  --sg-muted: #65758a;\n  --sg-border: #dce8f4;\n  --sg-soft: #f4f9fe;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-text);\n  background:\n    radial-gradient(\n      circle at 5% 15%,\n      rgba(22, 134, 232, 0.07),\n      transparent 27%\n    ),\n    radial-gradient(\n      circle at 95% 85%,\n      rgba(22, 134, 232, 0.06),\n      transparent 28%\n    ),\n    #ffffff;\n  font-family: inherit;\n}\n\n.sg-meari-install__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1400px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 88px 0 94px;\n}\n\n.sg-meari-install__header {\n  max-width: 780px;\n  margin: 0 auto 48px;\n  text-align: center;\n}\n\n.sg-meari-install__eyebrow {\n  margin: 0 0 13px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-install h2 {\n  margin: 0 0 17px;\n  color: var(--sg-navy);\n  font-size: clamp(39px, 4.8vw, 64px);\n  line-height: 1.04;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-install h2 span {\n  color: var(--sg-blue);\n}\n\n.sg-meari-install__intro {\n  max-width: 720px;\n  margin: 0 auto;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-install__layout {\n  display: grid;\n  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);\n  gap: 26px;\n  align-items: stretch;\n}\n\n.sg-meari-install__panel {\n  position: relative;\n  overflow: hidden;\n  padding: 34px;\n  border: 1px solid rgba(23, 105, 179, 0.13);\n  border-radius: 24px;\n  background: #ffffff;\n  box-shadow:\n    0 18px 48px rgba(24, 68, 112, 0.09),\n    0 3px 8px rgba(24, 68, 112, 0.04);\n}\n\n.sg-meari-install__panel--steps {\n  background:\n    radial-gradient(\n      circle at 85% 12%,\n      rgba(67, 168, 255, 0.12),\n      transparent 30%\n    ),\n    linear-gradient(145deg, #f8fcff, #eef7ff);\n}\n\n.sg-meari-install__panel--compare {\n  background:\n    radial-gradient(\n      circle at 90% 15%,\n      rgba(22, 134, 232, 0.08),\n      transparent 28%\n    ),\n    #ffffff;\n}\n\n.sg-meari-install__panel-header {\n  margin-bottom: 28px;\n}\n\n.sg-meari-install__panel-kicker {\n  margin-bottom: 9px;\n  color: var(--sg-blue);\n  font-size: 12px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.sg-meari-install__panel h3 {\n  margin: 0 0 10px;\n  color: var(--sg-navy);\n  font-size: 30px;\n  line-height: 1.12;\n  letter-spacing: -0.03em;\n  font-weight: 830;\n}\n\n.sg-meari-install__panel-description {\n  margin: 0;\n  color: var(--sg-muted);\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.sg-meari-install__steps {\n  position: relative;\n  display: grid;\n  gap: 16px;\n}\n\n.sg-meari-install__step {\n  position: relative;\n  display: grid;\n  grid-template-columns: 54px minmax(0, 1fr);\n  gap: 16px;\n  align-items: center;\n  min-height: 92px;\n  padding: 16px 18px;\n  border: 1px solid rgba(22, 134, 232, 0.12);\n  border-radius: 17px;\n  background: rgba(255, 255, 255, 0.78);\n  box-shadow: 0 10px 28px rgba(24, 68, 112, 0.06);\n  transition:\n    transform 0.22s ease,\n    border-color 0.22s ease,\n    box-shadow 0.22s ease;\n}\n\n.sg-meari-install__step:hover {\n  transform: translateX(5px);\n  border-color: rgba(22, 134, 232, 0.28);\n  box-shadow: 0 14px 34px rgba(24, 68, 112, 0.10);\n}\n\n.sg-meari-install__step-number {\n  width: 54px;\n  height: 54px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #ffffff;\n  border-radius: 16px;\n  background:\n    linear-gradient(\n      135deg,\n      var(--sg-blue-light),\n      var(--sg-blue)\n    );\n  box-shadow: 0 12px 26px rgba(22, 134, 232, 0.24);\n  font-size: 19px;\n  line-height: 1;\n  font-weight: 850;\n}\n\n.sg-meari-install__step strong {\n  display: block;\n  margin-bottom: 4px;\n  color: var(--sg-navy);\n  font-size: 17px;\n  line-height: 1.25;\n  font-weight: 820;\n}\n\n.sg-meari-install__step span {\n  display: block;\n  color: var(--sg-muted);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.sg-meari-install__table-wrap {\n  overflow: hidden;\n  border: 1px solid var(--sg-border);\n  border-radius: 18px;\n  background: #ffffff;\n}\n\n.sg-meari-install__table-head,\n.sg-meari-install__row {\n  display: grid;\n  grid-template-columns: 1.15fr 0.9fr 0.9fr;\n  align-items: center;\n}\n\n.sg-meari-install__table-head {\n  min-height: 64px;\n  color: #ffffff;\n  background:\n    linear-gradient(\n      135deg,\n      #0b5eb5,\n      var(--sg-blue)\n    );\n}\n\n.sg-meari-install__table-head > div,\n.sg-meari-install__row > div {\n  padding: 15px 16px;\n}\n\n.sg-meari-install__table-head > div {\n  font-size: 14px;\n  line-height: 1.3;\n  font-weight: 800;\n}\n\n.sg-meari-install__table-head > div:nth-child(2),\n.sg-meari-install__table-head > div:nth-child(3),\n.sg-meari-install__row > div:nth-child(2),\n.sg-meari-install__row > div:nth-child(3) {\n  text-align: center;\n}\n\n.sg-meari-install__row {\n  min-height: 67px;\n  border-top: 1px solid var(--sg-border);\n}\n\n.sg-meari-install__row:nth-child(odd) {\n  background: #fbfdff;\n}\n\n.sg-meari-install__row-label {\n  color: var(--sg-navy);\n  font-size: 14px;\n  line-height: 1.4;\n  font-weight: 750;\n}\n\n.sg-meari-install__check,\n.sg-meari-install__cross {\n  width: 30px;\n  height: 30px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  font-size: 16px;\n  font-weight: 900;\n}\n\n.sg-meari-install__check {\n  color: #087b43;\n  background: #dcf8e9;\n  border: 1px solid #b8ebcf;\n}\n\n.sg-meari-install__cross {\n  color: #b53c3c;\n  background: #fff0f0;\n  border: 1px solid #f3cccc;\n}\n\n.sg-meari-install__note {\n  margin-top: 18px;\n  padding: 15px 16px;\n  display: flex;\n  align-items: flex-start;\n  gap: 11px;\n  color: #38506a;\n  border: 1px solid rgba(22, 134, 232, 0.13);\n  border-radius: 14px;\n  background: var(--sg-soft);\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.sg-meari-install__note-icon {\n  width: 28px;\n  height: 28px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue);\n  border-radius: 9px;\n  background: rgba(22, 134, 232, 0.10);\n}\n\n.sg-meari-install__note-icon svg {\n  width: 17px;\n  height: 17px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n@media screen and (max-width: 980px) {\n  .sg-meari-install__layout {\n    grid-template-columns: 1fr;\n  }\n\n  .sg-meari-install__panel {\n    padding: 30px;\n  }\n}\n\n@media screen and (max-width: 680px) {\n  .sg-meari-install__inner {\n    width: min(100% - 28px, 680px);\n    padding: 66px 0 70px;\n  }\n\n  .sg-meari-install__header {\n    margin-bottom: 35px;\n  }\n\n  .sg-meari-install__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-install__panel {\n    padding: 24px;\n    border-radius: 20px;\n  }\n\n  .sg-meari-install__panel h3 {\n    font-size: 27px;\n  }\n\n  .sg-meari-install__table-head,\n  .sg-meari-install__row {\n    grid-template-columns: 1.25fr 0.75fr 0.75fr;\n  }\n\n  .sg-meari-install__table-head > div,\n  .sg-meari-install__row > div {\n    padding: 13px 10px;\n  }\n\n  .sg-meari-install__table-head > div {\n    font-size: 12px;\n  }\n\n  .sg-meari-install__row-label {\n    font-size: 13px;\n  }\n}\n\n@media screen and (max-width: 480px) {\n  .sg-meari-install__inner {\n    width: calc(100% - 24px);\n    padding: 54px 0 58px;\n  }\n\n  .sg-meari-install h2 {\n    font-size: 37px;\n  }\n\n  .sg-meari-install__panel {\n    padding: 20px;\n  }\n\n  .sg-meari-install__step {\n    grid-template-columns: 46px minmax(0, 1fr);\n    gap: 13px;\n    padding: 14px;\n  }\n\n  .sg-meari-install__step-number {\n    width: 46px;\n    height: 46px;\n    border-radius: 13px;\n    font-size: 17px;\n  }\n\n  .sg-meari-install__table-head,\n  .sg-meari-install__row {\n    grid-template-columns: 1.2fr 0.8fr 0.8fr;\n  }\n\n  .sg-meari-install__check,\n  .sg-meari-install__cross {\n    width: 26px;\n    height: 26px;\n    font-size: 14px;\n  }\n\n  \n}\n</style>\n\n<section class=\"sg-meari-install\">\n  <div class=\"sg-meari-install__inner\">\n\n    <div class=\"sg-meari-install__header\">\n\n      <div class=\"sg-meari-install__eyebrow\">\n        Snel en eenvoudig\n      </div>\n\n      <h2>\n        Binnen enkele minuten\n        <span>klaar voor gebruik.</span>\n      </h2>\n\n      <p class=\"sg-meari-install__intro\">\n        Geen ingewikkelde installatie of vaste bedrading. Monteer de camera,\n        verbind hem met WiFi en beheer alles eenvoudig via de MEARI-app.\n      </p>\n\n    </div>\n\n    <div class=\"sg-meari-install__layout\">\n\n      <div class=\"sg-meari-install__panel sg-meari-install__panel--steps\">\n\n        <div class=\"sg-meari-install__panel-header\">\n          <div class=\"sg-meari-install__panel-kicker\">\n            Installatie\n          </div>\n\n          <h3>Eenvoudig in vier stappen</h3>\n\n          <p class=\"sg-meari-install__panel-description\">\n            U heeft geen professionele installateur nodig.\n          </p>\n        </div>\n\n        <div class=\"sg-meari-install__steps\">\n\n          <div class=\"sg-meari-install__step\">\n            <div class=\"sg-meari-install__step-number\">1</div>\n            <div>\n              <strong>Laad de camera op</strong>\n              <span>\n                Laad de ingebouwde batterij volledig op vóór de installatie.\n              </span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__step\">\n            <div class=\"sg-meari-install__step-number\">2</div>\n            <div>\n              <strong>Monteer de camera</strong>\n              <span>\n                Bevestig de camera bij uw entree, tuin, garage of oprit.\n              </span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__step\">\n            <div class=\"sg-meari-install__step-number\">3</div>\n            <div>\n              <strong>Verbind met WiFi</strong>\n              <span>\n                Voeg de MEARI N2 toe via de app en maak verbinding met uw netwerk.\n              </span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__step\">\n            <div class=\"sg-meari-install__step-number\">4</div>\n            <div>\n              <strong>Start met beveiligen</strong>\n              <span>\n                Bekijk livebeelden, ontvang meldingen en pas uw instellingen aan.\n              </span>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      <div class=\"sg-meari-install__panel sg-meari-install__panel--compare\">\n\n        <div class=\"sg-meari-install__panel-header\">\n          <div class=\"sg-meari-install__panel-kicker\">\n            Vergelijk het verschil\n          </div>\n\n          <h3>Waarom kiezen voor MEARI N2?</h3>\n\n          <p class=\"sg-meari-install__panel-description\">\n            Meer flexibiliteit en slimme beveiliging dan bij een gewone camera.\n          </p>\n        </div>\n\n        <div class=\"sg-meari-install__table-wrap\">\n\n          <div class=\"sg-meari-install__table-head\">\n            <div>Functie</div>\n            <div>MEARI N2</div>\n            <div>Gewone camera</div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              Oplaadbare batterij\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              Ondersteuning voor zonnepaneel\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              AI-persoonsdetectie\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              Automatische tracking\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              355° pan en 90° tilt\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              Full-color nachtzicht\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n          <div class=\"sg-meari-install__row\">\n            <div class=\"sg-meari-install__row-label\">\n              Tweeweg audio\n            </div>\n            <div>\n              <span class=\"sg-meari-install__check\">✓</span>\n            </div>\n            <div>\n              <span class=\"sg-meari-install__cross\">×</span>\n            </div>\n          </div>\n\n        </div>\n\n        <div class=\"sg-meari-install__note\">\n\n          <div class=\"sg-meari-install__note-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"></circle>\n              <path d=\"M12 10v6M12 7h.01\"></path>\n            </svg>\n          </div>\n\n          <div>\n            Functies van standaardcamera’s kunnen per merk en model verschillen.\n            Deze vergelijking toont het algemene verschil met eenvoudige,\n            niet-slimme beveiligingscamera’s.\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    </div>\n</section>",
