    "custom_liquid_NJgLqc": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "{% assign sg_story_image = \"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_21_2026_11_10_04_AM.png?v=1784625017\" %}\n\n<style>\n/* ==================================================\n   MEARI N2 — LIGHT PRODUCT STORY SECTION\n   ================================================== */\n\n.shopify-section:has(.sg-meari-story),\n.shopify-section:has(.sg-meari-story) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-story) .section,\n.shopify-section:has(.sg-meari-story) .section__inner,\n.shopify-section:has(.sg-meari-story) .container,\n.shopify-section:has(.sg-meari-story) .page-width {\n  margin: 0 !important;\n  padding: 0 !important;\n  max-width: none !important;\n}\n\n.sg-meari-story,\n.sg-meari-story * {\n  box-sizing: border-box;\n}\n\n.sg-meari-story {\n  --sg-blue: #1686e8;\n  --sg-blue-dark: #0b5eb5;\n  --sg-orange: #ff6a13;\n  --sg-navy: #07172a;\n  --sg-text: #142237;\n  --sg-muted: #586b82;\n\n  position: relative;\n  width: 100%;\n  margin: 0 !important;\n  overflow: hidden;\n  color: var(--sg-text);\n  background:\n    radial-gradient(\n      circle at 85% 30%,\n      rgba(49, 157, 255, 0.16),\n      transparent 32%\n    ),\n    linear-gradient(\n      120deg,\n      #e8f4ff 0%,\n      #f7fbff 54%,\n      #eaf5ff 100%\n    );\n  font-family: inherit;\n}\n\n.sg-meari-story::before {\n  content: \"\";\n  position: absolute;\n  top: -180px;\n  right: -160px;\n  width: 520px;\n  height: 520px;\n  border-radius: 50%;\n  border: 1px solid rgba(22, 134, 232, 0.12);\n  pointer-events: none;\n}\n\n.sg-meari-story__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1380px, calc(100% - 48px));\n  min-height: 610px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: minmax(420px, 0.95fr) minmax(0, 1.05fr);\n  align-items: center;\n  gap: 72px;\n  padding: 74px 0;\n}\n\n.sg-meari-story__visual {\n  position: relative;\n  min-height: 470px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.sg-meari-story__visual::before {\n  content: \"\";\n  position: absolute;\n  width: 430px;\n  height: 430px;\n  border-radius: 50%;\n  background:\n    radial-gradient(\n      circle,\n      rgba(41, 151, 255, 0.22) 0%,\n      rgba(41, 151, 255, 0.08) 45%,\n      transparent 72%\n    );\n}\n\n.sg-meari-story__visual::after {\n  content: \"\";\n  position: absolute;\n  left: 8%;\n  right: 8%;\n  bottom: 28px;\n  height: 54px;\n  border-radius: 50%;\n  background: rgba(10, 54, 98, 0.16);\n  filter: blur(22px);\n}\n\n.sg-meari-story__image {\n  position: relative;\n  z-index: 2;\n  display: block;\n  width: 100%;\n  max-width: 570px;\n  max-height: 500px;\n  object-fit: contain;\n  filter: drop-shadow(0 28px 28px rgba(22, 56, 91, 0.22));\n}\n\n.sg-meari-story__content {\n  max-width: 700px;\n}\n\n.sg-meari-story__eyebrow {\n  margin: 0 0 14px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 850;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-story h2 {\n  margin: 0 0 22px;\n  color: var(--sg-navy);\n  font-size: clamp(40px, 4.7vw, 66px);\n  line-height: 1.03;\n  letter-spacing: -0.045em;\n  font-weight: 850;\n}\n\n.sg-meari-story h2 span {\n  display: block;\n  color: var(--sg-blue);\n}\n\n.sg-meari-story__description {\n  max-width: 680px;\n  margin: 0 0 34px;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-story__divider {\n  width: 100%;\n  height: 1px;\n  margin-bottom: 30px;\n  background:\n    linear-gradient(\n      90deg,\n      rgba(22, 134, 232, 0.30),\n      rgba(22, 134, 232, 0.06)\n    );\n}\n\n.sg-meari-story__specs {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 18px;\n}\n\n.sg-meari-story__spec {\n  min-width: 0;\n}\n\n.sg-meari-story__icon {\n  width: 46px;\n  height: 46px;\n  margin-bottom: 13px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue);\n  border: 1px solid rgba(22, 134, 232, 0.18);\n  border-radius: 14px;\n  background: rgba(255, 255, 255, 0.72);\n  box-shadow: 0 10px 26px rgba(33, 102, 166, 0.08);\n}\n\n.sg-meari-story__icon svg {\n  width: 25px;\n  height: 25px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-story__spec strong {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--sg-navy);\n  font-size: 15px;\n  line-height: 1.25;\n  font-weight: 800;\n}\n\n.sg-meari-story__spec span {\n  display: block;\n  color: var(--sg-muted);\n  font-size: 13px;\n  line-height: 1.45;\n}\n\n@media screen and (max-width: 1050px) {\n  .sg-meari-story__inner {\n    grid-template-columns: 0.85fr 1.15fr;\n    gap: 38px;\n  }\n\n  .sg-meari-story__specs {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 24px;\n  }\n}\n\n@media screen and (max-width: 780px) {\n  .sg-meari-story__inner {\n    width: min(100% - 28px, 680px);\n    min-height: auto;\n    grid-template-columns: 1fr;\n    gap: 20px;\n    padding: 58px 0;\n  }\n\n  .sg-meari-story__visual {\n    min-height: 390px;\n  }\n\n  .sg-meari-story__image {\n    max-height: 390px;\n  }\n\n  .sg-meari-story__content {\n    max-width: none;\n    text-align: center;\n  }\n\n  .sg-meari-story__description {\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .sg-meari-story__specs {\n    text-align: left;\n  }\n}\n\n@media screen and (max-width: 520px) {\n  .sg-meari-story__inner {\n    width: calc(100% - 24px);\n    padding: 46px 0;\n  }\n\n  .sg-meari-story__visual {\n    min-height: 300px;\n  }\n\n  .sg-meari-story__image {\n    max-height: 300px;\n  }\n\n  .sg-meari-story h2 {\n    font-size: 38px;\n  }\n\n  .sg-meari-story__description {\n    font-size: 16px;\n  }\n\n  .sg-meari-story__specs {\n    grid-template-columns: 1fr 1fr;\n    gap: 22px 14px;\n  }\n\n  .sg-meari-story__icon {\n    width: 42px;\n    height: 42px;\n  }\n}\n</style>\n\n<section class=\"sg-meari-story\">\n  <div class=\"sg-meari-story__inner\">\n\n    <div class=\"sg-meari-story__visual\">\n      {% if sg_story_image != blank %}\n        <img\n          src=\"{{ sg_story_image }}\"\n          alt=\"MEARI N2 Outdoor AI Beveiligingscamera\"\n          class=\"sg-meari-story__image\"\n          loading=\"lazy\"\n          width=\"1300\"\n          height=\"1000\"\n        >\n      {% endif %}\n    </div>\n\n    <div class=\"sg-meari-story__content\">\n\n      <div class=\"sg-meari-story__eyebrow\">\n        Slimme beveiliging voor iedere woning\n      </div>\n\n      <h2>\n        Slimme beveiliging,\n        <span>complete gemoedsrust.</span>\n      </h2>\n\n      <p class=\"sg-meari-story__description\">\n        De MEARI N2 combineert slimme AI-technologie met draadloos gemak.\n        Ontvang meldingen bij beweging, bekijk livebeelden via de app en houd\n        dag en nacht controle over uw woning, tuin of oprit.\n      </p>\n\n      <div class=\"sg-meari-story__divider\"></div>\n\n      <div class=\"sg-meari-story__specs\">\n\n        <div class=\"sg-meari-story__spec\">\n          <div class=\"sg-meari-story__icon\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M7 18a5 5 0 1 1 1-9.9A6 6 0 0 1 19 11a4 4 0 0 1-1 7H7Z\"></path>\n              <path d=\"m8 21 1-2m3 2 1-2m3 2 1-2\"></path>\n            </svg>\n          </div>\n          <strong>IP65</strong>\n          <span>Weerbestendig ontwerp</span>\n        </div>\n\n        <div class=\"sg-meari-story__spec\">\n          <div class=\"sg-meari-story__icon\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M4 9a12 12 0 0 1 16 0\"></path>\n              <path d=\"M7 12a8 8 0 0 1 10 0\"></path>\n              <path d=\"M10 15a4 4 0 0 1 4 0\"></path>\n              <circle cx=\"12\" cy=\"19\" r=\"1\"></circle>\n            </svg>\n          </div>\n          <strong>Draadloos</strong>\n          <span>Eenvoudige WiFi-verbinding</span>\n        </div>\n\n        <div class=\"sg-meari-story__spec\">\n          <div class=\"sg-meari-story__icon\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <rect x=\"5\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect>\n              <path d=\"M19 10h2v4h-2M9 10v4m3-4v4m3-4v4\"></path>\n            </svg>\n          </div>\n          <strong>5200mAh</strong>\n          <span>Oplaadbare batterij</span>\n        </div>\n\n        <div class=\"sg-meari-story__spec\">\n          <div class=\"sg-meari-story__icon\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M7 18a5 5 0 1 1 1-9.9A6 6 0 0 1 19 11a4 4 0 0 1-1 7H7Z\"></path>\n              <path d=\"M9 14h6M12 11v6\"></path>\n            </svg>\n          </div>\n          <strong>Flexibele opslag</strong>\n          <span>Cloud en microSD-kaart</span>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</section>",
