    "custom_liquid_bUg4tN": {
      "type": "custom-liquid",
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   SMARTGADGETS — MEARI N2 CINEMATIC HERO\n   No price · No buttons · Premium editorial design\n   ========================================================= */\n\n.shopify-section:has(.sg-meari-hero),\n.shopify-section:has(.sg-meari-hero) > div,\n.shopify-section:has(.sg-meari-hero) .section,\n.shopify-section:has(.sg-meari-hero) .section__inner,\n.shopify-section:has(.sg-meari-hero) .container,\n.shopify-section:has(.sg-meari-hero) .page-width {\n  width: 100% !important;\n  max-width: none !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sg-meari-hero,\n.sg-meari-hero * {\n  box-sizing: border-box;\n}\n\n.sg-meari-hero {\n  --sg-blue: #2297f3;\n  --sg-blue-light: #73c5ff;\n  --sg-dark: #031426;\n  --sg-dark-soft: #071f37;\n  --sg-white: #ffffff;\n  --sg-muted: #b8cadb;\n  --sg-line: rgba(255, 255, 255, 0.13);\n\n  position: relative;\n  width: 100%;\n  min-height: 820px;\n  overflow: hidden;\n  color: var(--sg-white);\n  background: var(--sg-dark);\n  font-family: inherit;\n}\n\n/* Background image */\n\n.sg-meari-hero__media {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.sg-meari-hero__image {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  object-position: center;\n  transform: scale(1.01);\n  animation: sgHeroZoom 14s ease-in-out infinite alternate;\n}\n\n@keyframes sgHeroZoom {\n  from {\n    transform: scale(1.01);\n  }\n\n  to {\n    transform: scale(1.055);\n  }\n}\n\n/* Overlay for text readability */\n\n.sg-meari-hero__overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  background:\n    linear-gradient(\n      90deg,\n      rgba(2, 15, 29, 0.97) 0%,\n      rgba(2, 15, 29, 0.91) 27%,\n      rgba(2, 15, 29, 0.70) 45%,\n      rgba(2, 15, 29, 0.21) 70%,\n      rgba(2, 15, 29, 0.08) 100%\n    ),\n    linear-gradient(\n      180deg,\n      rgba(2, 13, 25, 0.19) 0%,\n      transparent 46%,\n      rgba(2, 13, 25, 0.53) 100%\n    );\n}\n\n.sg-meari-hero__overlay::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  opacity: 0.17;\n  background-image:\n    linear-gradient(\n      rgba(255, 255, 255, 0.025) 1px,\n      transparent 1px\n    ),\n    linear-gradient(\n      90deg,\n      rgba(255, 255, 255, 0.025) 1px,\n      transparent 1px\n    );\n  background-size: 72px 72px;\n  mask-image:\n    linear-gradient(\n      90deg,\n      #000 0%,\n      transparent 76%\n    );\n}\n\n/* Decorative glow */\n\n.sg-meari-hero__glow {\n  position: absolute;\n  z-index: 2;\n  top: -260px;\n  left: -240px;\n  width: 620px;\n  height: 620px;\n  border: 1px solid rgba(76, 178, 255, 0.10);\n  border-radius: 50%;\n  box-shadow:\n    0 0 0 82px rgba(76, 178, 255, 0.023),\n    0 0 0 164px rgba(76, 178, 255, 0.013);\n  pointer-events: none;\n}\n\n/* Main layout */\n\n.sg-meari-hero__inner {\n  position: relative;\n  z-index: 5;\n  width: min(1500px, calc(100% - 64px));\n  min-height: 820px;\n  margin: 0 auto;\n  padding: 82px 0 74px;\n  display: flex;\n  align-items: center;\n}\n\n.sg-meari-hero__content {\n  width: min(100%, 770px);\n}\n\n/* Eyebrow */\n\n.sg-meari-hero__eyebrow {\n  margin: 0 0 26px;\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  color: #8bcfff;\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 820;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n}\n\n.sg-meari-hero__eyebrow-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--sg-blue);\n  box-shadow:\n    0 0 0 6px rgba(34, 151, 243, 0.10),\n    0 0 20px rgba(34, 151, 243, 0.65);\n}\n\n/* Heading */\n\n.sg-meari-hero h1 {\n  max-width: 790px;\n  margin: 0 0 26px;\n  color: #ffffff;\n  font-size: clamp(58px, 6vw, 94px);\n  line-height: 0.96;\n  letter-spacing: -0.062em;\n  font-weight: 880;\n  text-wrap: balance;\n}\n\n.sg-meari-hero h1 span {\n  display: block;\n  margin-top: 10px;\n  color: var(--sg-blue);\n}\n\n/* Intro */\n\n.sg-meari-hero__intro {\n  max-width: 650px;\n  margin: 0 0 35px;\n  color: var(--sg-muted);\n  font-size: 19px;\n  line-height: 1.7;\n}\n\n/* Premium glass panel */\n\n.sg-meari-hero__glass {\n  width: min(100%, 760px);\n  padding: 27px 26px;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0;\n  border: 1px solid rgba(122, 200, 255, 0.19);\n  border-radius: 20px;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(4, 23, 42, 0.78),\n      rgba(4, 23, 42, 0.54)\n    );\n  box-shadow:\n    0 22px 55px rgba(0, 0, 0, 0.25),\n    inset 0 1px 0 rgba(255, 255, 255, 0.08);\n  backdrop-filter: blur(16px);\n}\n\n.sg-meari-hero__feature {\n  min-width: 0;\n  padding: 0 22px;\n}\n\n.sg-meari-hero__feature:first-child {\n  padding-left: 0;\n}\n\n.sg-meari-hero__feature:last-child {\n  padding-right: 0;\n}\n\n.sg-meari-hero__feature + .sg-meari-hero__feature {\n  border-left: 1px solid rgba(255, 255, 255, 0.13);\n}\n\n.sg-meari-hero__feature-icon {\n  width: 46px;\n  height: 46px;\n  margin-bottom: 17px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue-light);\n  border: 1px solid rgba(83, 181, 255, 0.23);\n  border-radius: 14px;\n  background: rgba(34, 151, 243, 0.11);\n}\n\n.sg-meari-hero__feature-icon svg {\n  width: 24px;\n  height: 24px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-hero__feature strong {\n  display: block;\n  margin-bottom: 8px;\n  color: #ffffff;\n  font-size: 16px;\n  line-height: 1.3;\n  font-weight: 820;\n}\n\n.sg-meari-hero__feature p {\n  margin: 0;\n  color: #9bb0c3;\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n/* Bottom technical highlights */\n\n.sg-meari-hero__highlights {\n  margin-top: 28px;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 15px 27px;\n}\n\n.sg-meari-hero__highlight {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  color: #b9cbdb;\n  font-size: 12px;\n  line-height: 1.4;\n  font-weight: 680;\n}\n\n.sg-meari-hero__highlight + .sg-meari-hero__highlight {\n  padding-left: 25px;\n  border-left: 1px solid rgba(255, 255, 255, 0.15);\n}\n\n.sg-meari-hero__highlight-icon {\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--sg-blue-light);\n  border-radius: 9px;\n  background: rgba(34, 151, 243, 0.10);\n}\n\n.sg-meari-hero__highlight-icon svg {\n  width: 17px;\n  height: 17px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.9;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Live indicator */\n\n.sg-meari-hero__live {\n  position: absolute;\n  z-index: 6;\n  right: 5%;\n  bottom: 48px;\n  padding: 13px 17px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid rgba(115, 198, 255, 0.22);\n  border-radius: 999px;\n  background: rgba(3, 20, 37, 0.72);\n  box-shadow:\n    0 16px 38px rgba(0, 0, 0, 0.24);\n  backdrop-filter: blur(13px);\n}\n\n.sg-meari-hero__live-dot {\n  position: relative;\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: #42d994;\n}\n\n.sg-meari-hero__live-dot::before {\n  content: \"\";\n  position: absolute;\n  inset: -6px;\n  border: 1px solid rgba(66, 217, 148, 0.35);\n  border-radius: 50%;\n  animation: sgLivePulse 2s ease-out infinite;\n}\n\n@keyframes sgLivePulse {\n  0% {\n    transform: scale(0.65);\n    opacity: 1;\n  }\n\n  100% {\n    transform: scale(1.45);\n    opacity: 0;\n  }\n}\n\n.sg-meari-hero__live span {\n  color: #d9e8f4;\n  font-size: 11px;\n  line-height: 1.2;\n  font-weight: 770;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n/* Scroll indicator */\n\n.sg-meari-hero__scroll {\n  position: absolute;\n  z-index: 7;\n  left: 50%;\n  bottom: 22px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: rgba(211, 229, 242, 0.66);\n  font-size: 10px;\n  font-weight: 760;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  transform: translateX(-50%);\n}\n\n.sg-meari-hero__scroll-line {\n  position: relative;\n  width: 46px;\n  height: 1px;\n  overflow: hidden;\n  background: rgba(255, 255, 255, 0.19);\n}\n\n.sg-meari-hero__scroll-line::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: -60%;\n  width: 60%;\n  height: 100%;\n  background: var(--sg-blue-light);\n  animation: sgScrollMove 2.2s ease-in-out infinite;\n}\n\n@keyframes sgScrollMove {\n  from {\n    left: -60%;\n  }\n\n  to {\n    left: 110%;\n  }\n}\n\n/* Entry animations */\n\n.sg-meari-hero__eyebrow,\n.sg-meari-hero h1,\n.sg-meari-hero__intro,\n.sg-meari-hero__glass,\n.sg-meari-hero__highlights {\n  opacity: 0;\n  transform: translateY(25px);\n  animation: sgHeroReveal 0.8s ease forwards;\n}\n\n.sg-meari-hero h1 {\n  animation-delay: 0.10s;\n}\n\n.sg-meari-hero__intro {\n  animation-delay: 0.20s;\n}\n\n.sg-meari-hero__glass {\n  animation-delay: 0.30s;\n}\n\n.sg-meari-hero__highlights {\n  animation-delay: 0.40s;\n}\n\n@keyframes sgHeroReveal {\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Tablet */\n\n@media screen and (max-width: 1050px) {\n  .sg-meari-hero__overlay {\n    background:\n      linear-gradient(\n        90deg,\n        rgba(2, 15, 29, 0.97) 0%,\n        rgba(2, 15, 29, 0.89) 36%,\n        rgba(2, 15, 29, 0.56) 62%,\n        rgba(2, 15, 29, 0.20) 100%\n      ),\n      linear-gradient(\n        180deg,\n        rgba(2, 13, 25, 0.15),\n        rgba(2, 13, 25, 0.49)\n      );\n  }\n\n  .sg-meari-hero__content {\n    width: min(100%, 700px);\n  }\n\n  .sg-meari-hero h1 {\n    font-size: clamp(54px, 7vw, 76px);\n  }\n\n  .sg-meari-hero__live {\n    right: 3%;\n  }\n}\n\n/* Mobile */\n\n@media screen and (max-width: 760px) {\n  .sg-meari-hero {\n    min-height: auto;\n  }\n\n  .sg-meari-hero__media {\n    position: relative;\n    height: 430px;\n  }\n\n  .sg-meari-hero__image {\n    animation: none;\n    object-position: 70% center;\n  }\n\n  .sg-meari-hero__overlay {\n    background:\n      linear-gradient(\n        180deg,\n        rgba(2, 15, 29, 0.10) 0%,\n        rgba(2, 15, 29, 0.17) 50%,\n        rgba(2, 15, 29, 0.95) 100%\n      );\n  }\n\n  .sg-meari-hero__inner {\n    width: min(100% - 30px, 690px);\n    min-height: 0;\n    margin-top: -115px;\n    padding: 0 0 62px;\n    align-items: flex-start;\n  }\n\n  .sg-meari-hero__content {\n    width: 100%;\n    text-align: center;\n  }\n\n  .sg-meari-hero__eyebrow {\n    margin-bottom: 18px;\n    justify-content: center;\n    font-size: 10px;\n  }\n\n  .sg-meari-hero h1 {\n    margin-bottom: 19px;\n    font-size: 48px;\n  }\n\n  .sg-meari-hero__intro {\n    max-width: 600px;\n    margin-right: auto;\n    margin-left: auto;\n    font-size: 16px;\n  }\n\n  .sg-meari-hero__glass {\n    grid-template-columns: 1fr;\n    padding: 8px 21px;\n    text-align: left;\n  }\n\n  .sg-meari-hero__feature {\n    padding: 21px 0;\n  }\n\n  .sg-meari-hero__feature + .sg-meari-hero__feature {\n    border-top: 1px solid rgba(255, 255, 255, 0.13);\n    border-left: 0;\n  }\n\n  .sg-meari-hero__feature-icon {\n    margin-bottom: 13px;\n  }\n\n  .sg-meari-hero__highlights {\n    justify-content: center;\n    gap: 13px;\n  }\n\n  .sg-meari-hero__highlight + .sg-meari-hero__highlight {\n    padding-left: 0;\n    border-left: 0;\n  }\n\n  .sg-meari-hero__live,\n  .sg-meari-hero__scroll {\n    display: none;\n  }\n}\n\n/* Small mobile */\n\n@media screen and (max-width: 480px) {\n  .sg-meari-hero__media {\n    height: 360px;\n  }\n\n  .sg-meari-hero__inner {\n    width: calc(100% - 24px);\n    margin-top: -84px;\n    padding-bottom: 52px;\n  }\n\n  .sg-meari-hero h1 {\n    font-size: 39px;\n  }\n\n  .sg-meari-hero__intro {\n    font-size: 15px;\n  }\n\n  .sg-meari-hero__glass {\n    border-radius: 17px;\n  }\n\n  .sg-meari-hero__highlights {\n    display: grid;\n    grid-template-columns: 1fr;\n    justify-items: center;\n  }\n}\n\n/* Reduced motion */\n\n@media (prefers-reduced-motion: reduce) {\n  .sg-meari-hero__image,\n  .sg-meari-hero__live-dot::before,\n  .sg-meari-hero__scroll-line::after,\n  .sg-meari-hero__eyebrow,\n  .sg-meari-hero h1,\n  .sg-meari-hero__intro,\n  .sg-meari-hero__glass,\n  .sg-meari-hero__highlights {\n    animation: none;\n  }\n\n  .sg-meari-hero__eyebrow,\n  .sg-meari-hero h1,\n  .sg-meari-hero__intro,\n  .sg-meari-hero__glass,\n  .sg-meari-hero__highlights {\n    opacity: 1;\n    transform: none;\n  }\n}\n</style>\n\n<section class=\"sg-meari-hero\">\n\n  <div class=\"sg-meari-hero__media\">\n\n    <img\n      class=\"sg-meari-hero__image\"\n      src=\"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/ChatGPT_Image_Jul_21_2026_10_16_32_AM.png?v=1784621812\"MEARI N2 outdoor AI beveiligingscamera met zonnepaneel bij een moderne woning\"\n      width=\"1920\"\n      height=\"1080\"\n      loading=\"eager\"\n      fetchpriority=\"high\"\n    >\n\n    <div class=\"sg-meari-hero__overlay\"></div>\n\n  </div>\n\n  <div class=\"sg-meari-hero__glow\"></div>\n\n  <div class=\"sg-meari-hero__inner\">\n\n    <div class=\"sg-meari-hero__content\">\n\n      <div class=\"sg-meari-hero__eyebrow\">\n        <span class=\"sg-meari-hero__eyebrow-dot\"></span>\n        MEARI N2 Outdoor AI-beveiligingscamera\n      </div>\n\n      <h1>\n        Slimme beveiliging.\n        <span>Dag en nacht.</span>\n      </h1>\n\n      <p class=\"sg-meari-hero__intro\">\n        De MEARI N2 houdt uw woning, tuin en oprit in de gaten met\n        slimme persoonsdetectie, een draaibaar overzicht en helder\n        full-color nachtzicht.\n      </p>\n\n      <div class=\"sg-meari-hero__glass\">\n\n        <div class=\"sg-meari-hero__feature\">\n\n          <div class=\"sg-meari-hero__feature-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <circle cx=\"12\" cy=\"8\" r=\"3\"></circle>\n              <path d=\"M6 21v-2a6 6 0 0 1 12 0v2\"></path>\n              <path d=\"M4 5V3h3\"></path>\n              <path d=\"M20 5V3h-3\"></path>\n              <path d=\"M4 19v2h3\"></path>\n              <path d=\"M20 19v2h-3\"></path>\n            </svg>\n          </div>\n\n          <strong>Slimme detectie</strong>\n\n          <p>\n            Ontvang direct een melding wanneer beweging of een persoon\n            wordt waargenomen.\n          </p>\n\n        </div>\n\n        <div class=\"sg-meari-hero__feature\">\n\n          <div class=\"sg-meari-hero__feature-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 12a7 7 0 1 0 2-4.9\"></path>\n              <path d=\"M5 5v5h5\"></path>\n              <path d=\"M9 12h6\"></path>\n            </svg>\n          </div>\n\n          <strong>355° PTZ-overzicht</strong>\n\n          <p>\n            Draai en kantel de camera voor een groter overzicht rondom\n            uw woning.\n          </p>\n\n        </div>\n\n        <div class=\"sg-meari-hero__feature\">\n\n          <div class=\"sg-meari-hero__feature-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n              <path d=\"M17 3v4\"></path>\n              <path d=\"M15 5h4\"></path>\n            </svg>\n          </div>\n\n          <strong>Full-color nachtzicht</strong>\n\n          <p>\n            Bekijk scherpe en kleurrijke beelden, ook wanneer het buiten\n            donker is.\n          </p>\n\n        </div>\n\n      </div>\n\n      <div class=\"sg-meari-hero__highlights\">\n\n        <div class=\"sg-meari-hero__highlight\">\n\n          <span class=\"sg-meari-hero__highlight-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <rect x=\"4\" y=\"7\" width=\"15\" height=\"10\" rx=\"2\"></rect>\n              <path d=\"M19 10h2v4h-2\"></path>\n              <path d=\"M8 10v4\"></path>\n              <path d=\"M11 10v4\"></path>\n            </svg>\n          </span>\n\n          Oplaadbare batterij\n        </div>\n\n        <div class=\"sg-meari-hero__highlight\">\n\n          <span class=\"sg-meari-hero__highlight-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M5 10h14l-1 9H6l-1-9Z\"></path>\n              <path d=\"M8 10l1-5h6l1 5\"></path>\n              <path d=\"M12 2v2\"></path>\n            </svg>\n          </span>\n\n          Werkt met zonnepaneel\n        </div>\n\n        <div class=\"sg-meari-hero__highlight\">\n\n          <span class=\"sg-meari-hero__highlight-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M7 18a5 5 0 0 1 1-9.9A6 6 0 0 1 19 11a4 4 0 0 1-1 7H7Z\"></path>\n              <path d=\"M9 21h.01\"></path>\n              <path d=\"M13 21h.01\"></path>\n              <path d=\"M17 21h.01\"></path>\n            </svg>\n          </span>\n\n          IP65 weerbestendig\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n  <div class=\"sg-meari-hero__live\">\n    <span class=\"sg-meari-hero__live-dot\"></span>\n    <span>Beschermt uw woning 24/7</span>\n  </div>\n\n  <div class=\"sg-meari-hero__scroll\">\n    Meer ontdekken\n    <span class=\"sg-meari-hero__scroll-line\"></span>\n  </div>\n\n</section>",
