display:flex;\n  align-items:center;\n  justify-content:center;\n  background:linear-gradient(\n    to bottom,\n    rgba(22,13,18,.04),\n    rgba(22,13,18,.12) 55%,\n    rgba(22,13,18,.48)\n  );\n  transition:opacity .25s ease;\n  pointer-events:none;\n}\n\n.deki-ugc-card__play{\n  width:80px;\n  height:80px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  border-radius:50%;\n  background:rgba(255,255,255,.95);\n  box-shadow:0 10px 30px rgba(0,0,0,.25);\n  transition:transform .2s ease;\n}\n\n.deki-ugc-card__media:hover .deki-ugc-card__play{\n  transform:scale(1.08);\n}\n\n.deki-ugc-card__play:before{\n  content:\"\";\n  margin-left:6px;\n  width:0;\n  height:0;\n  border-top:14px solid transparent;\n  border-bottom:14px solid transparent;\n  border-left:21px solid #a93d66;\n}\n\n.deki-ugc-card__duration{\n  position:absolute;\n  right:14px;\n  bottom:14px;\n  padding:6px 10px;\n  color:#fff;\n  background:rgba(24,15,20,.76);\n  border-radius:999px;\n  font-size:12px;\n  font-weight:800;\n}\n\n.deki-ugc-card__media.is-playing{\n  cursor:default;\n}\n\n.deki-ugc-card__media.is-playing .deki-ugc-card__overlay{\n  opacity:0;\n}\n\n.deki-ugc-card__content{\n  padding:20px 20px 23px;\n}\n\n.deki-ugc-card__label{\n  display:inline-block;\n  margin-bottom:10px;\n  padding:6px 11px;\n  color:#8e3459;\n  background:#f8e9ef;\n  border-radius:999px;\n  font-size:12px;\n  font-weight:800;\n  letter-spacing:.4px;\n  text-transform:uppercase;\n}\n\n.deki-ugc-card__title{\n  margin:0 0 9px;\n  color:#2e2228;\n  font-size:21px;\n  line-height:1.3;\n  font-weight:800;\n}\n\n.deki-ugc-card__quote{\n  margin:0;\n  color:#746a70;\n  font-size:15px;\n  line-height:1.65;\n}\n\n.deki-ugc-premium__trust{\n  display:flex;\n  justify-content:center;\n  align-items:center;\n  flex-wrap:wrap;\n  gap:10px;\n  margin-top:38px;\n  color:#2e2228;\n  font-size:16px;\n  font-weight:700;\n}\n\n.deki-ugc-premium__trust-stars{\n  color:#c64b77;\n  font-size:21px;\n  letter-spacing:2px;\n}\n\n@media(max-width:900px){\n  .deki-ugc-premium__grid{\n    grid-template-columns:repeat(2,minmax(0,1fr));\n  }\n\n  .deki-ugc-card:last-child{\n    grid-column:1 / -1;\n    width:100%;\n    max-width:420px;\n    margin:0 auto;\n  }\n}\n\n@media(max-width:640px){\n  .deki-ugc-premium{\n    padding:58px 15px;\n  }\n\n  .deki-ugc-premium__title{\n    font-size:34px;\n  }\n\n  .deki-ugc-premium__subtitle{\n    font-size:16px;\n  }\n\n  .deki-ugc-premium__grid{\n    grid-template-columns:1fr;\n  }\n\n  .deki-ugc-card:last-child{\n    grid-column:auto;\n    max-width:none;\n  }\n\n  .deki-ugc-card__play{\n    width:68px;\n    height:68px;\n  }\n}\n</style>\n\n<section class=\"deki-ugc-premium\">\n  <div class=\"deki-ugc-premium__inner\">\n\n    <div class=\"deki-ugc-premium__header\">\n      <p class=\"deki-ugc-premium__eyebrow\">Echte ervaringen</p>\n\n      <h2 class=\"deki-ugc-premium__title\">\n        Echte gebruikers, echte routines\n      </h2>\n\n      <p class=\"deki-ugc-premium__subtitle\">\n        Bekijk hoe gebruikers de DEKI LUMA IPL thuis gebruiken en ontdek hun persoonlijke ervaringen.\n      </p>\n    </div>\n\n    <div class=\"deki-ugc-premium__grid\">\n\n      <!-- VIDEO 1 -->\n      <article class=\"deki-ugc-card\">\n\n        <div class=\"deki-ugc-card__review\">\n          <div class=\"deki-ugc-card__stars\">★★★★★</div>\n\n          <div class=\"deki-ugc-card__customer\">\n            <span class=\"deki-ugc-card__name\">Echte productervaring</span>\n            <span class=\"deki-ugc-card__verified\">✓ Geverifieerd</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__media\">\n          <video\n            class=\"deki-ugc-card__video\"\n            playsinline\n            preload=\"metadata\"\n            poster=\"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/DEKI_UGC_Cover_1.png?v=1784281382\"\n          >\n            <source src=\"https://cdn.shopify.com/videos/c/o/v/3c02830c0e0b4fe4b1a55c7a65e0c111.mp4\">\n          </video>\n\n          <div class=\"deki-ugc-card__overlay\">\n            <div class=\"deki-ugc-card__play\"></div>\n            <span class=\"deki-ugc-card__duration\">30 sec</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__content\">\n          <span class=\"deki-ugc-card__label\">Eerste indruk</span>\n          <h3 class=\"deki-ugc-card__title\">Uitpakken en ontdekken</h3>\n          <p class=\"deki-ugc-card__quote\">\n            Bekijk het apparaat, de verpakking en alle meegeleverde accessoires.\n          </p>\n        </div>\n\n      </article>\n\n      <!-- VIDEO 2 -->\n      <article class=\"deki-ugc-card\">\n\n        <div class=\"deki-ugc-card__review\">\n          <div class=\"deki-ugc-card__stars\">★★★★★</div>\n\n          <div class=\"deki-ugc-card__customer\">\n            <span class=\"deki-ugc-card__name\">Eenvoudig thuisgebruik</span>\n            <span class=\"deki-ugc-card__verified\">✓ Geverifieerd</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__media\">\n          <video\n            class=\"deki-ugc-card__video\"\n            playsinline\n            preload=\"metadata\"\n            poster=\"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/DEKI_UGC_Cover_2.png?v=1784281399\"\n          >\n            <source src=\"https://cdn.shopify.com/videos/c/o/v/1f687abe202e42efafe0f4cbdea67583.mp4\">\n          </video>\n\n          <div class=\"deki-ugc-card__overlay\">\n            <div class=\"deki-ugc-card__play\"></div>\n            <span class=\"deki-ugc-card__duration\">30 sec</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__content\">\n          <span class=\"deki-ugc-card__label\">In gebruik</span>\n          <h3 class=\"deki-ugc-card__title\">Zo eenvoudig werkt het</h3>\n          <p class=\"deki-ugc-card__quote\">\n            Een duidelijke demonstratie van hoe de IPL-behandeling thuis wordt uitgevoerd.\n          </p>\n        </div>\n\n      </article>\n\n      <!-- VIDEO 3 -->\n      <article class=\"deki-ugc-card\">\n\n        <div class=\"deki-ugc-card__review\">\n          <div class=\"deki-ugc-card__stars\">★★★★★</div>\n\n          <div class=\"deki-ugc-card__customer\">\n            <span class=\"deki-ugc-card__name\">Persoonlijke ervaring</span>\n            <span class=\"deki-ugc-card__verified\">✓ Geverifieerd</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__media\">\n          <video\n            class=\"deki-ugc-card__video\"\n            playsinline\n            preload=\"metadata\"\n            poster=\"https://cdn.shopify.com/s/files/1/0629/6331/8843/files/DEKI_UGC_Cover_3.png?v=1784281418\"\n          >\n<source src=\"https://cdn.shopify.com/videos/c/o/v/c3216606d49e4ac1868440efb76b180e.mp4\">\n</video>\n\n          <div class=\"deki-ugc-card__overlay\">\n            <div class=\"deki-ugc-card__play\"></div>\n            <span class=\"deki-ugc-card__duration\">30 sec</span>\n          </div>\n        </div>\n\n        <div class=\"deki-ugc-card__content\">\n          <span class=\"deki-ugc-card__label\">Mijn ervaring</span>\n          <h3 class=\"deki-ugc-card__title\">Een echte IPL-routine</h3>\n          <p class=\"deki-ugc-card__quote\">\n            Ontdek hoe de DEKI LUMA IPL past binnen een normale verzorgingsroutine.\n          </p>\n        </div>\n\n      </article>\n\n    </div>\n\n    <div class=\"deki-ugc-premium__trust\">\n      <span class=\"deki-ugc-premium__trust-stars\">★★★★★</span>\n      <span>Echte demonstraties van de DEKI LUMA IPL</span>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function initializeDekiUgcVideos() {\n    const mediaItems = document.querySelectorAll(\n      \".deki-ugc-card__media:not([data-deki-ready])\"\n    );\n\n    mediaItems.forEach(function (media) {\n      media.setAttribute(\"data-deki-ready\", \"true\");\n\n      const video = media.querySelector(\".deki-ugc-card__video\");\n\n      if (!video) return;\n\n      media.addEventListener(\"click\", function (event) {\n        if (event.target.closest(\"video\") && !video.paused) return;\n\n        document\n          .querySelectorAll(\".deki-ugc-card__video\")\n          .forEach(function (otherVideo) {\n            if (otherVideo !== video) {\n              otherVideo.pause();\n              otherVideo.removeAttribute(\"controls\");\n\n              const otherMedia = otherVideo.closest(\n                \".deki-ugc-card__media\"\n              );\n\n              if (otherMedia) {\n                otherMedia.classList.remove(\"is-playing\");\n              }\n            }\n          });\n\n        media.classList.add(\"is-playing\");\n        video.setAttribute(\"controls\", \"controls\");\n\n        const playPromise = video.play();\n\n        if (playPromise !== undefined) {\n          playPromise.catch(function () {\n            media.classList.remove(\"is-playing\");\n          });\n        }\n      });\n\n      video.addEventListener(\"pause\", function () {\n        if (!video.ended && video.currentTime > 0) {\n          media.classList.remove(\"is-playing\");\n        }\n      });\n\n      video.addEventListener(\"ended\", function () {\n        media.classList.remove(\"is-playing\");\n        video.removeAttribute(\"controls\");\n        video.currentTime = 0;\n        video.load();\n      });\n    });\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", initializeDekiUgcVideos);\n  document.addEventListener(\"shopify:section:load\", initializeDekiUgcVideos);\n\n  initializeDekiUgcVideos();\n})();\n</script>",
