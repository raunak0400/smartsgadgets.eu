        "custom_liquid": "<style>\n.deki-guarantee{\n  background:#fbf5f1;\n  padding:70px 20px;\n}\n\n.deki-guarantee__inner{\n  max-width:1080px;\n  margin:0 auto;\n  background:#6a2948;\n  color:#fff;\n  border-radius:22px;\n  padding:42px 46px;\n  display:grid;\n  grid-template-columns:auto 1fr auto;\n  gap:28px;\n  align-items:center;\n  box-shadow:0 18px 45px rgba(63,35,46,.12);\n}\n\n.deki-guarantee__badge{\n  width:92px;\n  height:92px;\n  border-radius:50%;\n  background:#8a4767;\nborder:2px solid rgba(255,255,255,.18);\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  text-align:center;\n  font-weight:700;\n  line-height:1.1;\n}\n\n.deki-guarantee__badge strong{\n  font-size:30px;\n}\n\n.deki-guarantee__badge span{\n  font-size:12px;\n  text-transform:uppercase;\n  letter-spacing:.8px;\n  margin-top:4px;\n}\n\n.deki-guarantee__content h2{\n  margin:0 0 10px;\n  color:#fff;\n  font-size:clamp(28px,3vw,42px);\n  line-height:1.1;\n}\n\n.deki-guarantee__content p{\n  margin:0;\n  color:rgba(255,255,255,.86);\n  font-size:16px;\n  line-height:1.6;\n  max-width:650px;\n}\n\n.deki-guarantee__button{\n  display:inline-block;\n  background:#d45b20;\n  color:#fff;\n  padding:18px 34px;\nfont-size:17px;\n  border-radius:999px;\n  text-decoration:none;\n  font-weight:700;\n  white-space:nowrap;\n}\n\n.deki-guarantee__button:hover{\n  opacity:.9;\n}\n\n@media(max-width:768px){\n  .deki-guarantee{\n    padding:50px 16px;\n  }\n\n  .deki-guarantee__inner{\n    grid-template-columns:1fr;\n    text-align:center;\n    padding:34px 24px;\n  }\n\n  .deki-guarantee__badge{\n    margin:0 auto;\n  }\n\n  .deki-guarantee__content p{\n    margin:0 auto;\n  }\n}\n</style>\n\n<section class=\"deki-guarantee\">\n  <div class=\"deki-guarantee__inner\">\n\n    <div class=\"deki-guarantee__badge\">\n      <strong>60</strong>\n      <span>dagen</span>\n    </div>\n\n    <div class=\"deki-guarantee__content\">\n      <h2>Niet tevreden? Geld te