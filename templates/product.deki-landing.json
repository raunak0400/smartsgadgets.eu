    "custom_liquid_4d7fX9": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n.deki-stats-wrap{\n  background:#642342;\n  color:#fff;\n  padding:58px 20px 22px;\n}\n\n.deki-stats{\n  max-width:1400px;\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  text-align:center;\n  gap:32px;\n}\n\n.deki-stat-number{\n  font-size:clamp(40px,4vw,66px);\n  font-weight:750;\n  line-height:1;\n  letter-spacing:-1px;\n}\n\n.deki-stat-text{\n  max-width:210px;\n  margin:16px auto 0;\n  font-size:18px;\n  line-height:1.45;\n  opacity:.92;\n}\n\n.deki-stats-note{\n  margin:38px auto 0;\n  text-align:center;\n  font-size:11px;\n  line-height:1.4;\n  opacity:.55;\n}\n\n@media(max-width:768px){\n  .deki-stats-wrap{\n    padding:40px 16px 22px;\n  }\n\n  .deki-stats{\n    grid-template-columns:repeat(2,1fr);\n    gap:38px 18px;\n  }\n\n  .deki-stat-number{\n    font-size:38px;\n  }\n\n  .deki-stat-text{\n    margin-top:10px;\n    font-size:14px;\n  }\n\n  .deki-stats-note{\n    margin-top:30px;\n    font-size:10px;\n  }\n}\n</style>\n\n<div class=\"deki-stats-wrap\">\n  <div class=\"deki-stats\">\n\n    <div>\n      <div class=\"deki-stat-number\">93%</div>\n      <div class=\"deki-stat-text\">\n        Tot 93% minder zichtbare haargroei*\n      </div>\n    </div>\n\n    <div>\n      <div class=\"deki-stat-number\">500+</div>\n      <div class=\"deki-stat-text\">\n        Tevreden klanten\n      </div>\n    </div>\n\n    <div>\n      <div class=\"deki-stat-number\">5 min</div>\n      <div class=\"deki-stat-text\">\n        Behandeltijd voor beide benen\n      </div>\n    </div>\n\n    <div>\n      <div class=\"deki-stat-number\">999.900</div>\n      <div class=\"deki-stat-text\">\n        Lichtflitsen zonder navullingen\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"deki-stats-note\">\n    *Gebaseerd op regelmatig gebruik volgens de handleiding. Individuele resultaten kunnen verschillen.\n  </div>\n</div>",
        "section_height": "default",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
    },
    "custom_liquid_HxD8B4": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n.deki-why {\n  width: 100%;\n  background: #fbf5f1;\n  padding: 80px 20px;\n  box-sizing: border-box;\n}\n\n.deki-why *,\n.deki-why *::before,\n.deki-why *::after {\n  box-sizing: border-box;\n}\n\n.deki-why__inner {\n  width: 100%;\n  max-width: 1180px;\n  margin: 0 auto;\n}\n\n.deki-why__eyebrow {\n  margin: 0 0 12px;\n  color: #b64b6d;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1.6px;\n  text-align: center;\n  text-transform: uppercase;\n}\n\n.deki-why__title {\n  max-width: 760px;\n  margin: 0 auto 18px;\n  color: #2f2028;\n  font-size: clamp(34px, 4vw, 54px);\n  line-height: 1.08;\n  text-align: center;\n}\n\n.deki-why__intro {\n  max-width: 760px;\n  margin: 0 auto 34px;\n  color: #6f6267;\n  font-size: 18px;\n  line-height: 1.65;\n  text-align: center;\n}\n\n/* Highlight cards */\n\n.deki-why__highlights {\n  display: grid;\n  width: 100%;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 18px;\n  margin-bottom: 28px;\n}\n\n.deki-why__highlight {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  min-height: 145px;\n  padding: 26px 20px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  background: #ffffff;\n  border: 1px solid #eadbd5;\n  border-radius: 14px;\n  text-align: center;\n}\n\n.deki-why__highlight strong {\n  display: block;\n  margin-bottom: 8px;\n  color: #7a294b;\n  font-size: 28px;\n  line-height: 1.2;\n}\n\n.deki-why__highlight span {\n  color: #6f6267;\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n/* Comparison cards */\n\n.deki-why__compare {\n  display: grid;\n  width: 100%;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 18px;\n  margin-top: 22px;\n}\n\n.deki-why__card {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  min-height: 285px;\n  padding: 30px;\n  flex-direction: column;\n  border-radius: 16px;\n}\n\n.deki-why__card--light {\n  background: #ffffff;\n  border: 1px solid #eadbd5;\n}\n\n.deki-why__card--dark {\n  background: #6a2948;\n  color: #ffffff;\n}\n\n.deki-why__card h3 {\n  margin: 0 0 18px;\n  font-size: 16px;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n}\n\n.deki-why__list {\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n\n.deki-why__list li {\n  position: relative;\n  padding-left: 28px;\n  margin: 14px 0;\n  line-height: 1.45;\n}\n\n.deki-why__card--light .deki-why__list li {\n  color: #675b60;\n}\n\n.deki-why__list li::before {\n  position: absolute;\n  top: 0;\n  left: 0;\n  font-weight: 700;\n}\n\n.deki-why__card--light .deki-why__list li::before {\n  content: \"×\";\n  color: #c57388;\n}\n\n.deki-why__card--dark .deki-why__list li::before {\n  content: \"✓\";\n  color: #ffffff;\n}\n\n/* CTA button */\n\n.deki-why__cta {\n  margin-top: 28px;\n  text-align: center;\n}\n\n.deki-why__button {\n  display: inline-block;\n  padding: 15px 30px;\n  color: #ffffff;\n  background: #d65316;\n  border: none;\n  border-radius: 999px;\n  font-family: inherit;\n  font-size: 16px;\n  font-weight: 700;\n  line-height: 1.2;\n  text-decoration: none;\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  transition:\n    opacity 0.2s ease,\n    transform 0.2s ease,\n    box-shadow 0.2s ease;\n}\n\n.deki-why__button:hover {\n  opacity: 0.92;\n  transform: translateY(-1px);\n  box-shadow: 0 8px 20px rgba(214, 83, 22, 0.22);\n}\n\n.deki-why__button:active {\n  transform: translateY(0);\n}\n\n.deki-why__button:focus-visible {\n  outline: 3px solid rgba(214, 83, 22, 0.28);\n  outline-offset: 3px;\n}\n\n/* Benefit cards */\n\n.deki-benefits {\n  display: grid;\n  width: 100%;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  grid-auto-rows: 1fr;\n  align-items: stretch;\n  gap: 18px;\n  margin-top: 46px;\n}\n\n.deki-why .deki-benefits > .deki-benefit {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  max-width: none;\n  min-height: 190px;\n  margin: 0;\n  padding: 24px;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-self: stretch;\n  background: #ffffff;\n  border: 1px solid #eadbd5;\n  border-radius: 14px;\n}\n\n.deki-benefit__icon {\n  display: flex;\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  margin-bottom: 16px;\n  align-items: center;\n  justify-content: center;\n  background: #f8e6e1;\n  border-radius: 10px;\n  font-size: 19px;\n  line-height: 1;\n}\n\n.deki-benefit h4 {\n  min-height: 24px;\n  margin: 0 0 8px;\n  color: #33242b;\n  font-size: 18px;\n  line-height: 1.35;\n}\n\n.deki-benefit p {\n  margin: 0;\n  color: #706368;\n  font-size: 14px;\n  line-height: 1.55;\n}\n\n/* Tablet */\n\n@media screen and (max-width: 900px) {\n  .deki-benefits {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n/* Mobile */\n\n@media screen and (max-width: 768px) {\n  .deki-why {\n    width: 100%;\n    padding: 56px 16px;\n    overflow: hidden;\n  }\n\n  .deki-why__inner {\n    width: 100%;\n    max-width: none;\n  }\n\n  .deki-why__highlights,\n  .deki-why__compare,\n  .deki-benefits {\n    display: grid;\n    width: 100%;\n    max-width: none;\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .deki-why__title {\n    font-size: 36px;\n  }\n\n  .deki-why__intro {\n    font-size: 16px;\n  }\n\n  .deki-why__highlight {\n    width: 100%;\n    max-width: none;\n    min-height: 130px;\n    margin: 0;\n    padding: 22px 18px;\n    justify-self: stretch;\n  }\n\n  .deki-why__card {\n    width: 100%;\n    max-width: none;\n    min-height: 0;\n    margin: 0;\n    padding: 25px 22px;\n    justify-self: stretch;\n  }\n\n  .deki-benefits {\n    grid-auto-rows: 1fr;\n    gap: 14px;\n    margin-top: 38px;\n  }\n\n  .deki-why .deki-benefits > .deki-benefit {\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    min-height: 170px;\n    margin: 0 !important;\n    padding: 22px;\n    justify-self: stretch !important;\n    align-self: stretch !important;\n  }\n}\n\n/* Small mobile */\n\n@media screen and (max-width: 480px) {\n  .deki-why {\n    width: 100%;\n    padding: 48px 14px;\n  }\n\n  .deki-why__title {\n    font-size: 32px;\n  }\n\n  .deki-why .deki-benefits > .deki-benefit {\n    width: 100% !important;\n    min-height: 165px;\n  }\n\n  .deki-why__button {\n    width: 100%;\n    max-width: 340px;\n  }\n}\n</style>\n\n<section class=\"deki-why\">\n  <div class=\"deki-why__inner\">\n\n    <div class=\"deki-why__eyebrow\">Waarom IPL?</div>\n\n    <h2 class=\"deki-why__title\">\n      Scheren is dweilen met de kraan open\n    </h2>\n\n    <p class=\"deki-why__intro\">\n      Scheren om de paar dagen, stoppels, ingegroeide haartjes en terugkerende kosten.\n      IPL richt zich op het haarzakje, waardoor de haargroei bij regelmatig gebruik\n      zichtbaar kan verminderen.\n    </p>\n\n    <div class=\"deki-why__highlights\">\n\n      <div class=\"deki-why__highlight\">\n        <strong>€600+</strong>\n        <span>Mogelijke jaarlijkse besparing vergeleken met salonbehandelingen</span>\n      </div>\n\n      <div class=\"deki-why__highlight\">\n        <strong>Vanaf week 4</strong>\n        <span>De eerste zichtbare resultaten kunnen ontstaan bij regelmatig gebruik</span>\n      </div>\n\n      <div class=\"deki-why__highlight\">\n        <strong>0 navullingen</strong>\n        <span>999.900 lichtflitsen zonder vervangende cartridges</span>\n      </div>\n\n    </div>\n\n    <div class=\"deki-why__compare\">\n\n      <div class=\"deki-why__card deki-why__card--light\">\n        <h3>Scheren, waxen en salon</h3>\n\n        <ul class=\"deki-why__list\">\n          <li>Stoppels keren snel terug</li>\n          <li>Kans op irritatie en ingegroeide haartjes</li>\n          <li>Terugkerende afspraken en kosten</li>\n          <li>Behandelingen kosten tijd buitenshuis</li>\n        </ul>\n      </div>\n\n      <div class=\"deki-why__card deki-why__card--dark\">\n        <h3>Met DEKI LUMA IPL</h3>\n\n        <ul class=\"deki-why__list\">\n          <li>Langdurig een zichtbaar gladdere huid</li>\n          <li>Comfortabel thuis te gebruiken</li>\n          <li>Vijf instelbare intensiteitsniveaus</li>\n          <li>Eenmalige aankoop zonder navullingen</li>\n        </ul>\n      </div>\n\n    </div>\n\n    <div class=\"deki-benefits\">\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">✨</div>\n        <h4>Langdurig glad</h4>\n        <p>Bij regelmatig gebruik kan de zichtbare haargroei geleidelijk verminderen.</p>\n      </div>\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">♡</div>\n        <h4>Comfortabel en veilig</h4>\n        <p>Vijf instelbare niveaus helpen de behandeling af te stemmen op uw huid.</p>\n      </div>\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">⚡</div>\n        <h4>Twee gebruiksmodi</h4>\n        <p>Glijmodus voor grotere zones en handmatige flits voor precieze behandeling.</p>\n      </div>\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">∞</div>\n        <h4>999.900 lichtflitsen</h4>\n        <p>Ontworpen voor jarenlang gebruik zonder vervangende cartridges.</p>\n      </div>\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">✈</div>\n        <h4>Compact en draagbaar</h4>\n        <p>Gemakkelijk op te bergen en geschikt om mee te nemen op reis.</p>\n      </div>\n\n      <div class=\"deki-benefit\">\n        <div class=\"deki-benefit__icon\">□</div>\n        <h4>Complete set</h4>\n        <p>Inclusief apparaat, adapter, beschermbril en scheermes.</p>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function initializeDekiScrollButton() {\n    var buttons = document.querySelectorAll(\n      \"[data-deki-scroll-to-product]:not([data-deki-scroll-ready])\"\n    );\n\n    buttons.forEach(function (button) {\n      button.setAttribute(\"data-deki-scroll-ready\", \"true\");\n\n      button.addEventListener(\"click\", function () {\n        var productTarget =\n          document.querySelector(\"product-form\") ||\n          document.querySelector('form[action*=\"/cart/add\"]') ||\n          document.querySelector(\".buy-buttons\") ||\n          document.querySelector(\".product-form\") ||\n          document.querySelector(\"[class*='buy-buttons']\") ||\n          document.querySelector(\"[class*='product-form']\");\n\n        if (productTarget) {\n          productTarget.scrollIntoView({\n            behavior: \"smooth\",\n            block: \"center\"\n          });\n        } else {\n          window.scrollTo({\n            top: 0,\n            behavior: \"smooth\"\n          });\n        }\n      });\n    });\n  }\n\n  document.addEventListener(\n    \"DOMContentLoaded\",\n    initializeDekiScrollButton\n  );\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    initializeDekiScrollButton\n  );\n\n  initializeDekiScrollButton();\n})();\n</script>",
        "section_height": "default",
        "full_width": true,
        "dividers": "none",
        "prevent_animation": false
      }
    },
