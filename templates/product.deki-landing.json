      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   DEKI LANDING PAGE — INTEGRATED SECTION SPACING\n   ================================================== */\n\n/* Remove Shopify spacing around DEKI custom sections */\n.shopify-section:has(.deki-why),\n.shopify-section:has(.deki-ugc-premium),\n.shopify-section:has(.deki-final-cta),\n.shopify-section:has(.deki-moneyback),\n.shopify-section:has(.deki-guarantee),\n.shopify-section:has(.deki-results),\n.shopify-section:has(.deki-comparison),\n.shopify-section:has(.deki-faq),\n.shopify-section:has(.deki-benefits-section) {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n  min-height: 0 !important;\n}\n\n/* Remove padding from common Enterprise theme wrappers */\n.shopify-section:has(.deki-why) > div,\n.shopify-section:has(.deki-ugc-premium) > div,\n.shopify-section:has(.deki-final-cta) > div,\n.shopify-section:has(.deki-moneyback) > div,\n.shopify-section:has(.deki-guarantee) > div,\n.shopify-section:has(.deki-results) > div,\n.shopify-section:has(.deki-comparison) > div,\n.shopify-section:has(.deki-faq) > div,\n.shopify-section:has(.deki-benefits-section) > div {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n  min-height: 0 !important;\n}\n\n/* Remove outside gaps from regular DEKI sections */\n.deki-why,\n.deki-ugc-premium,\n.deki-moneyback,\n.deki-guarantee,\n.deki-results,\n.deki-comparison,\n.deki-faq,\n.deki-benefits-section {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n/* Final CTA: no gap above, but keep separation from footer */\n.deki-final-cta {\n  margin-top: 0 !important;\n  margin-bottom: 50px !important;\n}\n\n/* Remove spacing from common theme containers */\n.shopify-section:has([class*=\"deki-\"]) .section,\n.shopify-section:has([class*=\"deki-\"]) .section__inner,\n.shopify-section:has([class*=\"deki-\"]) .container,\n.shopify-section:has([class*=\"deki-\"]) .page-width {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n}\n\n/* Prevent empty Custom HTML/Liquid section from creating height */\n.shopify-section:has(.deki-spacing-fix) {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  height: 0 !important;\n  overflow: hidden !important;\n}\n\n/* Hide empty elements */\n.shopify-section:has([class*=\"deki-\"]) > p:empty,\n.shopify-section:has([class*=\"deki-\"]) > div:empty {\n  display: none !important;\n}\n\n/* Mobile */\n@media screen and (max-width: 768px) {\n  .shopify-section:has([class*=\"deki-\"]) {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n  }\n\n  .deki-why,\n  .deki-ugc-premium,\n  .deki-moneyback,\n  .deki-guarantee,\n  .deki-results,\n  .deki-comparison,\n  .deki-faq,\n  .deki-benefits-section {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n  }\n\n  .deki-final-cta {\n    margin-top: 0 !important;\n    margin-bottom: 36px !important;\n  }\n}\n\n/* Small mobile */\n@media screen and (max-width: 480px) {\n  .deki-final-cta {\n    margin-bottom: 28px !important;\n  }\n}\n</style>\n\n<div class=\"deki-spacing-fix\" aria-hidden=\"true\"></div>",
