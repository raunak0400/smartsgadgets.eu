    "custom_liquid_eA6YFq": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n.deki-final-cta {\n  width: calc(100% - 40px);\n  max-width: 1200px;\n\n  /* Reduced empty space above and below */\n  margin: 20px auto;\n  padding: 54px 60px;\n  background: linear-gradient(135deg, #47243d, #7b3658);\n  border-radius: 24px;\n  color: #ffffff;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 40px;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n\n.deki-final-cta *,\n.deki-final-cta *::before,\n.deki-final-cta *::after {\n  box-sizing: border-box;\n}\n\n.deki-final-left {\n  width: 100%;\n}\n\n.deki-final-left h2 {\n  margin: 0 0 16px;\n  color: #ffffff;\n  font-size: 44px;\n  line-height: 1.2;\n  font-weight: 800;\n}\n\n.deki-final-left p {\n  max-width: 680px;\n  margin: 0 0 22px;\n  color: #ffffff;\n  font-size: 18px;\n  line-height: 1.6;\n  opacity: 0.95;\n}\n\n.deki-final-benefits {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin: 0 0 26px;\n}\n\n.deki-final-benefits span {\n  display: inline-flex;\n  align-items: center;\n  padding: 10px 18px;\n  color: #ffffff;\n  background: rgba(255, 255, 255, 0.12);\n  border: 1px solid rgba(255, 255, 255, 0.13);\n  border-radius: 999px;\n  font-size: 15px;\n  line-height: 1.3;\n}\n\n.deki-price {\n  margin: 0 0 18px;\n  color: #ffffff;\n  font-size: 42px;\n  line-height: 1.1;\n  font-weight: 800;\n}\n\n.deki-buy-btn {\n  display: inline-flex;\n  min-height: 58px;\n  padding: 16px 42px;\n  align-items: center;\n  justify-content: center;\n  color: #ffffff;\n  background: #f26a21;\n  border: 0;\n  border-radius: 999px;\n  font-family: inherit;\n  font-size: 20px;\n  line-height: 1.2;\n  font-weight: 700;\n  text-decoration: none;\n  cursor: pointer;\n  appearance: none;\n  -webkit-appearance: none;\n  transition:\n    background 0.2s ease,\n    transform 0.2s ease,\n    box-shadow 0.2s ease;\n}\n\n.deki-buy-btn:hover {\n  color: #ffffff;\n  background: #ff7d39;\n  transform: translateY(-2px);\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);\n}\n\n.deki-buy-btn:active {\n  transform: translateY(0);\n}\n\n.deki-buy-btn:focus-visible {\n  outline: 3px solid rgba(255, 255, 255, 0.45);\n  outline-offset: 4px;\n}\n\n/* Tablet and mobile */\n\n@media screen and (max-width: 768px) {\n  .deki-final-cta {\n    width: calc(100% - 28px);\n\n    /* Much smaller mobile space */\n    margin: 14px auto;\n\n    padding: 40px 24px;\n    text-align: center;\n    border-radius: 20px;\n  }\n\n  .deki-final-left h2 {\n    font-size: 34px;\n  }\n\n  .deki-final-left p {\n    margin-bottom: 20px;\n    font-size: 16px;\n  }\n\n  .deki-final-benefits {\n    justify-content: center;\n    gap: 10px;\n    margin-bottom: 24px;\n  }\n\n  .deki-final-benefits span {\n    padding: 9px 14px;\n    font-size: 14px;\n  }\n\n  .deki-price {\n    font-size: 34px;\n  }\n\n  .deki-buy-btn {\n    width: 100%;\n    max-width: 340px;\n    min-height: 56px;\n    padding: 15px 24px;\n    font-size: 18px;\n  }\n}\n\n@media screen and (max-width: 480px) {\n  .deki-final-cta {\n    width: calc(100% - 24px);\n    margin: 10px auto;\n    padding: 34px 18px;\n    border-radius: 18px;\n  }\n\n  .deki-final-left h2 {\n    font-size: 30px;\n  }\n\n  .deki-final-benefits {\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .deki-final-benefits span {\n    width: 100%;\n    max-width: 280px;\n    justify-content: center;\n  }\n}\n</style>\n\n<section class=\"deki-final-cta\">\n  <div class=\"deki-final-left\">\n\n    <h2>Klaar voor een gladde huid?</h2>\n\n    <p>\n      Begin vandaag met uw IPL-routine en geniet van een zichtbaar gladdere huid.\n    </p>\n\n    <div class=\"deki-final-benefits\">\n      <span>✓ Gratis verzending</span>\n      <span>✓ 60 dagen retour</span>\n      <span>✓ 2 jaar garantie</span>\n    </div>\n\n    <div class=\"deki-price\">€99,95</div>\n\n    <button\n      type=\"button\"\n      class=\"deki-buy-btn\"\n      data-deki-final-buy\n    >\n      Bestel nu\n    </button>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function initializeDekiFinalButton() {\n    var buttons = document.querySelectorAll(\n      \"[data-deki-final-buy]:not([data-deki-final-ready])\"\n    );\n\n    buttons.forEach(function (button) {\n      button.setAttribute(\"data-deki-final-ready\", \"true\");\n\n      button.addEventListener(\"click\", function () {\n        var target =\n          document.querySelector('button[name=\"add\"]') ||\n          document.querySelector(\"product-form\") ||\n          document.querySelector('form[action*=\"/cart/add\"]') ||\n          document.querySelector(\".buy-buttons\") ||\n          document.querySelector(\".product-form\") ||\n          document.querySelector(\"[class*='buy-buttons']\") ||\n          document.querySelector(\"[class*='product-form']\");\n\n        if (target) {\n          target.scrollIntoView({\n            behavior: \"smooth\",\n            block: \"center\"\n          });\n\n          setTimeout(function () {\n            var addButton;\n\n            if (target.matches('button[name=\"add\"]')) {\n              addButton = target;\n            } else {\n              addButton = target.querySelector('button[name=\"add\"]');\n            }\n\n            if (addButton) {\n              addButton.focus({\n                preventScroll: true\n              });\n            }\n          }, 700);\n        } else {\n          window.scrollTo({\n            top: 0,\n            behavior: \"smooth\"\n          });\n        }\n      });\n    });\n  }\n\n  document.addEventListener(\n    \"DOMContentLoaded\",\n    initializeDekiFinalButton\n  );\n\n  document.addEventListener(\n    \"shopify:section:load\",\n    initializeDekiFinalButton\n  );\n\n  initializeDekiFinalButton();\n})();\n</script>",
        "section_height": "tight",
        "full_width": false,
        "dividers": "none",
        "prevent_animation": false
      }
    },
    "custom_liquid_WHC6MD": {
      "type": "custom-liquid",
