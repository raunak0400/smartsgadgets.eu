spin_8kv7-strong\">& Versleuteld</span> Afrekenen\n      </div>\n\n      <div class=\"rspin_8kv7-item\">\n        <span class=\"rspin_8kv7-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20 6L9 17l-5-5\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        Officiële Partner <span class=\"rspin_8kv7-strong\">& Kwaliteit</span> Gegarandeerd\n      </div>\n\n      <div class=\"rspin_8kv7-item\">\n        <span class=\"rspin_8kv7-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 7h11a5 5 0 1 1 0 10H8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M7 4L4 7l3 3\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        60 Dagen <span class=\"rspin_8kv7-strong\">Eenvoudig</span> Retourbeleid\n      </div>\n\n    </div>\n  </div>\n\n  <script>\n    (function(){\n      var view = document.getElementById('rspin_8kv7_view');\n      var line = document.getElementById('rspin_8kv7_line');\n      if(!view || !line) return;\n      var items = line.children;\n      if(!items.length) return;\n\n      var root = view.closest('.rspin_8kv7') || document.documentElement;\n\n      function cssVarInt(el, name, fallback){\n        var v = getComputedStyle(el).getPropertyValue(name).trim();\n        var n = parseInt(v, 10);\n        return isNaN(n) ? fallback : n;\n      }\n\n      var idx = 0;\n      var intervalMs = cssVarInt(root, '--interval-ms', 2500);\n      var rowH = items[0].offsetHeight || 22;\n\n      function setHeight(){\n        rowH = items[0].offsetHeight || rowH;\n        view.style.height = rowH + 'px';\n        line.style.transform = 'translateY(' + (-idx * rowH) + 'px)';\n      }\n\n      setHeight();\n      window.addEventListener('load', setHeight);\n\n      var resizeTO;\n      window.addEventListener('resize', function(){\n        clearTimeout(resizeTO);\n        resizeTO = setTimeout(setHeight, 200);\n      });\n\n      setInterval(function(){\n        idx = (idx + 1) % items.length;\n        line.style.transform = 'translateY(' + (-idx * rowH) + 'px)';\n      }, intervalMs);\n    })();\n  </script>\n</section>"
