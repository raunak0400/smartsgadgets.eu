{% liquid
  assign section_id = 'meari-how-it-works-' | append: section.id
%}

<section id="{{ section_id }}" class="meari-how">
  <div class="meari-how__container">

    <div class="meari-how__header">
      {% if section.settings.eyebrow != blank %}
        <span class="meari-how__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="meari-how__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="meari-how__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="meari-how__grid">

      <article class="meari-how__card">
        <div class="meari-how__image-wrapper">
          {% if section.settings.image_1 != blank %}
            {{
              section.settings.image_1
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                class: 'meari-how__image'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'meari-how__placeholder' }}
          {% endif %}
        </div>

        <div class="meari-how__content">
          <span class="meari-how__number">01</span>

          {% if section.settings.title_1 != blank %}
            <h3 class="meari-how__title">
              {{ section.settings.title_1 }}
            </h3>
          {% endif %}

          {% if section.settings.text_1 != blank %}
            <p class="meari-how__text">
              {{ section.settings.text_1 }}
            </p>
          {% endif %}
        </div>
      </article>

      <article class="meari-how__card">
        <div class="meari-how__image-wrapper">
          {% if section.settings.image_2 != blank %}
            {{
              section.settings.image_2
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                class: 'meari-how__image'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'meari-how__placeholder' }}
          {% endif %}
        </div>

        <div class="meari-how__content">
          <span class="meari-how__number">02</span>

          {% if section.settings.title_2 != blank %}
            <h3 class="meari-how__title">
              {{ section.settings.title_2 }}
            </h3>
          {% endif %}

          {% if section.settings.text_2 != blank %}
            <p class="meari-how__text">
              {{ section.settings.text_2 }}
            </p>
          {% endif %}
        </div>
      </article>

      <article class="meari-how__card">
        <div class="meari-how__image-wrapper">
          {% if section.settings.image_3 != blank %}
            {{
              section.settings.image_3
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                class: 'meari-how__image'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'meari-how__placeholder' }}
          {% endif %}
        </div>

        <div class="meari-how__content">
          <span class="meari-how__number">03</span>

          {% if section.settings.title_3 != blank %}
            <h3 class="meari-how__title">
              {{ section.settings.title_3 }}
            </h3>
          {% endif %}

          {% if section.settings.text_3 != blank %}
            <p class="meari-how__text">
              {{ section.settings.text_3 }}
            </p>
          {% endif %}
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  #{{ section_id }},
  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0 !important;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at top left,
        rgba(255, 106, 0, 0.06),
        transparent 28%
      ),
      linear-gradient(180deg, #ffffff 0%, #f7f8fa 100%);
  }

  #shopify-section-{{ section.id }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  #{{ section_id }} .meari-how__container {
    width: calc(100% - 48px);
    max-width: 1440px;
    margin: 0 auto;
    padding: 0;
  }

  #{{ section_id }} .meari-how__header {
    width: 100%;
    max-width: 760px;
    margin: 0 auto 34px;
    padding: 0;
    text-align: center;
  }

  #{{ section_id }} .meari-how__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 15px;
    padding: 8px 17px;
    border-radius: 999px;
    background: #fff0e6;
    color: #f26322;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  #{{ section_id }} .meari-how__heading {
    width: 100%;
    max-width: 100%;
    margin: 0 0 14px;
    padding: 0;
    color: #111111;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 750;
    line-height: 1.08;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .meari-how__description {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    color: #676b71;
    font-size: 17px;
    line-height: 1.6;
  }

  #{{ section_id }} .meari-how__description p {
    margin: 0;
  }

  #{{ section_id }} .meari-how__grid {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} .meari-how__card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(17, 17, 17, 0.06);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 14px 38px rgba(20, 28, 38, 0.07);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  #{{ section_id }} .meari-how__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 50px rgba(20, 28, 38, 0.11);
  }

  #{{ section_id }} .meari-how__image-wrapper {
    position: relative;
    width: 100%;
    height: 285px;
    min-height: 285px;
    overflow: hidden;
    background: #eceff2;
  }

  #{{ section_id }} .meari-how__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s ease;
  }

  #{{ section_id }} .meari-how__card:hover .meari-how__image {
    transform: scale(1.025);
  }

  #{{ section_id }} .meari-how__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .meari-how__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px 24px 24px;
  }

  #{{ section_id }} .meari-how__number {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    margin: 0 0 15px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff7b1a 0%, #f05216 100%);
    color: #ffffff;
    box-shadow: 0 8px 18px rgba(242, 101, 34, 0.24);
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
  }

  #{{ section_id }} .meari-how__title {
    width: 100%;
    margin: 0 0 9px;
    color: #111111;
    font-size: 23px;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  #{{ section_id }} .meari-how__text {
    width: 100%;
    margin: 0;
    color: #666a70;
    font-size: 15px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 1100px) {
    #{{ section_id }} .meari-how__container {
      width: calc(100% - 36px);
    }

    #{{ section_id }} .meari-how__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .meari-how__card:last-child {
      grid-column: 1 / -1;
      width: calc(50% - 11px);
      justify-self: center;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .meari-how__container {
      width: calc(100% - 28px);
    }

    #{{ section_id }} .meari-how__header {
      margin-bottom: 26px;
      text-align: left;
    }

    #{{ section_id }} .meari-how__heading {
      font-size: 34px;
      line-height: 1.1;
    }

    #{{ section_id }} .meari-how__description {
      font-size: 16px;
    }

    #{{ section_id }} .meari-how__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    #{{ section_id }} .meari-how__card:last-child {
      grid-column: auto;
      width: 100%;
    }

    #{{ section_id }} .meari-how__image-wrapper {
      height: 225px;
      min-height: 225px;
    }

    #{{ section_id }} .meari-how__content {
      padding: 20px;
    }

    #{{ section_id }} .meari-how__title {
      font-size: 22px;
    }
  }
</style>

{% schema %}
{
  "name": "MEARI S1 - How It Works",
  "tag": "section",
  "class": "meari-how-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine titel",
      "default": "Eenvoudig in gebruik"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hoofdtitel",
      "default": "Binnen enkele minuten verbonden"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschrijving",
      "default": "<p>Plaats de camera, verbind hem met de MEARI-app en houd je woning overal eenvoudig in de gaten.</p>"
    },
    {
      "type": "header",
      "content": "Stap 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Titel",
      "default": "Plaats de camera"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Tekst",
      "default": "Zet de MEARI S1 Plus op een kast, tafel of plank en richt hem op de ruimte die je wilt bewaken."
    },
    {
      "type": "header",
      "content": "Stap 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Titel",
      "default": "Verbind met de MEARI-app"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Tekst",
      "default": "Download de app, scan de QR-code en verbind de camera veilig met je wifi-netwerk."
    },
    {
      "type": "header",
      "content": "Stap 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Titel",
      "default": "Bekijk alles live"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Tekst",
      "default": "Bekijk livebeelden, ontvang meldingen en praat via tweerichtingsaudio, waar je ook bent."
    },
    {
      "type": "header",
      "content": "Afstand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Ruimte boven",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Ruimte onder",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "MEARI S1 - How It Works"
    }
  ]
}
{% endschema %}