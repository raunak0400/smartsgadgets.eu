{%- if localization.available_countries.size > 1 -%}
  {%- liquid
    assign id = section.id | append: '-country'
    assign preferred_order = 'NL,US,GB,CH,CA' | split: ','
    assign seen_currencies = ''
    assign country_values = ''
    assign country_names = ''

    for code in preferred_order
      for country in localization.available_countries
        if country.iso_code == code
          unless seen_currencies contains country.currency.iso_code
            assign country_values = country_values | append: country.iso_code | append: '|'
            assign country_names = country_names | append: country.currency.iso_code | append: '&nbsp;' | append: country.currency.symbol | append: '|'
            assign seen_currencies = seen_currencies | append: country.currency.iso_code | append: ','
          endunless
        endif
      endfor
    endfor

    for country in localization.available_countries
      unless seen_currencies contains country.currency.iso_code
        assign country_values = country_values | append: country.iso_code | append: '|'
        assign country_names = country_names | append: country.currency.iso_code | append: '&nbsp;' | append: country.currency.symbol | append: '|'
        assign seen_currencies = seen_currencies | append: country.currency.iso_code | append: ','
      endunless
    endfor

    assign country_values = country_values | remove_last: '|' | split: '|'
    assign country_names = country_names | remove_last: '|' | split: '|'
  -%}

  {%- render 'custom-select',
    id: id,
    option_values: country_values,
    option_names: country_names,
    selected_value: localization.country.iso_code
  -%}
{%- endif -%}
