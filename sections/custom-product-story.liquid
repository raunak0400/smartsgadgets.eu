{%- comment -%}
  Product story: a long, image-led feature page for one product, built after the manufacturer's product page
  (hero, sticky sub-navigation, icon highlights, image rows, collapsible technical parameters and a home map with
  labelled devices). Every text and image can be changed in the theme editor; the images that ship with it are theme
  assets (assets/meari-story-*.webp), used until another image is picked.

  It sits between the trust bar and the reviews on the product template. "Show only on this product" keeps it off the
  other products that share the template; leave it empty to show it on every product that uses the template.

  Styles: assets/custom-product-story.css. Behaviour (collapse, hotspots, smooth scroll): assets/custom-product-story.js.
{%- endcomment -%}

{%- liquid
  assign show_story = true
  if section.settings.product != blank
    if section.settings.product.handle != product.handle
      assign show_story = false
    endif
  endif

  assign features = section.blocks | where: 'type', 'feature'
  assign spec_groups = section.blocks | where: 'type', 'spec_group'
  assign hotspots = section.blocks | where: 'type', 'hotspot'
-%}

{%- if show_story -%}
  {{ 'custom-product-story.css' | asset_url | stylesheet_tag }}

  <div class="sg-story" data-sg-story>
    {%- comment -%} Hero {%- endcomment -%}
    <header class="sg-story__hero">
      <picture>
        {%- if section.settings.hero_image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}">
        {%- elsif section.settings.hero_image == blank -%}
          <source media="(max-width: 749px)" srcset="{{ 'meari-story-hero-mobile.webp' | asset_url }}" width="1200" height="1500">
        {%- endif -%}
        {% render 'story-image', image: section.settings.hero_image, asset: 'meari-story-hero.webp', width: 2400, height: 1241, sizes: '100vw', alt: '' %}
      </picture>
      <div class="sg-story__hero-copy">
        <h2 class="sg-story__hero-title">
          {%- if section.settings.hero_title_light != blank -%}<span class="sg-story__hero-light">{{ section.settings.hero_title_light }}</span>{%- endif -%}
          {%- if section.settings.hero_title_bold != blank -%}<strong class="sg-story__hero-bold">{{ section.settings.hero_title_bold }}</strong>{%- endif -%}
        </h2>
        {%- if section.settings.hero_text != blank -%}
          <p class="sg-story__hero-text">{{ section.settings.hero_text }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} Sub-navigation, sticks to the top while the story is on screen {%- endcomment -%}
    <nav class="sg-story__nav" aria-label="{{ section.settings.nav_title | escape }}">
      <div class="sg-story__nav-inner">
        <p class="sg-story__nav-title">{{ section.settings.nav_title }}</p>
        <div class="sg-story__nav-links">
          {%- if section.settings.nav_link_label != blank -%}
            <a class="sg-story__nav-link" href="#story-highlights-{{ section.id }}" data-story-anchor>{{ section.settings.nav_link_label }}</a>
          {%- endif -%}
          {%- if section.settings.contact_url != blank and section.settings.contact_label != blank -%}
            <a class="sg-story__nav-btn" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </nav>

    <div class="sg-story__body" id="story-highlights-{{ section.id }}">
      {%- comment -%} Icon highlights {%- endcomment -%}
      {%- if section.settings.features_heading != blank or features.size > 0 -%}
        <section class="sg-story__section sg-story__features-section">
          {%- if section.settings.features_heading != blank -%}
            <h2 class="sg-story__h2">{{ section.settings.features_heading }}</h2>
          {%- endif -%}
          {%- if features.size > 0 -%}
            <ul class="sg-story__features" role="list">
              {%- for block in features -%}
                <li class="sg-story__feature" {{ block.shopify_attributes }}>
                  <span class="sg-story__feature-icon">{% render 'story-icon', name: block.settings.icon %}</span>
                  <span class="sg-story__feature-label">{{ block.settings.label }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </section>
      {%- endif -%}

      {%- comment -%} One camera, two views {%- endcomment -%}
      {%- if section.settings.views_heading != blank -%}
        {% render 'story-pair',
          modifier: 'views',
          heading: section.settings.views_heading,
          image_1: section.settings.views_image_1, asset_1: 'meari-story-views-1.webp', width_1: 1410, height_1: 1248,
          image_2: section.settings.views_image_2, asset_2: 'meari-story-views-2.webp', width_2: 1410, height_2: 1248
        %}
      {%- endif -%}

      {%- comment -%} Two-way audio {%- endcomment -%}
      {%- if section.settings.audio_heading != blank -%}
        {% render 'story-pair',
          modifier: 'audio',
          heading: section.settings.audio_heading,
          text: section.settings.audio_text,
          image_1: section.settings.audio_image_1, asset_1: 'meari-story-audio-1.webp', width_1: 960, height_1: 1248,
          image_2: section.settings.audio_image_2, asset_2: 'meari-story-audio-2.webp', width_2: 1843, height_2: 1248
        %}
      {%- endif -%}

      {%- comment -%} Cloud and local storage {%- endcomment -%}
      {%- if section.settings.storage_heading != blank -%}
        {% render 'story-pair',
          modifier: 'storage',
          heading: section.settings.storage_heading,
          text: section.settings.storage_text,
          image_1: section.settings.storage_image_1, asset_1: 'meari-story-cloud.webp', width_1: 2020, height_1: 1360,
          image_2: section.settings.storage_image_2, asset_2: 'meari-story-sd.webp', width_2: 800, height_2: 1360
        %}
      {%- endif -%}

      {%- comment -%} Installation: two stacked images and a text {%- endcomment -%}
      {%- if section.settings.stick_heading != blank -%}
        <section class="sg-story__section sg-story__stick">
          <div class="sg-story__wrap sg-story__stick-grid">
            <div class="sg-story__stick-images">
              <figure>{% render 'story-image', image: section.settings.stick_image_1, asset: 'meari-story-stick-1.webp', width: 1514, height: 666, sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.stick_heading %}</figure>
              <figure>{% render 'story-image', image: section.settings.stick_image_2, asset: 'meari-story-stick-2.webp', width: 1514, height: 666, sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.stick_heading %}</figure>
            </div>
            <div class="sg-story__stick-copy">
              <h2 class="sg-story__h2 sg-story__h2--left">{{ section.settings.stick_heading }}</h2>
              {%- if section.settings.stick_text != blank -%}
                <p class="sg-story__sub sg-story__sub--left">{{ section.settings.stick_text }}</p>
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- endif -%}

      {%- comment -%} Technical parameters {%- endcomment -%}
      {%- if spec_groups.size > 0 -%}
        <section
          class="sg-story__section sg-story__specs"
          data-story-specs
          data-collapsed="false"
          data-collapse-label="{{ section.settings.specs_collapse_label | escape }}"
          data-expand-label="{{ section.settings.specs_expand_label | escape }}"
        >
          <div class="sg-story__wrap">
            {%- if section.settings.specs_heading != blank -%}
              <h2 class="sg-story__h2 sg-story__h2--left">{{ section.settings.specs_heading }}</h2>
            {%- endif -%}
            <div class="sg-story__spec-groups" id="story-specs-{{ section.id }}">
              {%- for block in spec_groups -%}
                <div class="sg-story__spec-group" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="sg-story__spec-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  <dl class="sg-story__spec-rows">
                    {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                    {%- for row in rows -%}
                      {%- assign row = row | strip -%}
                      {%- if row contains '|' -%}
                        {%- assign parts = row | split: '|' -%}
                        {%- assign spec_label = parts.first | strip -%}
                        {%- assign spec_value = row | remove_first: parts.first | remove_first: '|' | strip | escape | replace: ' // ', '<br>' -%}
                        <div class="sg-story__spec-row">
                          <dt>{{ spec_label | escape }}</dt>
                          <dd>{{ spec_value }}</dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                </div>
              {%- endfor -%}
            </div>
            <div class="sg-story__actions">
              <button type="button" class="sg-story__btn" data-story-toggle aria-expanded="true" aria-controls="story-specs-{{ section.id }}">
                <span data-story-toggle-label>{{ section.settings.specs_collapse_label }}</span>
                <svg class="sg-story__btn-icon sg-story__btn-icon--chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 15 6-6 6 6"/></svg>
              </button>
              {%- if section.settings.manual_url != blank and section.settings.manual_label != blank -%}
                <a class="sg-story__btn" href="{{ section.settings.manual_url }}" target="_blank" rel="noopener">
                  <span>{{ section.settings.manual_label }}</span>
                  <svg class="sg-story__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12M7 11l5 5 5-5M4 20h16"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- endif -%}

      {%- comment -%} Home map with labelled devices {%- endcomment -%}
      {%- if section.settings.home_heading != blank or hotspots.size > 0 -%}
        {%- liquid
          assign active_index = 0
          for block in hotspots
            if block.settings.active and active_index == 0
              assign active_index = forloop.index
            endif
          endfor
          if active_index == 0
            assign active_index = 1
          endif
        -%}
        <section class="sg-story__section sg-story__home-section">
          <div class="sg-story__wrap">
            {%- if section.settings.home_heading != blank -%}
              <h2 class="sg-story__h2">{{ section.settings.home_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.home_text != blank -%}
              <p class="sg-story__sub sg-story__sub--wide">{{ section.settings.home_text }}</p>
            {%- endif -%}
          </div>
          <div class="sg-story__home" data-story-home>
            {% render 'story-image', image: section.settings.home_image, asset: 'meari-story-home.webp', width: 1920, height: 1080, sizes: '100vw', alt: section.settings.home_heading %}
            {%- for block in hotspots -%}
              <div
                class="sg-hotspot sg-hotspot--{{ block.settings.side }}{% if forloop.index == active_index %} is-active{% endif %}"
                style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --y2: {{ block.settings.line_end }}%;"
                data-story-hotspot
                data-label="{{ block.settings.label | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.line_end > block.settings.y -%}
                  <span class="sg-hotspot__line" aria-hidden="true"></span>
                {%- endif -%}
                <span class="sg-hotspot__label" aria-hidden="true">{{ block.settings.label }}</span>
                <button type="button" class="sg-hotspot__pin" aria-label="{{ block.settings.label | escape }}">
                  <span class="sg-hotspot__pin-in">{% render 'story-icon', name: block.settings.icon %}</span>
                </button>
              </div>
            {%- endfor -%}
          </div>
          {%- if hotspots.size > 0 -%}
            {%- for block in hotspots -%}
              {%- if forloop.index == active_index -%}
                {%- assign active_label = block.settings.label -%}
              {%- endif -%}
            {%- endfor -%}
            <p class="sg-story__home-caption" data-story-caption aria-live="polite">{{ active_label }}</p>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>
  </div>

  <script src="{{ 'custom-product-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Custom: Product story",
  "tag": "section",
  "class": "cc-custom-product-story",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Show only on this product",
      "info": "Other products that use the same template do not show this section. Leave empty to show it on every product."
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image",
      "info": "Wide image, 2400 px or more. Empty: the image that ships with the section."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Image on phones",
      "info": "Optional portrait crop (4:5). Empty: the image that ships with the section, or the main image."
    },
    {
      "type": "text",
      "id": "hero_title_light",
      "label": "Headline, light line",
      "default": "See Outside"
    },
    {
      "type": "text",
      "id": "hero_title_bold",
      "label": "Headline, bold line",
      "default": "Stay Inside"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "One camera mounted on your window guards both indoors & outdoors, from the comfort of indoors."
    },
    {
      "type": "header",
      "content": "Sub-navigation"
    },
    {
      "type": "text",
      "id": "nav_title",
      "label": "Title",
      "default": "Dual-View Smart WiFi Window Camera (M2 Dual Pure)"
    },
    {
      "type": "text",
      "id": "nav_link_label",
      "label": "Link to the story",
      "default": "Highlights"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Highlights (add icon blocks below)"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Heading",
      "default": "24/7 Protection for Your Safety"
    },
    {
      "type": "header",
      "content": "Two images: views"
    },
    {
      "type": "text",
      "id": "views_heading",
      "label": "Heading",
      "default": "One Camera, Two Views — Protect Your Home Inside and Out"
    },
    {
      "type": "image_picker",
      "id": "views_image_1",
      "label": "Image left"
    },
    {
      "type": "image_picker",
      "id": "views_image_2",
      "label": "Image right"
    },
    {
      "type": "header",
      "content": "Two images: audio"
    },
    {
      "type": "text",
      "id": "audio_heading",
      "label": "Heading",
      "default": "Two-Way Audio"
    },
    {
      "type": "textarea",
      "id": "audio_text",
      "label": "Text",
      "default": "Equipped with a high-sensitivity microphone and HD speaker for real-time audio capture and smooth two-way talk—protect your home from anywhere"
    },
    {
      "type": "image_picker",
      "id": "audio_image_1",
      "label": "Image left"
    },
    {
      "type": "image_picker",
      "id": "audio_image_2",
      "label": "Image right"
    },
    {
      "type": "header",
      "content": "Two images: storage"
    },
    {
      "type": "text",
      "id": "storage_heading",
      "label": "Heading",
      "default": "Cloud Storage & Local Storage"
    },
    {
      "type": "textarea",
      "id": "storage_text",
      "label": "Text",
      "default": "Dual storage modes for safety and flexibility—double protection for total peace of mind"
    },
    {
      "type": "image_picker",
      "id": "storage_image_1",
      "label": "Image left"
    },
    {
      "type": "image_picker",
      "id": "storage_image_2",
      "label": "Image right"
    },
    {
      "type": "header",
      "content": "Installation"
    },
    {
      "type": "text",
      "id": "stick_heading",
      "label": "Heading",
      "default": "No Tools, Just Stick It"
    },
    {
      "type": "textarea",
      "id": "stick_text",
      "label": "Text",
      "default": "Just peel, stick, and plug in the camera. An angle bracket can support more application scenarios."
    },
    {
      "type": "image_picker",
      "id": "stick_image_1",
      "label": "Image top"
    },
    {
      "type": "image_picker",
      "id": "stick_image_2",
      "label": "Image bottom"
    },
    {
      "type": "header",
      "content": "Technical parameters (add parameter groups below)"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Heading",
      "default": "Technical parameters"
    },
    {
      "type": "text",
      "id": "specs_collapse_label",
      "label": "Collapse button",
      "default": "Collapse parameter"
    },
    {
      "type": "text",
      "id": "specs_expand_label",
      "label": "Expand button",
      "default": "Expand parameter"
    },
    {
      "type": "text",
      "id": "manual_label",
      "label": "Manual button label",
      "default": "Download Instructions"
    },
    {
      "type": "url",
      "id": "manual_url",
      "label": "Manual link",
      "info": "A PDF or page. The button stays hidden while this is empty."
    },
    {
      "type": "header",
      "content": "Home map (add device blocks below)"
    },
    {
      "type": "text",
      "id": "home_heading",
      "label": "Heading",
      "default": "Meari Ensures Your Home's Security"
    },
    {
      "type": "textarea",
      "id": "home_text",
      "label": "Text",
      "default": "With Meari products, you can manage home security from anywhere and check device connections through the Meari App. View play back anytime, anywhere."
    },
    {
      "type": "image_picker",
      "id": "home_image",
      "label": "Image",
      "info": "16:9 picture of the home. Empty: the image that ships with the section."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Highlight icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "aperture", "label": "Lens" },
            { "value": "ai", "label": "AI chip" },
            { "value": "talk", "label": "Two-way talk" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "night", "label": "Night vision" },
            { "value": "shield", "label": "Shield" },
            { "value": "wifi", "label": "Wi-Fi" },
            { "value": "battery", "label": "Battery" }
          ],
          "default": "aperture"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "4MP(2MP+2MP) Resolution"
        }
      ]
    },
    {
      "type": "spec_group",
      "name": "Parameter group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Group title",
          "default": "Camera"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Rows",
          "info": "One row per line: Label | Value. Use // inside a value to start a new line."
        }
      ]
    },
    {
      "type": "hotspot",
      "name": "Device on the home map",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Video Doorbell"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dome", "label": "Dome camera" },
            { "value": "ptz", "label": "PTZ camera" },
            { "value": "doorbell", "label": "Video doorbell" },
            { "value": "bullet", "label": "Outdoor camera" },
            { "value": "battery-cam", "label": "Battery camera" }
          ],
          "default": "dome"
        },
        {
          "type": "select",
          "id": "side",
          "label": "Label side",
          "options": [
            { "value": "left", "label": "Left of the pin" },
            { "value": "right", "label": "Right of the pin" }
          ],
          "default": "left"
        },
        {
          "type": "number",
          "id": "x",
          "label": "Pin position from the left (%)",
          "info": "Percentage of the image width.",
          "default": 40
        },
        {
          "type": "number",
          "id": "y",
          "label": "Pin position from the top (%)",
          "info": "Percentage of the image height.",
          "default": 50
        },
        {
          "type": "number",
          "id": "line_end",
          "label": "Line ends at (% from the top)",
          "info": "The line runs from the pin down to this height. 0 hides the line.",
          "default": 65
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "Shown large at first",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Product story"
    }
  ]
}
{% endschema %}
