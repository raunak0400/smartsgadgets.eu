    "custom_liquid_6w3Uzy": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n.sg-meari-why,\n.sg-meari-why * {\n  box-sizing: border-box;\n}\n\n.sg-meari-why {\n  --sg-blue: #1686e8;\n  --sg-blue-light: #39a4ff;\n  --sg-navy: #071526;\n  --sg-navy-2: #0b213b;\n  --sg-orange: #ff6a13;\n  --sg-text: #ffffff;\n  --sg-muted: #b9cbe0;\n\n  position: relative;\n  overflow: hidden;\n  padding: 90px 24px;\n  color: var(--sg-text);\n  background:\n    radial-gradient(circle at 14% 10%, rgba(22,134,232,.20), transparent 32%),\n    radial-gradient(circle at 88% 75%, rgba(35,117,219,.16), transparent 28%),\n    linear-gradient(145deg, var(--sg-navy), #04101f 70%);\n  font-family: inherit;\n}\n\n.sg-meari-why::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: .11;\n  background-image:\n    linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);\n  background-size: 46px 46px;\n}\n\n.sg-meari-why__inner {\n  position: relative;\n  z-index: 2;\n  width: min(1240px, 100%);\n  margin: 0 auto;\n}\n\n.sg-meari-why__header {\n  max-width: 760px;\n  margin: 0 auto 48px;\n  text-align: center;\n}\n\n.sg-meari-why__eyebrow {\n  margin-bottom: 14px;\n  color: var(--sg-orange);\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 800;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n}\n\n.sg-meari-why h2 {\n  margin: 0 0 18px;\n  color: #fff;\n  font-size: clamp(36px, 4.5vw, 58px);\n  line-height: 1.05;\n  letter-spacing: -.035em;\n  font-weight: 850;\n}\n\n.sg-meari-why h2 span {\n  color: var(--sg-blue-light);\n}\n\n.sg-meari-why__intro {\n  margin: 0;\n  color: var(--sg-muted);\n  font-size: 18px;\n  line-height: 1.65;\n}\n\n.sg-meari-why__grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n\n.sg-meari-why__card {\n  position: relative;\n  min-height: 245px;\n  padding: 28px;\n  overflow: hidden;\n  border: 1px solid rgba(89,174,255,.20);\n  border-radius: 22px;\n  background:\n    linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.025));\n  box-shadow:\n    0 18px 48px rgba(0,0,0,.24),\n    inset 0 1px 0 rgba(255,255,255,.08);\n  backdrop-filter: blur(12px);\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    box-shadow .25s ease;\n}\n\n.sg-meari-why__card:hover {\n  transform: translateY(-6px);\n  border-color: rgba(61,166,255,.48);\n  box-shadow:\n    0 25px 60px rgba(0,0,0,.30),\n    0 0 38px rgba(22,134,232,.10);\n}\n\n.sg-meari-why__card::after {\n  content: \"\";\n  position: absolute;\n  right: -55px;\n  bottom: -55px;\n  width: 160px;\n  height: 160px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(24,139,241,.22), transparent 68%);\n}\n\n.sg-meari-why__icon {\n  width: 54px;\n  height: 54px;\n  margin-bottom: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid rgba(78,173,255,.28);\n  border-radius: 15px;\n  background: rgba(15,94,177,.20);\n  box-shadow: 0 0 28px rgba(20,127,224,.14);\n}\n\n.sg-meari-why__icon svg {\n  width: 29px;\n  height: 29px;\n  fill: none;\n  stroke: var(--sg-blue-light);\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sg-meari-why__card h3 {\n  position: relative;\n  z-index: 2;\n  margin: 0 0 11px;\n  color: #fff;\n  font-size: 21px;\n  line-height: 1.25;\n  font-weight: 800;\n}\n\n.sg-meari-why__card p {\n  position: relative;\n  z-index: 2;\n  margin: 0;\n  color: var(--sg-muted);\n  font-size: 15px;\n  line-height: 1.65;\n}\n\n.sg-meari-why__footer {\n  margin-top: 44px;\n  display: flex;\n  justify-content: center;\n}\n\n.sg-meari-why__cta {\n  min-height: 56px;\n  padding: 15px 30px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n  color: #fff;\n  text-decoration: none;\n  background: linear-gradient(135deg, #ff7b27, var(--sg-orange));\n  border-radius: 12px;\n  box-shadow: 0 15px 36px rgba(255,106,19,.24);\n  font-size: 17px;\n  font-weight: 800;\n  transition:\n    transform .22s ease,\n    box-shadow .22s ease;\n}\n\n.sg-meari-why__cta:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 20px 44px rgba(255,106,19,.34);\n}\n\n.sg-meari-why__cta svg {\n  width: 19px;\n  height: 19px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n}\n\n@media screen and (max-width: 980px) {\n  .sg-meari-why {\n    padding: 72px 22px;\n  }\n\n  .sg-meari-why__grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media screen and (max-width: 640px) {\n  .sg-meari-why {\n    padding: 58px 14px;\n  }\n\n  .sg-meari-why__header {\n    margin-bottom: 32px;\n  }\n\n  .sg-meari-why h2 {\n    font-size: 36px;\n  }\n\n  .sg-meari-why__intro {\n    font-size: 16px;\n  }\n\n  .sg-meari-why__grid {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n\n  .sg-meari-why__card {\n    min-height: auto;\n    padding: 23px;\n  }\n\n  .sg-meari-why__footer {\n    margin-top: 30px;\n  }\n\n  .sg-meari-why__cta {\n    width: 100%;\n    max-width: 340px;\n  }\n}\n</style>\n\n<section class=\"sg-meari-why\">\n  <div class=\"sg-meari-why__inner\">\n\n    <div class=\"sg-meari-why__header\">\n      <div class=\"sg-meari-why__eyebrow\">\n        Waarom MEARI N2?\n      </div>\n\n      <h2>\n        Slimme beveiliging.\n        <span>Zonder ingewikkelde installatie.</span>\n      </h2>\n\n      <p class=\"sg-meari-why__intro\">\n        De MEARI N2 combineert slimme detectie, draadloos gebruik en brede\n        cameradekking in één complete oplossing voor uw woning, tuin of oprit.\n      </p>\n    </div>\n\n    <div class=\"sg-meari-why__grid\">\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"7\" r=\"3\"></circle>\n            <path d=\"M6 20c.9-4.2 3-6.3 6-6.3S17.1 15.8 18 20\"></path>\n            <path d=\"M3 8V4h4M21 8V4h-4M3 16v4h4M21 16v4h-4\"></path>\n          </svg>\n        </div>\n        <h3>AI-persoonsdetectie</h3>\n        <p>\n          Ontvang gerichtere meldingen wanneer een persoon wordt gedetecteerd,\n          zodat u minder wordt gestoord door onnodige bewegingen.\n        </p>\n      </article>\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n            <path d=\"M4 5v5h5\"></path>\n            <path d=\"M9 12h6\"></path>\n          </svg>\n        </div>\n        <h3>Automatische tracking</h3>\n        <p>\n          De camera kan bewegende personen automatisch volgen, zodat belangrijke\n          gebeurtenissen beter in beeld blijven.\n        </p>\n      </article>\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 8h16v10H4z\"></path>\n            <path d=\"M8 8l1.5-3h5L16 8\"></path>\n            <circle cx=\"12\" cy=\"13\" r=\"2.5\"></circle>\n          </svg>\n        </div>\n        <h3>3MP-beeldkwaliteit</h3>\n        <p>\n          Bekijk duidelijke beelden met meer detail, zowel overdag als tijdens\n          beveiligingsmomenten in de avond.\n        </p>\n      </article>\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n            <path d=\"M17 3v4M15 5h4\"></path>\n          </svg>\n        </div>\n        <h3>Full-color nachtzicht</h3>\n        <p>\n          Houd ook in het donker zicht op uw omgeving dankzij heldere beelden\n          en ingebouwde verlichting.\n        </p>\n      </article>\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M5 10h14l-1 9H6l-1-9Z\"></path>\n            <path d=\"M8 10l1-5h6l1 5\"></path>\n            <path d=\"M12 2v2M4.5 4.5l1.5 1.5M19.5 4.5 18 6\"></path>\n          </svg>\n        </div>\n        <h3>Ondersteuning voor zonnepaneel</h3>\n        <p>\n          Combineer de camera met een compatibel zonnepaneel om het opladen\n          eenvoudiger te maken en langer draadloos te gebruiken.\n        </p>\n      </article>\n\n      <article class=\"sg-meari-why__card\">\n        <div class=\"sg-meari-why__icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"></rect>\n            <path d=\"M5 10a7 7 0 0 0 14 0M12 17v4M9 21h6\"></path>\n          </svg>\n        </div>\n        <h3>Tweeweg audio</h3>\n        <p>\n          Luister mee en praat rechtstreeks met bezoekers via de ingebouwde\n          microfoon, speaker en mobiele app.\n        </p>\n      </article>\n\n    </div>\n\n    <div class=\"sg-meari-why__footer\">\n      <a href=\"#MainProduct\" class=\"sg-meari-why__cta\" data-sg-scroll-product>\n        Bekijk de MEARI N2\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M5 12h14\"></path>\n          <path d=\"m13 6 6 6-6 6\"></path>\n        </svg>\n      </a>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  function initializeMeariWhy() {\n    document.querySelectorAll('[data-sg-scroll-product]').forEach(function (link) {\n      if (link.dataset.initialized === 'true') return;\n\n      link.dataset.initialized = 'true';\n\n      link.addEventListener('click', function (event) {\n        event.preventDefault();\n\n        var target =\n          document.querySelector('#MainProduct') ||\n          document.querySelector('product-form') ||\n          document.querySelector('form[action*=\"/cart/add\"]') ||\n          document.querySelector('.product-form') ||\n          document.querySelector('button[name=\"add\"]');\n\n        if (target) {\n          target.scrollIntoView({\n            behavior: 'smooth',\n            block: 'center'\n          });\n        }\n      });\n    });\n  }\n\n  document.addEventListener('DOMContentLoaded', initializeMeariWhy);\n  document.addEventListener('shopify:section:load', initializeMeariWhy);\n  initializeMeariWhy();\n})();\n</script>",
