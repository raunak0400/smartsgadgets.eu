    "custom_liquid_4azCVX": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   MEARI TECH SECTION — REMOVE SHOPIFY WHITE GAPS\n   ================================================== */\n\n.shopify-section:has(.sg-meari-tech),\n.shopify-section:has(.sg-meari-tech) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n.shopify-section:has(.sg-meari-tech) .section,\n.shopify-section:has(.sg-meari-tech) .section__inner,\n.shopify-section:has(.sg-meari-tech) .container,\n.shopify-section:has(.sg-meari-tech) .page-width {\n  margin: 0 !important;\n  padding: 0 !important;\n  max-width: none !important;\n}\n\n.sg-meari-tech {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n@media screen and (max-width: 768px) {\n  .shopify-section:has(.sg-meari-tech),\n  .shopify-section:has(.sg-meari-tech) > div {\n    margin: 0 !important;\n    padding: 0 !important;\n    min-height: 0 !important;\n  }\n}\n</style>\n\n<style>\n.sg-meari-tech,\n.sg-meari-tech *{\n  box-sizing:border-box;\n}\n\n.sg-meari-tech{\n  --blue:#1686e8;\n  --blue-light:#43a8ff;\n  --navy:#061326;\n  --navy-2:#0a1f38;\n  --orange:#ff6a13;\n  --text:#ffffff;\n  --muted:#b9cbe0;\n\n  position:relative;\n  overflow:hidden;\n  padding:96px 24px;\n  color:var(--text);\n  background:\n    radial-gradient(circle at 50% 45%, rgba(29,137,239,.24), transparent 34%),\n    radial-gradient(circle at 10% 20%, rgba(21,92,176,.18), transparent 28%),\n    linear-gradient(180deg,#04101f 0%,#07192d 100%);\n  font-family:inherit;\n}\n\n.sg-meari-tech::before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  pointer-events:none;\n  opacity:.12;\n  background-image:\n    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),\n    linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);\n  background-size:48px 48px;\n}\n\n.sg-meari-tech__inner{\n  position:relative;\n  z-index:2;\n  width:min(1280px,100%);\n  margin:0 auto;\n}\n\n.sg-meari-tech__header{\n  max-width:760px;\n  margin:0 auto 54px;\n  text-align:center;\n}\n\n.sg-meari-tech__eyebrow{\n  margin-bottom:14px;\n  color:var(--orange);\n  font-size:13px;\n  font-weight:800;\n  letter-spacing:.14em;\n  text-transform:uppercase;\n}\n\n.sg-meari-tech h2{\n  margin:0 0 18px;\n  color:#fff;\n  font-size:clamp(38px,4.6vw,60px);\n  line-height:1.04;\n  letter-spacing:-.04em;\n  font-weight:850;\n}\n\n.sg-meari-tech h2 span{\n  color:var(--blue-light);\n}\n\n.sg-meari-tech__intro{\n  margin:0;\n  color:var(--muted);\n  font-size:18px;\n  line-height:1.65;\n}\n\n.sg-meari-tech__stage{\n  position:relative;\n  min-height:680px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.sg-meari-tech__glow{\n  position:absolute;\n  width:640px;\n  height:640px;\n  border-radius:50%;\n  background:\n    radial-gradient(circle,rgba(39,151,255,.35) 0%,rgba(13,87,174,.18) 38%,transparent 70%);\n  filter:blur(4px);\n}\n\n.sg-meari-tech__ring{\n  position:absolute;\n  width:520px;\n  height:520px;\n  border:1px solid rgba(77,177,255,.28);\n  border-radius:50%;\n}\n\n.sg-meari-tech__ring::before,\n.sg-meari-tech__ring::after{\n  content:\"\";\n  position:absolute;\n  border:1px solid rgba(77,177,255,.16);\n  border-radius:50%;\n}\n\n.sg-meari-tech__ring::before{\n  inset:55px;\n}\n\n.sg-meari-tech__ring::after{\n  inset:115px;\n}\n\n.sg-meari-tech__product{\n  position:relative;\n  z-index:3;\n  width:min(520px,64vw);\n  max-height:560px;\n  object-fit:contain;\n  filter:drop-shadow(0 38px 40px rgba(0,0,0,.48));\n}\n\n.sg-meari-tech__hotspot{\n  position:absolute;\n  z-index:5;\n  width:245px;\n  padding:17px 18px;\n  display:flex;\n  align-items:flex-start;\n  gap:13px;\n  color:#fff;\n  border:1px solid rgba(78,175,255,.28);\n  border-radius:16px;\n  background:rgba(6,24,44,.82);\n  box-shadow:0 18px 46px rgba(0,0,0,.26);\n  backdrop-filter:blur(14px);\n  transition:\n    transform .25s ease,\n    border-color .25s ease,\n    box-shadow .25s ease;\n}\n\n.sg-meari-tech__hotspot:hover{\n  transform:translateY(-5px);\n  border-color:rgba(66,170,255,.58);\n  box-shadow:\n    0 24px 56px rgba(0,0,0,.32),\n    0 0 32px rgba(22,134,232,.12);\n}\n\n.sg-meari-tech__hotspot-icon{\n  width:42px;\n  height:42px;\n  flex:0 0 auto;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  border-radius:12px;\n  background:rgba(28,126,219,.18);\n  border:1px solid rgba(79,177,255,.26);\n}\n\n.sg-meari-tech__hotspot-icon svg{\n  width:23px;\n  height:23px;\n  fill:none;\n  stroke:var(--blue-light);\n  stroke-width:1.8;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n.sg-meari-tech__hotspot strong{\n  display:block;\n  margin-bottom:5px;\n  font-size:16px;\n  line-height:1.25;\n}\n\n.sg-meari-tech__hotspot span{\n  display:block;\n  color:var(--muted);\n  font-size:13px;\n  line-height:1.45;\n}\n\n.sg-meari-tech__hotspot--ai{\n  top:65px;\n  left:20px;\n}\n\n.sg-meari-tech__hotspot--solar{\n  top:75px;\n  right:20px;\n}\n\n.sg-meari-tech__hotspot--night{\n  left:5px;\n  bottom:115px;\n}\n\n.sg-meari-tech__hotspot--audio{\n  right:5px;\n  bottom:120px;\n}\n\n.sg-meari-tech__hotspot--ptz{\n  left:50%;\n  bottom:18px;\n  transform:translateX(-50%);\n}\n\n.sg-meari-tech__hotspot--ptz:hover{\n  transform:translateX(-50%) translateY(-5px);\n}\n\n.sg-meari-tech__specs{\n  margin-top:28px;\n  display:grid;\n  grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:16px;\n}\n\n.sg-meari-tech__spec{\n  padding:22px 20px;\n  text-align:center;\n  border:1px solid rgba(88,175,255,.18);\n  border-radius:18px;\n  background:rgba(255,255,255,.04);\n}\n\n.sg-meari-tech__spec strong{\n  display:block;\n  margin-bottom:6px;\n  color:#fff;\n  font-size:20px;\n}\n\n.sg-meari-tech__spec span{\n  color:var(--muted);\n  font-size:14px;\n}\n\n@media screen and (max-width:1050px){\n  .sg-meari-tech__stage{\n    min-height:850px;\n  }\n\n  .sg-meari-tech__hotspot--ai{\n    top:40px;\n    left:0;\n  }\n\n  .sg-meari-tech__hotspot--solar{\n    top:40px;\n    right:0;\n  }\n\n  .sg-meari-tech__hotspot--night{\n    left:0;\n    bottom:150px;\n  }\n\n  .sg-meari-tech__hotspot--audio{\n    right:0;\n    bottom:150px;\n  }\n\n  .sg-meari-tech__hotspot--ptz{\n    bottom:20px;\n  }\n}\n\n@media screen and (max-width:760px){\n  .sg-meari-tech{\n    padding:68px 14px;\n  }\n\n  .sg-meari-tech__header{\n    margin-bottom:34px;\n  }\n\n  .sg-meari-tech__intro{\n    font-size:16px;\n  }\n\n  .sg-meari-tech__stage{\n    min-height:auto;\n    display:grid;\n    grid-template-columns:1fr;\n    gap:14px;\n  }\n\n  .sg-meari-tech__glow,\n  .sg-meari-tech__ring{\n    display:none;\n  }\n\n  .sg-meari-tech__product{\n    width:min(420px,88vw);\n    margin:10px auto 24px;\n    order:1;\n  }\n\n  .sg-meari-tech__hotspot{\n    position:relative;\n    inset:auto;\n    width:100%;\n    transform:none;\n  }\n\n  .sg-meari-tech__hotspot:hover,\n  .sg-meari-tech__hotspot--ptz:hover{\n    transform:translateY(-3px);\n  }\n\n  .sg-meari-tech__hotspot--ai{order:2;}\n  .sg-meari-tech__hotspot--solar{order:3;}\n  .sg-meari-tech__hotspot--night{order:4;}\n  .sg-meari-tech__hotspot--audio{order:5;}\n  .sg-meari-tech__hotspot--ptz{order:6;}\n\n  .sg-meari-tech__specs{\n    grid-template-columns:repeat(2,minmax(0,1fr));\n    gap:12px;\n    margin-top:30px;\n  }\n}\n\n@media screen and (max-width:460px){\n  .sg-meari-tech h2{\n    font-size:36px;\n  }\n\n  .sg-meari-tech__hotspot{\n    padding:15px;\n  }\n\n  .sg-meari-tech__specs{\n    grid-template-columns:1fr;\n  }\n}\n</style>\n\n{% liquid\n  assign meari_product = product\n  assign meari_image = meari_product.featured_image\n%}\n\n<section class=\"sg-meari-tech\">\n  <div class=\"sg-meari-tech__inner\">\n\n    <div class=\"sg-meari-tech__header\">\n      <div class=\"sg-meari-tech__eyebrow\">\n        Ontdek de technologie\n      </div>\n\n      <h2>\n        Alles wat u nodig heeft.\n        <span>In één slimme camera.</span>\n      </h2>\n\n      <p class=\"sg-meari-tech__intro\">\n        De MEARI N2 combineert intelligente detectie, brede cameradekking,\n        tweeweg audio en draadloos gebruik in één complete beveiligingsoplossing.\n      </p>\n    </div>\n\n    <div class=\"sg-meari-tech__stage\">\n      <div class=\"sg-meari-tech__glow\"></div>\n      <div class=\"sg-meari-tech__ring\"></div>\n\n      {% if meari_image %}\n        {{\n          meari_image\n          | image_url: width: 1200\n          | image_tag:\n            class: 'sg-meari-tech__product',\n            loading: 'lazy',\n            widths: '420, 620, 820, 1000, 1200',\n            sizes: '(max-width: 760px) 88vw, 520px',\n            alt: meari_product.title\n        }}\n      {% endif %}\n\n      <div class=\"sg-meari-tech__hotspot sg-meari-tech__hotspot--ai\">\n        <div class=\"sg-meari-tech__hotspot-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"7\" r=\"3\"></circle>\n            <path d=\"M6 20c.9-4.2 3-6.3 6-6.3S17.1 15.8 18 20\"></path>\n          </svg>\n        </div>\n        <div>\n          <strong>AI-persoonsdetectie</strong>\n          <span>Gerichtere meldingen wanneer een persoon wordt herkend.</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-tech__hotspot sg-meari-tech__hotspot--solar\">\n        <div class=\"sg-meari-tech__hotspot-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M5 10h14l-1 9H6l-1-9Z\"></path>\n            <path d=\"M8 10l1-5h6l1 5\"></path>\n          </svg>\n        </div>\n        <div>\n          <strong>Solar support</strong>\n          <span>Geschikt voor gebruik met een compatibel zonnepaneel.</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-tech__hotspot sg-meari-tech__hotspot--night\">\n        <div class=\"sg-meari-tech__hotspot-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\"></path>\n            <path d=\"M17 3v4M15 5h4\"></path>\n          </svg>\n        </div>\n        <div>\n          <strong>Full-color nachtzicht</strong>\n          <span>Heldere en kleurrijke beelden in donkere situaties.</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-tech__hotspot sg-meari-tech__hotspot--audio\">\n        <div class=\"sg-meari-tech__hotspot-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"></rect>\n            <path d=\"M5 10a7 7 0 0 0 14 0M12 17v4M9 21h6\"></path>\n          </svg>\n        </div>\n        <div>\n          <strong>Tweeweg audio</strong>\n          <span>Praat en luister rechtstreeks via de mobiele app.</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-tech__hotspot sg-meari-tech__hotspot--ptz\">\n        <div class=\"sg-meari-tech__hotspot-icon\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M4 12a8 8 0 1 0 2.3-5.7\"></path>\n            <path d=\"M4 5v5h5\"></path>\n          </svg>\n        </div>\n        <div>\n          <strong>355° Pan & 90° Tilt</strong>\n          <span>Brede dekking van uw tuin, oprit of entree.</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"sg-meari-tech__specs\">\n      <div class=\"sg-meari-tech__spec\">\n        <strong>3MP</strong>\n        <span>Scherpe beeldkwaliteit</span>\n      </div>\n\n      <div class=\"sg-meari-tech__spec\">\n        <strong>5200mAh</strong>\n        <span>Oplaadbare batterij</span>\n      </div>\n\n      <div class=\"sg-meari-tech__spec\">\n        <strong>IP65</strong>\n        <span>Weerbestendig ontwerp</span>\n      </div>\n\n      <div class=\"sg-meari-tech__spec\">\n        <strong>Cloud + microSD</strong>\n        <span>Flexibele opslagopties</span>\n      </div>\n    </div>\n\n  </div>\n</section>",
