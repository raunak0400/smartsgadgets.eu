      "name": "Custom HTML/Liquid",
      "settings": {
        "custom_liquid": "<style>\n/* ==================================================\n   MEARI LANDING PAGE — REMOVE GAPS BETWEEN SECTIONS\n   ================================================== */\n\n/* Hero section wrapper */\n.shopify-section:has(.sg-meari-hero) {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n}\n\n/* Why MEARI section wrapper */\n.shopify-section:has(.sg-meari-why) {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n}\n\n/* Enterprise theme inner wrappers */\n.shopify-section:has(.sg-meari-hero) > div,\n.shopify-section:has(.sg-meari-why) > div {\n  margin: 0 !important;\n  padding: 0 !important;\n  min-height: 0 !important;\n  max-width: none !important;\n}\n\n/* Common Enterprise containers */\n.shopify-section:has(.sg-meari-hero) .section,\n.shopify-section:has(.sg-meari-hero) .section__inner,\n.shopify-section:has(.sg-meari-hero) .container,\n.shopify-section:has(.sg-meari-hero) .page-width,\n.shopify-section:has(.sg-meari-why) .section,\n.shopify-section:has(.sg-meari-why) .section__inner,\n.shopify-section:has(.sg-meari-why) .container,\n.shopify-section:has(.sg-meari-why) .page-width {\n  margin: 0 !important;\n  padding: 0 !important;\n  max-width: none !important;\n}\n\n/* Custom sections themselves */\n.sg-meari-hero,\n.sg-meari-why {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n/* Remove possible spacing between two consecutive Shopify sections */\n.shopify-section:has(.sg-meari-hero) + .shopify-section:has(.sg-meari-why) {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n}\n\n/* Mobile */\n@media screen and (max-width: 768px) {\n  .shopify-section:has(.sg-meari-hero),\n  .shopify-section:has(.sg-meari-why),\n  .shopify-section:has(.sg-meari-hero) > div,\n  .shopify-section:has(.sg-meari-why) > div {\n    margin: 0 !important;\n    padding: 0 !important;\n    min-height: 0 !important;\n  }\n}\n</style>\n{% liquid\n  assign current_product = product\n  assign current_variant = current_product.selected_or_first_available_variant\n  assign hero_image = current_product.featured_image\n%}\n\n<style>\n  .sg-meari-hero,\n  .sg-meari-hero * {\n    box-sizing: border-box;\n  }\n\n  .sg-meari-hero {\n    --sg-blue: #1686e8;\n    --sg-blue-bright: #2c9cff;\n    --sg-navy: #061326;\n    --sg-navy-light: #0b2340;\n    --sg-orange: #ff6a13;\n    --sg-white: #ffffff;\n    --sg-muted: #c8d7e8;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    color: var(--sg-white);\n    background:\n      radial-gradient(circle at 72% 34%, rgba(30, 139, 255, 0.23), transparent 32%),\n      radial-gradient(circle at 15% 0%, rgba(25, 117, 221, 0.18), transparent 35%),\n      linear-gradient(135deg, #03101f 0%, #071a31 48%, #03101e 100%);\n    font-family: inherit;\n  }\n\n  .sg-meari-hero::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: 0.12;\n    background-image:\n      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);\n    background-size: 42px 42px;\n    mask-image: linear-gradient(to bottom, rgba(0,0,0,.8), transparent 85%);\n  }\n\n  .sg-meari-hero__inner {\n    position: relative;\n    z-index: 2;\n    width: min(1400px, calc(100% - 48px));\n    min-height: 720px;\n    margin: 0 auto;\n    padding: 78px 0 56px;\n    display: grid;\n    grid-template-columns: minmax(0, 0.92fr) minmax(460px, 1.08fr);\n    align-items: center;\n    gap: 60px;\n  }\n\n  .sg-meari-hero__content {\n    position: relative;\n    z-index: 3;\n    max-width: 650px;\n  }\n\n  .sg-meari-hero__eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin-bottom: 19px;\n    color: #a9d7ff;\n    font-size: 13px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .sg-meari-hero__eyebrow::before {\n    content: \"\";\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--sg-orange);\n    box-shadow: 0 0 16px rgba(255,106,19,.85);\n  }\n\n  .sg-meari-hero h1 {\n    margin: 0 0 22px;\n    color: #fff;\n    font-size: clamp(46px, 5vw, 76px);\n    line-height: 0.98;\n    letter-spacing: -0.045em;\n    font-weight: 850;\n  }\n\n  .sg-meari-hero h1 span {\n    display: block;\n    margin-top: 8px;\n    color: var(--sg-blue-bright);\n    text-shadow: 0 0 28px rgba(44,156,255,.20);\n  }\n\n  .sg-meari-hero__description {\n    max-width: 620px;\n    margin: 0 0 28px;\n    color: var(--sg-muted);\n    font-size: 18px;\n    line-height: 1.65;\n  }\n\n  .sg-meari-hero__quick-features {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-bottom: 30px;\n  }\n\n  .sg-meari-hero__quick-feature {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 38px;\n    padding: 8px 14px;\n    color: #e8f5ff;\n    background: rgba(255,255,255,.06);\n    border: 1px solid rgba(117,190,255,.20);\n    border-radius: 999px;\n    font-size: 14px;\n    line-height: 1.2;\n    backdrop-filter: blur(10px);\n  }\n\n  .sg-meari-hero__quick-feature svg {\n    width: 17px;\n    height: 17px;\n    flex: 0 0 auto;\n    stroke: var(--sg-blue-bright);\n  }\n\n  .sg-meari-hero__purchase {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 18px 22px;\n    margin-bottom: 28px;\n  }\n\n  .sg-meari-hero__price-wrap {\n    display: flex;\n    align-items: baseline;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .sg-meari-hero__price {\n    color: #fff;\n    font-size: 40px;\n    line-height: 1;\n    font-weight: 850;\n    letter-spacing: -0.035em;\n  }\n\n  .sg-meari-hero__compare-price {\n    color: #8395aa;\n    font-size: 19px;\n    text-decoration: line-through;\n  }\n\n  .sg-meari-hero__button {\n    appearance: none;\n    min-height: 58px;\n    padding: 15px 30px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    color: #fff;\n    background: linear-gradient(135deg, #ff771f, var(--sg-orange));\n    border: 0;\n    border-radius: 12px;\n    box-shadow: 0 14px 38px rgba(255,106,19,.27);\n    font-family: inherit;\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1;\n    cursor: pointer;\n    transition:\n      transform .22s ease,\n      box-shadow .22s ease,\n      filter .22s ease;\n  }\n\n  .sg-meari-hero__button:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 18px 44px rgba(255,106,19,.36);\n    filter: brightness(1.04);\n  }\n\n  .sg-meari-hero__button svg {\n    width: 20px;\n    height: 20px;\n    stroke: currentColor;\n  }\n\n  .sg-meari-hero__trust {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 13px 24px;\n    color: #d7e8f8;\n    font-size: 14px;\n  }\n\n  .sg-meari-hero__trust-item {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .sg-meari-hero__trust-item svg {\n    width: 18px;\n    height: 18px;\n    stroke: var(--sg-blue-bright);\n  }\n\n  .sg-meari-hero__visual {\n    position: relative;\n    min-height: 610px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    isolation: isolate;\n  }\n\n  .sg-meari-hero__glow {\n    position: absolute;\n    width: 590px;\n    height: 590px;\n    border-radius: 50%;\n    z-index: -2;\n    background:\n      radial-gradient(circle, rgba(33,147,255,.40) 0%, rgba(14,95,190,.20) 34%, transparent 68%);\n    filter: blur(2px);\n  }\n\n  .sg-meari-hero__orbit {\n    position: absolute;\n    width: 490px;\n    height: 490px;\n    border: 1px solid rgba(78,174,255,.24);\n    border-radius: 50%;\n    z-index: -1;\n    transform: rotate(-12deg);\n  }\n\n  .sg-meari-hero__orbit::before,\n  .sg-meari-hero__orbit::after {\n    content: \"\";\n    position: absolute;\n    border-radius: 50%;\n    border: 1px solid rgba(78,174,255,.15);\n  }\n\n  .sg-meari-hero__orbit::before {\n    inset: 54px;\n  }\n\n  .sg-meari-hero__orbit::after {\n    inset: 112px;\n  }\n\n  .sg-meari-hero__product-card {\n    position: relative;\n    width: min(560px, 94%);\n    min-height: 560px;\n    padding: 34px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(108,188,255,.18);\n    border-radius: 34px;\n    background:\n      linear-gradient(145deg, rgba(255,255,255,.10), rgba(255,255,255,.025));\n    box-shadow:\n      0 40px 100px rgba(0,0,0,.42),\n      inset 0 1px 0 rgba(255,255,255,.12);\n    backdrop-filter: blur(16px);\n  }\n\n  .sg-meari-hero__product-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 18px;\n    border-radius: 25px;\n    border: 1px solid rgba(255,255,255,.055);\n    pointer-events: none;\n  }\n\n  .sg-meari-hero__product-image {\n    position: relative;\n    z-index: 2;\n    display: block;\n    width: 100%;\n    max-width: 500px;\n    max-height: 520px;\n    object-fit: contain;\n    filter: drop-shadow(0 34px 32px rgba(0,0,0,.40));\n    transform: translateY(-5px);\n  }\n\n  .sg-meari-hero__badge {\n    position: absolute;\n    z-index: 4;\n    padding: 12px 15px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: #fff;\n    background: rgba(4,18,35,.82);\n    border: 1px solid rgba(65,163,255,.33);\n    border-radius: 13px;\n    box-shadow: 0 16px 35px rgba(0,0,0,.28);\n    backdrop-filter: blur(12px);\n    font-size: 13px;\n    font-weight: 700;\n  }\n\n  .sg-meari-hero__badge svg {\n    width: 22px;\n    height: 22px;\n    stroke: var(--sg-blue-bright);\n  }\n\n  .sg-meari-hero__badge--ai {\n    top: 55px;\n    left: -23px;\n  }\n\n  .sg-meari-hero__badge--solar {\n    right: -26px;\n    bottom: 115px;\n  }\n\n  .sg-meari-hero__badge--night {\n    bottom: 35px;\n    left: 7px;\n  }\n\n  .sg-meari-hero__bottom-bar {\n    position: relative;\n    z-index: 4;\n    border-top: 1px solid rgba(102,181,255,.18);\n    background: linear-gradient(90deg, #0a3973, #086ed0 50%, #0a3973);\n    box-shadow: 0 -18px 50px rgba(4,62,125,.18);\n  }\n\n  .sg-meari-hero__bottom-inner {\n    width: min(1400px, calc(100% - 48px));\n    margin: 0 auto;\n    min-height: 108px;\n    display: grid;\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n\n  .sg-meari-hero__feature {\n    position: relative;\n    padding: 23px 17px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    text-align: left;\n  }\n\n  .sg-meari-hero__feature:not(:last-child)::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    top: 25%;\n    bottom: 25%;\n    width: 1px;\n    background: rgba(255,255,255,.18);\n  }\n\n  .sg-meari-hero__feature svg {\n    width: 31px;\n    height: 31px;\n    flex: 0 0 auto;\n    stroke: #fff;\n  }\n\n  .sg-meari-hero__feature strong {\n    display: block;\n    margin-bottom: 3px;\n    color: #fff;\n    font-size: 14px;\n    line-height: 1.2;\n  }\n\n  .sg-meari-hero__feature span {\n    display: block;\n    color: #d6ecff;\n    font-size: 12px;\n    line-height: 1.35;\n  }\n\n  @media screen and (max-width: 1100px) {\n    .sg-meari-hero__inner {\n      grid-template-columns: 1fr 0.9fr;\n      gap: 32px;\n    }\n\n    .sg-meari-hero__product-card {\n      min-height: 500px;\n    }\n\n    .sg-meari-hero__bottom-inner {\n      grid-template-columns: repeat(3, 1fr);\n    }\n\n    .sg-meari-hero__feature:nth-child(3)::after {\n      display: none;\n    }\n\n    .sg-meari-hero__feature:nth-child(-n+3) {\n      border-bottom: 1px solid rgba(255,255,255,.14);\n    }\n  }\n\n  @media screen and (max-width: 820px) {\n    .sg-meari-hero__inner {\n      width: min(100% - 28px, 680px);\n      min-height: auto;\n      padding: 52px 0 42px;\n      grid-template-columns: 1fr;\n      text-align: center;\n    }\n\n    .sg-meari-hero__content {\n      max-width: 680px;\n      margin: 0 auto;\n    }\n\n    .sg-meari-hero h1 {\n      font-size: clamp(42px, 12vw, 64px);\n    }\n\n    .sg-meari-hero__description {\n      margin-left: auto;\n      margin-right: auto;\n    }\n\n    .sg-meari-hero__quick-features,\n    .sg-meari-hero__purchase,\n    .sg-meari-hero__trust {\n      justify-content: center;\n    }\n\n    .sg-meari-hero__visual {\n      min-height: 520px;\n    }\n\n    .sg-meari-hero__product-card {\n      width: min(540px, 100%);\n      min-height: 500px;\n    }\n\n    .sg-meari-hero__badge--ai {\n      left: 8px;\n    }\n\n    .sg-meari-hero__badge--solar {\n      right: 8px;\n    }\n\n    .sg-meari-hero__bottom-inner {\n      width: 100%;\n    }\n  }\n\n  @media screen and (max-width: 560px) {\n    .sg-meari-hero__inner {\n      width: calc(100% - 24px);\n      padding-top: 38px;\n      gap: 28px;\n    }\n\n    .sg-meari-hero__eyebrow {\n      font-size: 11px;\n    }\n\n    .sg-meari-hero h1 {\n      margin-bottom: 18px;\n      font-size: 42px;\n    }\n\n    .sg-meari-hero__description {\n      font-size: 16px;\n      line-height: 1.55;\n    }\n\n    .sg-meari-hero__quick-features {\n      gap: 8px;\n    }\n\n    .sg-meari-hero__quick-feature {\n      padding: 8px 11px;\n      font-size: 12px;\n    }\n\n    .sg-meari-hero__purchase {\n      flex-direction: column;\n      gap: 16px;\n    }\n\n    .sg-meari-hero__button {\n      width: 100%;\n      max-width: 360px;\n    }\n\n    .sg-meari-hero__visual {\n      min-height: 410px;\n    }\n\n    .sg-meari-hero__product-card {\n      min-height: 390px;\n      padding: 22px;\n      border-radius: 24px;\n    }\n\n    .sg-meari-hero__product-image {\n      max-height: 355px;\n    }\n\n    .sg-meari-hero__glow {\n      width: 390px;\n      height: 390px;\n    }\n\n    .sg-meari-hero__orbit {\n      width: 340px;\n      height: 340px;\n    }\n\n    .sg-meari-hero__badge {\n      padding: 9px 10px;\n      font-size: 10px;\n      border-radius: 10px;\n    }\n\n    .sg-meari-hero__badge svg {\n      width: 17px;\n      height: 17px;\n    }\n\n    .sg-meari-hero__badge--ai {\n      top: 22px;\n      left: -2px;\n    }\n\n    .sg-meari-hero__badge--solar {\n      right: -2px;\n      bottom: 70px;\n    }\n\n    .sg-meari-hero__badge--night {\n      left: 4px;\n      bottom: 18px;\n    }\n\n    .sg-meari-hero__bottom-inner {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .sg-meari-hero__feature {\n      min-height: 105px;\n      padding: 18px 10px;\n      flex-direction: column;\n      text-align: center;\n      gap: 8px;\n    }\n\n    .sg-meari-hero__feature:nth-child(3)::after {\n      display: block;\n    }\n\n    .sg-meari-hero__feature:nth-child(even)::after {\n      display: none;\n    }\n\n    .sg-meari-hero__feature:nth-child(-n+4) {\n      border-bottom: 1px solid rgba(255,255,255,.14);\n    }\n\n    .sg-meari-hero__feature svg {\n      width: 28px;\n      height: 28px;\n    }\n\n    .sg-meari-hero__feature span {\n      display: none;\n    }\n  }\n</style>\n\n<section class=\"sg-meari-hero\" aria-labelledby=\"sg-meari-hero-title\">\n  <div class=\"sg-meari-hero__inner\">\n\n    <div class=\"sg-meari-hero__content\">\n      <div class=\"sg-meari-hero__eyebrow\">\n        MEARI N2 Outdoor AI-beveiligingscamera\n      </div>\n\n      <h1 id=\"sg-meari-hero-title\">\n        Bescherm uw woning.\n        <span>Slimmer dan ooit.</span>\n      </h1>\n\n      <p class=\"sg-meari-hero__description\">\n        Houd dag en nacht controle met slimme persoonsdetectie,\n        automatische tracking, 3MP-beeldkwaliteit en ondersteuning\n        voor zonne-energie.\n      </p>\n\n      <div class=\"sg-meari-hero__quick-features\">\n        <div class=\"sg-meari-hero__quick-feature\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 3l7 3v5c0 4.7-2.9 8.2-7 10-4.1-1.8-7-5.3-7-10V6l7-3Z\" stroke-width=\"1.8\"/>\n            <path d=\"m9 12 2 2 4-4\" stroke-width=\"1.8\"/>\n          </svg>\n          AI-persoonsdetectie\n        </div>\n\n        <div class=\"sg-meari-hero__quick-feature\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 12a8 8 0 1 0 2.3-5.7\" stroke-width=\"1.8\"/>\n            <path d=\"M4 5v5h5\" stroke-width=\"1.8\"/>\n          </svg>\n          355° PTZ-dekking\n        </div>\n\n        <div class=\"sg-meari-hero__quick-feature\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 7h16v10H4z\" stroke-width=\"1.8\"/>\n            <path d=\"M9 17v2m6-2v2M8 4h8\" stroke-width=\"1.8\"/>\n          </svg>\n          Solar support\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__purchase\">\n        <div class=\"sg-meari-hero__price-wrap\">\n          <span class=\"sg-meari-hero__price\">\n            {{ current_variant.price | money }}\n          </span>\n\n          {% if current_variant.compare_at_price > current_variant.price %}\n            <span class=\"sg-meari-hero__compare-price\">\n              {{ current_variant.compare_at_price | money }}\n            </span>\n          {% endif %}\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"sg-meari-hero__button\"\n          data-sg-meari-buy\n        >\n          Bestel nu\n\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 12h14M13 6l6 6-6 6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </button>\n      </div>\n\n      <div class=\"sg-meari-hero__trust\">\n        <div class=\"sg-meari-hero__trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 7h11v10H3zM14 10h4l3 3v4h-7z\" stroke-width=\"1.8\"/>\n            <circle cx=\"7\" cy=\"18\" r=\"2\" stroke-width=\"1.8\"/>\n            <circle cx=\"18\" cy=\"18\" r=\"2\" stroke-width=\"1.8\"/>\n          </svg>\n          Gratis verzending\n        </div>\n\n        <div class=\"sg-meari-hero__trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 12a8 8 0 1 0 3-6.2\" stroke-width=\"1.8\"/>\n            <path d=\"M4 4v5h5\" stroke-width=\"1.8\"/>\n          </svg>\n          60 dagen retour\n        </div>\n\n        <div class=\"sg-meari-hero__trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 3l7 3v5c0 4.7-2.9 8.2-7 10-4.1-1.8-7-5.3-7-10V6l7-3Z\" stroke-width=\"1.8\"/>\n            <path d=\"m9 12 2 2 4-4\" stroke-width=\"1.8\"/>\n          </svg>\n          2 jaar garantie\n        </div>\n      </div>\n    </div>\n\n    <div class=\"sg-meari-hero__visual\">\n      <div class=\"sg-meari-hero__glow\"></div>\n      <div class=\"sg-meari-hero__orbit\"></div>\n\n      <div class=\"sg-meari-hero__product-card\">\n        {% if hero_image %}\n          {{\n            hero_image\n            | image_url: width: 1200\n            | image_tag:\n              class: 'sg-meari-hero__product-image',\n              loading: 'eager',\n              fetchpriority: 'high',\n              widths: '420, 620, 820, 1000, 1200',\n              sizes: '(max-width: 820px) 88vw, 48vw',\n              alt: current_product.title\n          }}\n        {% else %}\n          {{ 'product-1' | placeholder_svg_tag: 'sg-meari-hero__product-image' }}\n        {% endif %}\n\n        <div class=\"sg-meari-hero__badge sg-meari-hero__badge--ai\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <circle cx=\"12\" cy=\"8\" r=\"3\" stroke-width=\"1.8\"/>\n            <path d=\"M6 20c.8-4 2.8-6 6-6s5.2 2 6 6\" stroke-width=\"1.8\"/>\n          </svg>\n          Slimme AI-detectie\n        </div>\n\n        <div class=\"sg-meari-hero__badge sg-meari-hero__badge--solar\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 11h14l-1 8H6l-1-8Z\" stroke-width=\"1.8\"/>\n            <path d=\"M8 11 9 6h6l1 5M12 2v2M4.9 4.9l1.4 1.4M19.1 4.9l-1.4 1.4\" stroke-width=\"1.8\"/>\n          </svg>\n          Solar support\n        </div>\n\n        <div class=\"sg-meari-hero__badge sg-meari-hero__badge--night\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\" stroke-width=\"1.8\"/>\n          </svg>\n          Full-color nachtzicht\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"sg-meari-hero__bottom-bar\">\n    <div class=\"sg-meari-hero__bottom-inner\">\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <circle cx=\"12\" cy=\"8\" r=\"3\" stroke-width=\"1.7\"/>\n          <path d=\"M6 20c.8-4 2.8-6 6-6s5.2 2 6 6\" stroke-width=\"1.7\"/>\n        </svg>\n        <div>\n          <strong>AI-detectie</strong>\n          <span>Detecteert personen</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M4 12a8 8 0 1 0 2.3-5.7\" stroke-width=\"1.7\"/>\n          <path d=\"M4 5v5h5\" stroke-width=\"1.7\"/>\n        </svg>\n        <div>\n          <strong>Auto Tracking</strong>\n          <span>Volgt beweging</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\" stroke-width=\"1.7\"/>\n          <text x=\"12\" y=\"14.5\" text-anchor=\"middle\" fill=\"currentColor\" stroke=\"none\" font-size=\"6\">3MP</text>\n        </svg>\n        <div>\n          <strong>3MP HD</strong>\n          <span>Scherpe beeldkwaliteit</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z\" stroke-width=\"1.7\"/>\n          <path d=\"M17 4v4M15 6h4\" stroke-width=\"1.7\"/>\n        </svg>\n        <div>\n          <strong>Kleurnachtzicht</strong>\n          <span>Helder in het donker</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M8 3h8v18H8zM5 7h3m8 0h3M5 12h3m8 0h3M5 17h3m8 0h3\" stroke-width=\"1.7\"/>\n        </svg>\n        <div>\n          <strong>Solar support</strong>\n          <span>Minder vaak opladen</span>\n        </div>\n      </div>\n\n      <div class=\"sg-meari-hero__feature\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <rect x=\"9\" y=\"3\" width=\"6\" height=\"12\" rx=\"3\" stroke-width=\"1.7\"/>\n          <path d=\"M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6\" stroke-width=\"1.7\"/>\n        </svg>\n        <div>\n          <strong>Tweeweg audio</strong>\n          <span>Luisteren en spreken</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n  (function () {\n    function initializeMeariHero() {\n      document.querySelectorAll('[data-sg-meari-buy]').forEach(function (button) {\n        if (button.dataset.initialized === 'true') return;\n\n        button.dataset.initialized = 'true';\n\n        button.addEventListener('click', function () {\n          var target =\n            document.querySelector('product-form') ||\n            document.querySelector('form[action*=\"/cart/add\"]') ||\n            document.querySelector('.product-form') ||\n            document.querySelector('.buy-buttons') ||\n            document.querySelector('button[name=\"add\"]');\n\n          if (!target) {\n            window.scrollTo({\n              top: document.body.scrollHeight * 0.25,\n              behavior: 'smooth'\n            });\n            return;\n          }\n\n          target.scrollIntoView({\n            behavior: 'smooth',\n            block: 'center'\n          });\n\n          window.setTimeout(function () {\n            var addButton = target.matches('button[name=\"add\"]')\n              ? target\n              : target.querySelector('button[name=\"add\"]');\n\n            if (addButton) {\n              addButton.focus({ preventScroll: true });\n            }\n          }, 650);\n        });\n      });\n    }\n\n    document.addEventListener('DOMContentLoaded', initializeMeariHero);\n    document.addEventListener('shopify:section:load', initializeMeariHero);\n    initializeMeariHero();\n  })();\n</script>",
