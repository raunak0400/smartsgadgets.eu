{%- liquid
  assign faq_count = 0
  for i in (1..8)
    assign question_key = 'question_' | append: i
    assign answer_key = 'answer_' | append: i
    if section.settings[question_key] != blank and section.settings[answer_key] != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}

{%- if faq_count > 0 -%}
  <div class="section">
    <div class="container">
      {%- if section.settings.heading != blank -%}
        <h2 class="h4 section__heading text-start mb-6">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- for i in (1..8) -%}
        {%- liquid
          assign question_key = 'question_' | append: i
          assign answer_key = 'answer_' | append: i
          assign question = section.settings[question_key]
          assign answer = section.settings[answer_key]
        -%}
        {%- if question != blank and answer != blank -%}
          <details-disclosure>
            <details class="disclosure disclosure--row">
              <summary>
                <div class="flex justify-between items-center">
                  <h3 class="disclosure__title font-body font-bold text-body flex flex-auto items-center mb-0">
                    {{ question | escape }}
                  </h3>
                  <span class="disclosure__toggle">
                    {%- if settings.disclosure_toggle == 'plus' -%}
                      {% render 'icon-plus' %}
                    {%- else -%}
                      {% render 'icon-chevron-down' %}
                    {%- endif -%}
                  </span>
                </div>
              </summary>
              <div class="disclosure__panel has-motion">
                <div class="disclosure__content rte">
                  {{ answer }}
                </div>
              </div>
            </details>
          </details-disclosure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

