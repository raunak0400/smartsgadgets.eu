{%- style -%}
  #shopify-section-{{ section.id }} .sg-brands {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 56px 48px;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .sg-brands__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .sg-brands__heading {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-brands__view-all {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    border: 1px solid #cccccc;
    border-radius: 999px;
    color: #111111;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sg-brands__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .sg-brands__card {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 220 / 130;
    background-color: #00253d;
    border-radius: 8px;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .sg-brands__logo {
    max-width: 100%;
    max-height: 40px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-brands__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-brands {
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .sg-brands__heading {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .sg-brands__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div class="sg-brands">
  <div class="sg-brands__header">
    <h2 class="sg-brands__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="sg-brands__view-all">View All</a>
    {%- endif -%}
  </div>

  <ul class="sg-brands__grid">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="sg-brands__card">
          {%- if block.settings.logo != blank -%}
            {% render 'image',
              image: block.settings.logo,
              widths: '160, 240, 320',
              src_width: 320,
              sizes: '160px',
              class: 'sg-brands__logo'
            %}
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Brands",
  "tag": "section",
  "class": "cc-custom-brands",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Brands"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Brands",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
