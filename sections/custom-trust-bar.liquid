{%- style -%}
  #shopify-section-{{ section.id }} .sg-trust-bar {
    background-color: #001122;
    padding: 28px 48px;
  }

  #shopify-section-{{ section.id }} .sg-trust-bar__list {
    width: min(1280px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sg-trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sg-trust-bar__item svg {
    width: 26px;
    height: 26px;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-trust-bar__item span {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-trust-bar__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-trust-bar {
      padding: 24px 20px;
    }

    #shopify-section-{{ section.id }} .sg-trust-bar__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .sg-trust-bar__item span {
      font-size: 12px;
    }
  }
{%- endstyle -%}

<div class="sg-trust-bar">
  <ul class="sg-trust-bar__list">
    {%- for block in section.blocks -%}
      <li class="sg-trust-bar__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="14" height="10"/><path d="M15 10h4l4 4v3h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>
          {%- when 'lock' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          {%- when 'return' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="1"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M9 13l3-2 3 2"/></svg>
          {%- when 'badge-check' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 1.4 2.7-.3 1.1 2.5 2.5 1.1-.3 2.7L22 12l-1.4 2.4.3 2.7-2.5 1.1-1.1 2.5-2.7-.3L12 22l-2.4-1.4-2.7.3-1.1-2.5-2.5-1.1.3-2.7L2 12l1.4-2.4-.3-2.7 2.5-1.1 1.1-2.5 2.7.3z"/><path d="M9 12l2 2 4-4"/></svg>
          {%- when 'ribbon' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M9 13.5 7 22l5-3 5 3-2-8.5"/></svg>
          {%- when 'headset' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="2" y="13" width="5" height="7" rx="1.5"/><rect x="17" y="13" width="5" height="7" rx="1.5"/><path d="M20 20a4 4 0 0 1-4 4h-2"/></svg>
        {%- endcase -%}
        <span>{{ block.settings.label }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Trust bar",
  "tag": "section",
  "class": "cc-custom-trust-bar",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "return", "label": "Return" },
            { "value": "badge-check", "label": "Badge check" },
            { "value": "ribbon", "label": "Ribbon" },
            { "value": "headset", "label": "Headset" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Fast EU Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "label": "Fast EU Delivery" } },
        { "type": "item", "settings": { "icon": "lock", "label": "Secure Payments" } },
        { "type": "item", "settings": { "icon": "return", "label": "Easy Returns" } },
        { "type": "item", "settings": { "icon": "badge-check", "label": "Product Warranty" } },
        { "type": "item", "settings": { "icon": "ribbon", "label": "Genuine Products" } },
        { "type": "item", "settings": { "icon": "headset", "label": "Customer Support" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
