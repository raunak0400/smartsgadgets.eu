{% comment %}
GP Premium Hero v1
Starter reusable hero section.
{% endcomment %}

<section class="gp-hero" style="background: {{ section.settings.background }};">
  <div class="gp-container">
    <div class="gp-left">
      {% if section.settings.badge != blank %}
      <div class="gp-badge">{{ section.settings.badge }}</div>
      {% endif %}

      <h1>{{ section.settings.heading }}</h1>

      <div class="gp-desc">{{ section.settings.description }}</div>

      <div class="gp-buttons">
        {% if section.settings.button_text != blank %}
        <a class="gp-btn gp-btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
        {% endif %}
        {% if section.settings.button2_text != blank %}
        <a class="gp-btn gp-btn-secondary" href="{{ section.settings.button2_link }}">{{ section.settings.button2_text }}</a>
        {% endif %}
      </div>
    </div>

    <div class="gp-right">
      {% if section.settings.hero_image %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1800 }}"
        alt="{{ section.settings.heading }}"
        width="900"
        height="900"
        loading="eager">
      {% endif %}
    </div>
  </div>
</section>

<style>
.gp-hero{padding:80px 20px}
.gp-container{max-width:1400px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.gp-badge{display:inline-block;background:#0A6CFF;color:#fff;padding:8px 18px;border-radius:999px;font-weight:700;margin-bottom:20px}
.gp-left h1{font-size:56px;line-height:1.1;margin:0 0 20px}
.gp-desc{font-size:18px;line-height:1.8;margin-bottom:30px}
.gp-buttons{display:flex;gap:15px;flex-wrap:wrap}
.gp-btn{text-decoration:none;padding:16px 30px;border-radius:12px;font-weight:700}
.gp-btn-primary{background:#0A6CFF;color:#fff}
.gp-btn-secondary{border:2px solid #0A6CFF;color:#0A6CFF}
.gp-right img{width:100%;border-radius:24px;display:block}
@media(max-width:991px){
.gp-container{grid-template-columns:1fr}
.gp-left{text-align:center}
.gp-left h1{font-size:38px}
}
</style>

{% schema %}
{
  "name":"GP • Premium Hero",
  "settings":[
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"text","id":"badge","label":"Badge","default":"Nieuw"},
    {"type":"text","id":"heading","label":"Heading","default":"Premium Hero"},
    {"type":"textarea","id":"description","label":"Description","default":"Beschrijving"},
    {"type":"text","id":"button_text","label":"Primary button","default":"Bestel nu"},
    {"type":"url","id":"button_link","label":"Primary link"},
    {"type":"text","id":"button2_text","label":"Secondary button","default":"Meer informatie"},
    {"type":"url","id":"button2_link","label":"Secondary link"},
    {"type":"color","id":"background","label":"Background","default":"#F7FAFF"}
  ],
  "presets":[{"name":"GP • Premium Hero"}]
}
{% endschema %}
