{%- style -%}
  #shopify-section-{{ section.id }} .sg-categories {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 56px 48px;
  }

  #shopify-section-{{ section.id }} .sg-categories__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .sg-categories__heading {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-categories__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 24px * 3) / 4);
    grid-template-columns: unset;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .sg-categories__grid::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .sg-categories__grid > li {
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .sg-categories__card {
    display: block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sg-categories__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.35;
    overflow: hidden;
    border-radius: 4px;
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-categories__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .sg-categories__label {
    margin-top: 14px;
    font-size: 16px;
    font-weight: 500;
    color: #111111;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-categories__grid {
      grid-auto-columns: calc((100% - 24px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-categories {
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .sg-categories__heading {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .sg-categories__grid {
      grid-auto-columns: calc((100% - 16px) / 2.15);
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .sg-categories__label {
      font-size: 14px;
      margin-top: 10px;
    }
  }
{%- endstyle -%}

<div class="sg-categories">
  <div class="sg-categories__header">
    <h2 class="sg-categories__heading">{{ section.settings.heading }}</h2>
  </div>

  <ul class="sg-categories__grid" id="{{ section.id }}-grid">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="sg-categories__card">
          <span class="sg-categories__media">
            {%- if block.settings.image != blank -%}
              {% render 'image',
                image: block.settings.image,
                widths: '300, 450, 600',
                src_width: 600,
                sizes: '(max-width: 749px) 50vw, 25vw',
                class: 'img-fit'
              %}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'img-fit' }}
            {%- endif -%}
          </span>
          <span class="sg-categories__label">{{ block.settings.label }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Categories",
  "tag": "section",
  "class": "cc-custom-categories",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse By Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Categories",
      "blocks": [
        { "type": "category", "settings": { "label": "Smart Home" } },
        { "type": "category", "settings": { "label": "Pet Tech" } },
        { "type": "category", "settings": { "label": "Security" } },
        { "type": "category", "settings": { "label": "Outdoor & Travel" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
