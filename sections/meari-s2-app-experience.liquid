{% comment %}
  SmartGadgets.eu — MEARI S2 Plus
  Rebuilt App Experience Section
  File: meari-s2-app-experience.liquid
{% endcomment %}

<section
  id="sg-s2-app-{{ section.id }}"
  class="sg-s2-app"
  style="
    --sg-app-padding-top: {{ section.settings.padding_top }}px;
    --sg-app-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sg-s2-app__inner">

    <div class="sg-s2-app__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '480, 720, 960, 1200, 1500, 1800',
            sizes: '(min-width: 1100px) 58vw, 100vw',
            class: 'sg-s2-app__image',
            alt: section.settings.image.alt
        }}
      {% else %}
        <div class="sg-s2-app__placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <div class="sg-s2-app__content">
      {% if section.settings.eyebrow != blank %}
        <p class="sg-s2-app__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="sg-s2-app__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="sg-s2-app__features">
        {% for block in section.blocks %}
          <div class="sg-s2-app__feature" {{ block.shopify_attributes }}>
            <div class="sg-s2-app__feature-icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'live' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="7" y="10" width="34" height="26" rx="5" stroke="currentColor" stroke-width="2.4"/>
                    <path d="M19 39h10M24 36v3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <circle cx="24" cy="23" r="5" stroke="currentColor" stroke-width="2.4"/>
                  </svg>
                {% when 'alert' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <path d="M14 35h20l-3-5V21a7 7 0 0 0-14 0v9l-3 5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M21 39h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                  </svg>
                {% when 'audio' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <path d="M24 29a6 6 0 0 0 6-6v-7a6 6 0 0 0-12 0v7a6 6 0 0 0 6 6Z" stroke="currentColor" stroke-width="2.4"/>
                    <path d="M13 23a11 11 0 0 0 22 0M24 34v6M18 40h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                  </svg>
                {% when 'ptz' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <path d="M12 19a14 14 0 0 1 22-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="m34 9 .5 7-7 .5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M36 29a14 14 0 0 1-22 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="m14 39-.5-7 7-.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'playback' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.4"/>
                    <path d="m21 18 9 6-9 6V18Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                  </svg>
                {% when 'remote' %}
                  <svg viewBox="0 0 48 48" fill="none">
                    <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2.4"/>
                    <path d="M9 24h30M24 9c4 4 6 9 6 15s-2 11-6 15M24 9c-4 4-6 9-6 15s2 11 6 15" stroke="currentColor" stroke-width="2.4"/>
                  </svg>
              {% endcase %}
            </div>

            <div class="sg-s2-app__feature-copy">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="sg-s2-app__feature-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="sg-s2-app__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

  </div>
</section>

<style>
  #sg-s2-app-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--sg-app-padding-top) 0 var(--sg-app-padding-bottom);
    background:
      radial-gradient(circle at 82% 18%, rgba(31, 145, 255, .14), transparent 31%),
      radial-gradient(circle at 15% 72%, rgba(16, 91, 170, .12), transparent 26%),
      linear-gradient(180deg, #061326 0%, #0a1c31 100%);
    color: #fff;
  }

  #sg-s2-app-{{ section.id }} *,
  #sg-s2-app-{{ section.id }} *::before,
  #sg-s2-app-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__inner {
    width: min(1480px, calc(100% - 56px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(420px, .85fr);
    gap: clamp(34px, 4vw, 64px);
    align-items: start;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 30px;
    background: #10233c;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, .28),
      0 0 70px rgba(30, 145, 255, .08);
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: inherit;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__image,
  #sg-s2-app-{{ section.id }} .sg-s2-app__placeholder,
  #sg-s2-app-{{ section.id }} .placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__image {
    object-fit: cover;
    object-position: center;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__content {
    padding-top: 8px;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__eyebrow {
    margin: 0 0 14px !important;
    color: #4cabff !important;
    font-size: 14px !important;
    line-height: 1.2 !important;
    font-weight: 850 !important;
    letter-spacing: .19em !important;
    text-transform: uppercase;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__content h2 {
    margin: 0 !important;
    color: #fff !important;
    font-size: clamp(42px, 4vw, 68px) !important;
    line-height: 1.02 !important;
    letter-spacing: -.045em !important;
    font-weight: 800 !important;
    text-transform: none !important;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__text {
    max-width: 650px;
    margin-top: 22px !important;
    color: rgba(226,237,249,.76) !important;
    font-size: clamp(17px, 1.3vw, 20px) !important;
    line-height: 1.62 !important;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__text p,
  #sg-s2-app-{{ section.id }} .sg-s2-app__feature-text p {
    margin: 0 !important;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__features {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature {
    min-height: 116px;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: start;
    padding: 19px;
    border: 1px solid rgba(91,174,255,.18);
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255,255,255,.065), rgba(255,255,255,.035));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.035);
    transition: transform .28s ease, border-color .28s ease, background .28s ease;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature:hover {
    transform: translateY(-4px);
    border-color: rgba(91,174,255,.42);
    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.05));
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 15px;
    color: #43a9ff;
    background: rgba(60,165,255,.11);
    border: 1px solid rgba(60,165,255,.24);
    box-shadow: 0 10px 24px rgba(28,140,243,.08);
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature-icon svg {
    width: 29px;
    height: 29px;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature h3 {
    margin: 1px 0 6px !important;
    color: #fff !important;
    font-size: 18px !important;
    line-height: 1.2 !important;
    font-weight: 760 !important;
    text-transform: none !important;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__feature-text {
    color: rgba(222,234,247,.68) !important;
    font-size: 14px !important;
    line-height: 1.48 !important;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__button {
    margin-top: 26px;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border-radius: 999px;
    background: #168fff;
    color: #fff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 760;
    box-shadow: 0 16px 35px rgba(22,143,255,.26);
    transition: transform .3s ease, box-shadow .3s ease;
  }

  #sg-s2-app-{{ section.id }} .sg-s2-app__button:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 44px rgba(22,143,255,.34);
  }

  @media (max-width: 1120px) {
    #sg-s2-app-{{ section.id }} .sg-s2-app__inner {
      width: min(100% - 40px, 980px);
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #sg-s2-app-{{ section.id }} .sg-s2-app__content {
      padding-top: 0;
    }
  }

  @media (max-width: 680px) {
    #sg-s2-app-{{ section.id }} .sg-s2-app__inner {
      width: calc(100% - 26px);
      gap: 28px;
    }

    #sg-s2-app-{{ section.id }} .sg-s2-app__media {
      aspect-ratio: 4 / 3;
      border-radius: 22px;
    }

    #sg-s2-app-{{ section.id }} .sg-s2-app__features {
      grid-template-columns: 1fr;
      gap: 11px;
      margin-top: 26px;
    }

    #sg-s2-app-{{ section.id }} .sg-s2-app__feature {
      min-height: auto;
      padding: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sg-s2-app-{{ section.id }} .sg-s2-app__feature,
    #sg-s2-app-{{ section.id }} .sg-s2-app__button {
      transition: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "MEARI S2 app ervaring",
  "tag": "section",
  "class": "section-meari-s2-app",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hoofdafbeelding"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine titel",
      "default": "ALTIJD VERBONDEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hoofdtitel",
      "default": "Altijd verbonden met uw woning"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschrijving",
      "default": "<p>Bekijk livebeelden, ontvang bewegingsmeldingen en controleer wie er voor uw deur staat — waar u ook bent.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Bekijk de MEARI S2 Plus"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knoplink"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Ruimte boven",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Ruimte onder",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "App-functie",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "default": "live",
          "options": [
            { "value": "live", "label": "Livebeeld" },
            { "value": "alert", "label": "Melding" },
            { "value": "audio", "label": "Audio" },
            { "value": "ptz", "label": "PTZ" },
            { "value": "playback", "label": "Opnames" },
            { "value": "remote", "label": "Op afstand" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Live meekijken"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Korte tekst",
          "default": "<p>Bekijk direct wat er rondom uw woning gebeurt.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "MEARI S2 app ervaring",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "live",
            "title": "Live meekijken",
            "text": "<p>Bekijk direct wat er rondom uw woning gebeurt.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "alert",
            "title": "Directe meldingen",
            "text": "<p>Ontvang snel een melding wanneer beweging wordt gedetecteerd.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "audio",
            "title": "Tweeweg audio",
            "text": "<p>Luister en spreek rechtstreeks met bezoekers.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "ptz",
            "title": "PTZ-bediening",
            "text": "<p>Beweeg de camera eenvoudig via de app.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "playback",
            "title": "Opnames terugkijken",
            "text": "<p>Bekijk belangrijke momenten later opnieuw.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "remote",
            "title": "Controle vanaf elke locatie",
            "text": "<p>Blijf verbonden, thuis of onderweg.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
