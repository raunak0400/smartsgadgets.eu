{% comment %}
  SmartGadgets.eu — MEARI S2 Plus
  Section 04 — Premium Feature Grid
  File name: meari-s2-features.liquid
{% endcomment %}

<section
  id="sg-s2-features-{{ section.id }}"
  class="sg-s2-features"
  style="--sg-top-space: {{ section.settings.padding_top }}px; --sg-bottom-space: {{ section.settings.padding_bottom }}px;"
>
  <div class="sg-s2-features__inner">
    <header class="sg-s2-features__header">
      {% if section.settings.eyebrow != blank %}<p class="sg-s2-features__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="sg-s2-features__intro">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="sg-s2-features__grid">
      {% for block in section.blocks %}
        <article class="sg-s2-feature-card" {{ block.shopify_attributes }}>
          <div class="sg-s2-feature-card__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'resolution' %}
                <svg viewBox="0 0 64 64" fill="none"><rect x="10" y="15" width="44" height="34" rx="6" stroke="currentColor" stroke-width="2.6"/><path d="M18 42 29 31l8 8 6-6 7 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="42" cy="25" r="4" stroke="currentColor" stroke-width="2.6"/></svg>
              {% when 'ai' %}
                <svg viewBox="0 0 64 64" fill="none"><path d="M32 11c10 0 18 7.2 18 17 0 6.8-3.3 11.2-8.4 14.9-2 1.5-3.2 3.8-3.2 6.3V52H25.6v-2.8c0-2.5-1.2-4.8-3.2-6.3C17.3 39.2 14 34.8 14 28c0-9.8 8-17 18-17Z" stroke="currentColor" stroke-width="2.6"/><path d="M23 28h18M27 22v12M37 22v12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M22 53h20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
              {% when 'night' %}
                <svg viewBox="0 0 64 64" fill="none"><path d="M42 47A20 20 0 0 1 24.8 12.2 21 21 0 1 0 42 47Z" stroke="currentColor" stroke-width="2.7" stroke-linejoin="round"/><path d="m46 14 1.6 4.2 4.4 1.6-4.4 1.6L46 26l-1.6-4.6-4.4-1.6 4.4-1.6L46 14Z" fill="currentColor"/></svg>
              {% when 'ptz' %}
                <svg viewBox="0 0 64 64" fill="none"><path d="M14 24a19 19 0 0 1 31-8" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/><path d="m45 10 .8 8.5-8.5.8" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M50 40a19 19 0 0 1-31 8" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/><path d="m19 54-.8-8.5 8.5-.8" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="32" r="7" stroke="currentColor" stroke-width="2.6"/></svg>
              {% when 'audio' %}
                <svg viewBox="0 0 64 64" fill="none"><path d="M32 39c6.1 0 11-4.9 11-11V18a11 11 0 0 0-22 0v10c0 6.1 4.9 11 11 11Z" stroke="currentColor" stroke-width="2.7"/><path d="M14 28c0 9.9 8.1 18 18 18s18-8.1 18-18M32 46v8M24 54h16" stroke="currentColor" stroke-width="2.7" stroke-linecap="round"/></svg>
              {% when 'solar' %}
                <svg viewBox="0 0 64 64" fill="none"><circle cx="44" cy="18" r="7" stroke="currentColor" stroke-width="2.6"/><path d="M44 6V3M44 33v-3M56 18h3M29 18h3M52.5 9.5l2-2M33.5 28.5l2-2M52.5 26.5l2 2M33.5 7.5l2 2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M10 28h28l-4 23H14l-4-23Z" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/><path d="M15 35h18M13.5 42h18.5M23 28l-2 23M30 28l-2 23" stroke="currentColor" stroke-width="2.2"/></svg>
            {% endcase %}
          </div>
          {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.text != blank %}<div class="sg-s2-feature-card__text">{{ block.settings.text }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
#sg-s2-features-{{ section.id }}{--sg-blue:#168fff;--sg-ink:#071426;--sg-muted:#5d6b7c;position:relative;overflow:hidden;padding:var(--sg-top-space) 0 var(--sg-bottom-space);background:radial-gradient(circle at 16% 12%,rgba(22,143,255,.07),transparent 28%),linear-gradient(180deg,#fff 0%,#f7faff 100%);color:var(--sg-ink)}
#sg-s2-features-{{ section.id }} *,#sg-s2-features-{{ section.id }} *::before,#sg-s2-features-{{ section.id }} *::after{box-sizing:border-box}
#sg-s2-features-{{ section.id }} .sg-s2-features__inner{width:min(1420px,calc(100% - 64px));margin:0 auto}
#sg-s2-features-{{ section.id }} .sg-s2-features__header{max-width:860px;margin:0 auto 52px;text-align:center}
#sg-s2-features-{{ section.id }} .sg-s2-features__eyebrow{margin:0 0 15px!important;color:var(--sg-blue)!important;font-size:14px!important;line-height:1.2!important;font-weight:850!important;letter-spacing:.2em!important;text-transform:uppercase}
#sg-s2-features-{{ section.id }} .sg-s2-features__header h2{margin:0!important;color:var(--sg-ink)!important;font-size:clamp(40px,4.5vw,72px)!important;line-height:1.02!important;letter-spacing:-.047em!important;font-weight:790!important;text-transform:none!important}
#sg-s2-features-{{ section.id }} .sg-s2-features__intro{max-width:760px;margin:24px auto 0!important;color:var(--sg-muted)!important;font-size:clamp(17px,1.35vw,21px)!important;line-height:1.62!important}
#sg-s2-features-{{ section.id }} .sg-s2-features__intro p,#sg-s2-features-{{ section.id }} .sg-s2-feature-card__text p{margin:0!important}
#sg-s2-features-{{ section.id }} .sg-s2-features__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card{position:relative;min-height:280px;padding:34px;overflow:hidden;border:1px solid rgba(27,102,173,.12);border-radius:24px;background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(247,250,255,.98));box-shadow:0 18px 45px rgba(15,54,93,.08);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease,border-color .35s ease}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card::after{content:"";position:absolute;right:-60px;bottom:-60px;width:170px;height:170px;border-radius:50%;background:radial-gradient(circle,rgba(22,143,255,.12),transparent 68%);transition:transform .35s ease}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card:hover{transform:translateY(-8px);border-color:rgba(22,143,255,.28);box-shadow:0 28px 65px rgba(15,69,118,.14)}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card:hover::after{transform:scale(1.16)}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card__icon{position:relative;z-index:2;width:78px;height:78px;margin-bottom:26px;display:grid;place-items:center;border:1px solid rgba(22,143,255,.2);border-radius:22px;color:var(--sg-blue);background:linear-gradient(145deg,rgba(233,246,255,.96),rgba(244,249,255,.96));box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 14px 30px rgba(22,143,255,.11);transition:transform .35s ease,box-shadow .35s ease}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card:hover .sg-s2-feature-card__icon{transform:translateY(-3px) scale(1.03);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 18px 38px rgba(22,143,255,.18)}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card__icon svg{width:44px;height:44px}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card h3{position:relative;z-index:2;margin:0 0 12px!important;color:var(--sg-ink)!important;font-size:clamp(25px,2vw,34px)!important;line-height:1.08!important;letter-spacing:-.035em!important;font-weight:760!important;text-transform:none!important}
#sg-s2-features-{{ section.id }} .sg-s2-feature-card__text{position:relative;z-index:2;margin:0!important;color:var(--sg-muted)!important;font-size:16px!important;line-height:1.6!important}
@media(max-width:980px){#sg-s2-features-{{ section.id }} .sg-s2-features__inner{width:min(100% - 40px,900px)}#sg-s2-features-{{ section.id }} .sg-s2-features__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){#sg-s2-features-{{ section.id }} .sg-s2-features__inner{width:calc(100% - 26px)}#sg-s2-features-{{ section.id }} .sg-s2-features__header{margin-bottom:34px}#sg-s2-features-{{ section.id }} .sg-s2-features__grid{grid-template-columns:1fr;gap:14px}#sg-s2-features-{{ section.id }} .sg-s2-feature-card{min-height:auto;padding:27px 23px;border-radius:20px}#sg-s2-features-{{ section.id }} .sg-s2-feature-card__icon{width:66px;height:66px;margin-bottom:21px;border-radius:18px}#sg-s2-features-{{ section.id }} .sg-s2-feature-card__icon svg{width:38px;height:38px}}
@media(prefers-reduced-motion:reduce){#sg-s2-features-{{ section.id }} .sg-s2-feature-card,#sg-s2-features-{{ section.id }} .sg-s2-feature-card__icon{transition:none!important}}
</style>

{% schema %}
{
  "name": "MEARI S2 kenmerken",
  "tag": "section",
  "class": "section-meari-s2-features",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Kleine titel","default":"SLIMME TECHNOLOGIE"},
    {"type":"text","id":"heading","label":"Hoofdtitel","default":"Alles wat u nodig heeft. Eén slimme beveiligingscamera."},
    {"type":"richtext","id":"intro","label":"Introductietekst","default":"<p>De MEARI S2 Plus combineert hoogwaardige beeldkwaliteit, kunstmatige intelligentie en eenvoudige installatie in één krachtige beveiligingscamera voor uw woning.</p>"},
    {"type":"range","id":"padding_top","label":"Ruimte boven","min":0,"max":140,"step":4,"unit":"px","default":84},
    {"type":"range","id":"padding_bottom","label":"Ruimte onder","min":0,"max":140,"step":4,"unit":"px","default":84}
  ],
  "blocks": [
    {
      "type":"feature",
      "name":"Kenmerk",
      "settings":[
        {"type":"select","id":"icon","label":"Icoon","default":"resolution","options":[{"value":"resolution","label":"Beeldkwaliteit"},{"value":"ai","label":"AI-detectie"},{"value":"night","label":"Nachtzicht"},{"value":"ptz","label":"PTZ"},{"value":"audio","label":"Audio"},{"value":"solar","label":"Zonnepaneel"}]},
        {"type":"text","id":"title","label":"Titel","default":"2K QHD"},
        {"type":"richtext","id":"text","label":"Beschrijving","default":"<p>Haarscherpe beelden met veel detail, zowel overdag als ’s nachts.</p>"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name":"MEARI S2 kenmerken",
      "blocks":[
        {"type":"feature","settings":{"icon":"resolution","title":"2K QHD","text":"<p>Haarscherpe beelden met veel detail, zowel overdag als ’s nachts.</p>"}},
        {"type":"feature","settings":{"icon":"ai","title":"AI Detectie","text":"<p>Herkent personen nauwkeurig en helpt onnodige meldingen te verminderen.</p>"}},
        {"type":"feature","settings":{"icon":"night","title":"Full-Color Nachtzicht","text":"<p>Zie meer kleur en bruikbare details wanneer het donker wordt.</p>"}},
        {"type":"feature","settings":{"icon":"ptz","title":"355° PTZ","text":"<p>Brede dekking dankzij soepele pan- en tiltbediening via de app.</p>"}},
        {"type":"feature","settings":{"icon":"audio","title":"Tweeweg Audio","text":"<p>Praat rechtstreeks met bezoekers via de ingebouwde microfoon en luidspreker.</p>"}},
        {"type":"feature","settings":{"icon":"solar","title":"Batterij + Zonnepaneel","text":"<p>Lange gebruiksduur dankzij een oplaadbare batterij en zonnepaneelondersteuning.</p>"}}
      ]
    }
  ]
}
{% endschema %}
