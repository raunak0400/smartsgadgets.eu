<section class="meari-service">
  <div class="page-width">

    <div class="service-header">
      <span class="eyebrow">MEARI</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="service-grid">

      {% for block in section.blocks %}
      <div class="service-card">

        <div class="service-icon">
          {{ block.settings.icon }}
        </div>

        <h3>{{ block.settings.title }}</h3>

        <p>{{ block.settings.description }}</p>

      </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>

.meari-service{
    background:#081A2B;
    padding:90px 20px;
}

.meari-service .page-width{
    max-width:1200px;
    margin:auto;
}

.service-header{
    text-align:center;
    max-width:720px;
    margin:0 auto 60px;
}

.service-header .eyebrow{
    color:#48A9FF;
    font-size:13px;
    letter-spacing:2px;
    font-weight:700;
}

.service-header h2{
    color:#fff;
    font-size:44px;
    margin:15px 0;
}

.service-header p{
    color:#c9d3dc;
    font-size:18px;
    line-height:1.7;
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:25px;
}

.service-card{

    background:linear-gradient(180deg,#102942,#0b2035);

    border-radius:24px;

    padding:40px 30px;

    text-align:center;

    border:1px solid rgba(255,255,255,.06);

    transition:.3s;

}

.service-card:hover{

    transform:translateY(-8px);

    border-color:#48A9FF;

    box-shadow:0 20px 45px rgba(0,0,0,.30);

}

.service-icon{

    width:70px;

    height:70px;

    margin:0 auto 22px;

    background:#167CFF;

    border-radius:50%;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:30px;

}

.service-card h3{

    color:#fff;

    font-size:22px;

    margin-bottom:14px;

}

.service-card p{

    color:#cfd7df;

    line-height:1.7;

    font-size:16px;

}

@media(max-width:990px){

.service-grid{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:640px){

.service-grid{

grid-template-columns:1fr;

}

.service-header h2{

font-size:32px;

}

}

</style>

{% schema %}
{
  "name":"MEARI Service",
  "settings":[
    {
      "type":"text",
      "id":"heading",
      "label":"Titel",
      "default":"Zorgeloos bestellen"
    },
    {
      "type":"textarea",
      "id":"text",
      "label":"Omschrijving",
      "default":"Wij zorgen voor een veilige en betrouwbare winkelervaring, van bestelling tot levering."
    }
  ],
  "blocks":[
    {
      "type":"item",
      "name":"Service",
      "settings":[
        {
          "type":"text",
          "id":"icon",
          "label":"Icoon",
          "default":"🛡️"
        },
        {
          "type":"text",
          "id":"title",
          "label":"Titel"
        },
        {
          "type":"textarea",
          "id":"description",
          "label":"Omschrijving"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"MEARI Service",
      "blocks":[
        {
          "type":"item",
          "settings":{
            "icon":"🛡️",
            "title":"2 Jaar Garantie",
            "description":"Kwaliteit waarop u kunt vertrouwen."
          }
        },
        {
          "type":"item",
          "settings":{
            "icon":"🚚",
            "title":"Snelle Levering",
            "description":"Snel verzonden vanuit ons magazijn."
          }
        },
        {
          "type":"item",
          "settings":{
            "icon":"↩️",
            "title":"60 Dagen Retour",
            "description":"Ruim de tijd om uw aankoop uit te proberen."
          }
        },
        {
          "type":"item",
          "settings":{
            "icon":"🔒",
            "title":"Veilig Betalen",
            "description":"iDEAL, Bancontact, PayPal, Creditcard en meer."
          }
        }
      ]
    }
  ]
}
{% endschema %}