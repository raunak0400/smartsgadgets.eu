{%- style -%}
  #shopify-section-{{ section.id }} .sg-deals {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 56px 48px 0;
  }

  #shopify-section-{{ section.id }} .sg-deals__heading {
    margin: 0 0 24px;
    font-size: 32px;
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-deals__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sg-deal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: 28px 24px;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(90deg, #fb9401 0%, #fc5e01 50%, #fc2d05 100%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sg-deal-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(252, 45, 5, 0.25);
  }

  #shopify-section-{{ section.id }} .sg-deal-card__link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__badge {
    position: relative;
    z-index: 2;
    display: inline-block;
    align-self: flex-start;
    margin: 0 0 14px;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: #ffffff;
    color: #c1290a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__body {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: stretch;
    gap: 12px;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__image {
    position: relative;
    flex: 0 0 auto;
    align-self: flex-end;
    width: 40%;
    max-width: 150px;
    aspect-ratio: 1 / 1;
    pointer-events: none;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.25));
  }

  #shopify-section-{{ section.id }} .sg-deal-card__image img {
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__title {
    margin: 0 0 16px;
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__price-row {
    margin-top: auto;
    padding-top: 12px;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__price-compare {
    margin: 0 0 2px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    font-weight: 500;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__price-now {
    margin: 0;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__price-prefix {
    font-size: 13px;
    font-weight: 600;
    text-transform: lowercase;
    margin-right: 4px;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__price-amount {
    font-size: 26px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__asterisk {
    font-size: 16px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sg-deal-card__fine-print {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-deals {
      padding: 48px 24px 0;
    }

    #shopify-section-{{ section.id }} .sg-deals__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-deals {
      padding: 40px 20px 0;
    }

    #shopify-section-{{ section.id }} .sg-deals__heading {
      margin: 0 0 16px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card {
      min-height: 220px;
      padding: 20px 16px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__image {
      width: 36%;
      max-width: 100px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__badge {
      margin-bottom: 10px;
      padding: 3px 10px;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__title {
      margin-bottom: 10px;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__price-compare {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__price-prefix {
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__price-amount {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__asterisk {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card__fine-print {
      margin-top: 8px;
      font-size: 9px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .sg-deals__grid {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .sg-deal-card {
      min-height: 200px;
      padding: 16px 14px;
    }
  }
{%- endstyle -%}

<div class="sg-deals">
  {%- if section.settings.heading != blank -%}
    <h2 class="sg-deals__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="sg-deals__grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <li class="sg-deal-card" {{ block.shopify_attributes }}>
        <a href="{{ product.url | default: '#' }}" class="sg-deal-card__link" aria-label="{{ product.title | default: block.settings.fallback_title }}"></a>

        <span class="sg-deal-card__badge">{{ block.settings.badge_text }}</span>

        <div class="sg-deal-card__body">
          <div class="sg-deal-card__content">
            <h3 class="sg-deal-card__title">{{ product.title | default: block.settings.fallback_title }}</h3>

            <div class="sg-deal-card__price-row">
              {%- if product.compare_at_price > product.price -%}
                <p class="sg-deal-card__price-compare">{{ product.compare_at_price | money }}</p>
              {%- endif -%}
              <p class="sg-deal-card__price-now">
                <span class="sg-deal-card__price-prefix">vanaf</span><span class="sg-deal-card__price-amount">{{ product.price | default: 19900 | money }}</span><span class="sg-deal-card__asterisk">*</span>
              </p>
              <p class="sg-deal-card__fine-print">{{ section.settings.fine_print }}</p>
            </div>
          </div>

          <div class="sg-deal-card__image">
            {%- if product != blank -%}
              {% render 'image',
                image: product.featured_image,
                widths: '150, 200, 300',
                src_width: 300,
                sizes: '(max-width: 749px) 22vw, 10vw',
                class: 'img-fit',
                lazy_load: true
              %}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'img-fit' }}
            {%- endif -%}
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Best Deals",
  "tag": "section",
  "class": "cc-custom-best-deals",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Topaanbiedingen"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print (shown under every price)",
      "default": "*Inclusief alle aanbiedingen"
    }
  ],
  "blocks": [
    {
      "type": "deal_product",
      "name": "Deal product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title (if no product selected)",
          "default": "Kooduu Synergy 35 Pro Bluetooth Speaker & Lamp"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "Best Seller"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Best Deals",
      "blocks": [
        {
          "type": "deal_product",
          "settings": {
            "product": "kooduu-sensa-lamp-moss-minimalistische-tafellamp",
            "badge_text": "Best Seller"
          }
        },
        {
          "type": "deal_product",
          "settings": {
            "product": "kooduu-lite-up-mini-play-earth-jbl-speaker",
            "badge_text": "Best Seller"
          }
        },
        {
          "type": "deal_product",
          "settings": {
            "product": "xenon-smart-x6850-draagbare-lamp-bluetooth-speaker",
            "badge_text": "Best Seller"
          }
        },
        {
          "type": "deal_product",
          "settings": {
            "product": "kooduu-atmos-brushed-silver-speaker-drankkoeler",
            "badge_text": "Best Seller"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
