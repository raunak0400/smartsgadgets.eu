{%- style -%}
  #shopify-section-{{ section.id }} .sg-deals {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 0 48px 56px;
  }

  #shopify-section-{{ section.id }} .sg-deals__heading {
    margin: 0 0 24px;
    font-size: 32px;
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-deals__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sg-deal-tile {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sg-deal-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 28px rgba(0, 0, 0, 0.18);
  }

  #shopify-section-{{ section.id }} .sg-deal-tile__link {
    display: block;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sg-deal-tile__img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .sg-deal-tile:hover .sg-deal-tile__img {
    transform: scale(1.03);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-deals {
      padding: 0 24px 48px;
    }

    #shopify-section-{{ section.id }} .sg-deals__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-deals {
      padding: 0 20px 40px;
    }

    #shopify-section-{{ section.id }} .sg-deals__heading {
      margin: 0 0 16px;
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .sg-deals__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .sg-deal-tile {
      border-radius: 10px;
    }
  }
{%- endstyle -%}

<div class="sg-deals">
  {%- if section.settings.heading != blank -%}
    <h2 class="sg-deals__heading" data-cc-animate="fade-in">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="sg-deals__grid">
    <li class="sg-deal-tile">
      <a href="/products/kooduu-sensa-lamp-moss-minimalistische-tafellamp" class="sg-deal-tile__link" data-cc-animate="zoom-in" data-cc-animate-delay="0s" aria-label="Kooduu Sensa Moss – Premium Tafellamp">
        <img src="{{ 'light1.png' | asset_url }}" alt="Kooduu Sensa Moss – Premium Tafellamp" width="1672" height="940" loading="lazy" class="sg-deal-tile__img">
      </a>
    </li>
    <li class="sg-deal-tile">
      <a href="/products/kooduu-lite-up-mini-play-earth-jbl-speaker" class="sg-deal-tile__link" data-cc-animate="zoom-in" data-cc-animate-delay="0.12s" aria-label="Kooduu Mini PLAY Earth – Premium Speakerlamp">
        <img src="{{ 'light2.png' | asset_url }}" alt="Kooduu Mini PLAY Earth – Premium Speakerlamp" width="1672" height="940" loading="lazy" class="sg-deal-tile__img">
      </a>
    </li>
    <li class="sg-deal-tile">
      <a href="/products/xenon-smart-x6850-draagbare-lamp-bluetooth-speaker" class="sg-deal-tile__link" data-cc-animate="zoom-in" data-cc-animate-delay="0.24s" aria-label="Xenon Smart X6850 – 360° Licht &amp; Geluid">
        <img src="{{ 'light3.png' | asset_url }}" alt="Xenon Smart X6850 – 360° Licht &amp; Geluid" width="1672" height="940" loading="lazy" class="sg-deal-tile__img">
      </a>
    </li>
    <li class="sg-deal-tile">
      <a href="/products/kooduu-atmos-brushed-silver-speaker-drankkoeler" class="sg-deal-tile__link" data-cc-animate="zoom-in" data-cc-animate-delay="0.36s" aria-label="Kooduu Atmos Brushed Silver – 3-in-1 Sfeerlamp">
        <img src="{{ 'light4.png' | asset_url }}" alt="Kooduu Atmos Brushed Silver – 3-in-1 Sfeerlamp" width="1672" height="940" loading="lazy" class="sg-deal-tile__img">
      </a>
    </li>
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Best Deals",
  "tag": "section",
  "class": "cc-custom-best-deals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beste in Verlichtingscategorieën"
    }
  ],
  "presets": [
    {
      "name": "Custom: Best Deals"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
