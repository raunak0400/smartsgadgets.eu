{%- liquid
  assign assortment_menu = linklists[section.settings.assortment_menu]
  assign service_menu = linklists[section.settings.service_menu]
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sg-footer {
    background-color: #000000;
    color: #ffffff;
    padding: 64px 48px 32px;
  }

  #shopify-section-{{ section.id }} .sg-footer__inner {
    width: min(1320px, 100%);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sg-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .sg-footer__heading {
    margin: 0 0 24px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-footer__links {
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sg-footer__links a {
    color: #d9d9d9;
    font-size: 15px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sg-footer__links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .sg-footer__about-text {
    margin: 0 0 24px;
    color: #d9d9d9;
    font-size: 15px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .sg-footer__sub-heading {
    margin: 24px 0 12px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-footer__address p,
  #shopify-section-{{ section.id }} .sg-footer__contact p {
    margin: 0 0 4px;
    color: #d9d9d9;
    font-size: 15px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .sg-footer__contact a {
    color: #d9d9d9;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .sg-footer__social {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    list-style: none;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sg-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #ffffff;
    border-radius: 999px;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sg-footer__social svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .sg-footer__newsletter-text {
    margin: 16px 0 0;
    color: #ffffff;
    font-size: 16px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .sg-footer__heading--about {
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .sg-footer__logo-lockup {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sg-footer__logo-lockup img {
    display: block;
    height: auto;
  }

  #shopify-section-{{ section.id }} .sg-footer__bottom {
    margin-top: 24px;
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .sg-footer__copyright {
    margin: 0;
    color: #d9d9d9;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .sg-footer__bottom-link {
    color: #ffffff;
    font-size: 14px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sg-footer__bottom-link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-footer {
      padding: 48px 20px 24px;
    }

    #shopify-section-{{ section.id }} .sg-footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
{%- endstyle -%}

<div class="sg-footer">
  <div class="sg-footer__inner">
    <div class="sg-footer__grid">
      <div class="sg-footer__col">
        {% render 'newsletter-signup',
          id: section.id,
          tags: 'newsletter, footer',
          hide_label: true,
          arrow_button: true
        %}
        <p class="sg-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>

        {%- if section.settings.show_social -%}
          <ul class="sg-footer__social">
            {%- if settings.social_instagram_url != blank -%}
              <li>
                <a href="{{ settings.social_instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M12 2c2.7 0 3.1 0 4.1.06 1.1.05 1.8.2 2.4.45.7.27 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.24.6.4 1.3.45 2.4.06 1 .06 1.4.06 4.1s0 3.1-.06 4.1c-.05 1.1-.2 1.8-.45 2.4-.27.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.6.24-1.3.4-2.4.45-1 .06-1.4.06-4.1.06s-3.1 0-4.1-.06c-1.1-.05-1.8-.2-2.4-.45-.7-.27-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.24-.6-.4-1.3-.45-2.4C2 15.1 2 14.7 2 12s0-3.1.06-4.1c.05-1.1.2-1.8.45-2.4.27-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.24 1.3-.4 2.4-.45C8.9 2 9.3 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_url != blank -%}
              <li>
                <a href="{{ settings.social_tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M16.5 2h-3.1v13.2c0 1.5-1.2 2.7-2.7 2.7a2.7 2.7 0 0 1-2.7-2.7 2.7 2.7 0 0 1 2.7-2.7c.3 0 .6.05.9.14v-3.2a5.9 5.9 0 0 0-.9-.07A5.9 5.9 0 0 0 4.8 15.3a5.9 5.9 0 0 0 5.9 5.9 5.9 5.9 0 0 0 5.9-5.9V8.6a7.6 7.6 0 0 0 4.4 1.4V6.9a4.5 4.5 0 0 1-4.5-4.5V2z"/></svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        <h2 class="sg-footer__heading sg-footer__heading--about">{{ section.settings.about_heading }}</h2>
        <p class="sg-footer__about-text">{{ section.settings.about_text }}</p>
      </div>

      <div class="sg-footer__col">
        <h2 class="sg-footer__heading">{{ section.settings.assortment_heading }}</h2>
        {%- if assortment_menu != blank -%}
          <ul class="sg-footer__links">
            {%- for link in assortment_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sg-footer__col">
        <h2 class="sg-footer__heading">{{ section.settings.service_heading }}</h2>
        {%- if service_menu != blank -%}
          <ul class="sg-footer__links">
            {%- for link in service_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sg-footer__col">
        <h2 class="sg-footer__heading">{{ section.settings.address_heading }}</h2>
        <div class="sg-footer__address">{{ section.settings.address | newline_to_br }}</div>

        <h3 class="sg-footer__sub-heading">{{ section.settings.contact_heading }}</h3>
        <div class="sg-footer__contact">
          <p>Email: <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
        </div>
      </div>
    </div>

    <div class="sg-footer__logo-lockup">
      {%- if section.settings.logo != blank -%}
        {% render 'image',
          image: section.settings.logo,
          src_width: section.settings.logo_width,
          srcset_2x: true,
          lazy_load: true,
          alt_text: shop.name
        %}
      {%- endif -%}
    </div>

    <div class="sg-footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      {%- assign year_token = '[[YEAR]]' -%}
      <p class="sg-footer__copyright">{{ section.settings.copyright_text | replace: year_token, current_year }}</p>
      {%- if section.settings.show_my_orders -%}
        <a href="{{ routes.account_url }}" class="sg-footer__bottom-link">My Orders</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom: Footer",
  "tag": "footer",
  "class": "cc-custom-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo"
    },
    {
      "type": "number",
      "id": "logo_width",
      "label": "Bottom logo width",
      "default": 220
    },
    {
      "type": "text",
      "id": "assortment_heading",
      "label": "Assortment heading",
      "default": "Assortment"
    },
    {
      "type": "link_list",
      "id": "assortment_menu",
      "label": "Assortment menu"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About heading",
      "default": "About Smartsgadgets"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Smartsgadgets offers smart products for home, security, pets, and lifestyle. We supply reliable gadgets at an attractive price."
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Address"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "SmartsGadgets\nMolenzicht 5C\n4881BW Zundert\nThe Netherlands\nVAT: NL868318887B01\nCoC: 9798834"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "info@smartsgadgets.eu"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "text",
      "id": "service_heading",
      "label": "Customer service heading",
      "default": "Customer Service"
    },
    {
      "type": "link_list",
      "id": "service_menu",
      "label": "Customer service menu"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Sign up for exclusive offers, original stories, events, and more."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "info": "Use [[YEAR]] to insert the current year.",
      "default": "© [[YEAR]] Smartsgadgets.eu. All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_my_orders",
      "label": "Show \"My Orders\" link",
      "default": true
    }
  ]
}
{% endschema %}
