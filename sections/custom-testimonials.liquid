{%- style -%}
  #shopify-section-{{ section.id }} .sg-testimonials {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 56px 48px;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .sg-testimonials__heading {
    margin: 0 0 12px;
    font-size: 32px;
    font-weight: 700;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-testimonials__summary {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    font-size: 15px;
    color: #6b6b6b;
  }

  #shopify-section-{{ section.id }} .sg-testimonials__summary .sg-stars {
    color: #ff8600;
  }

  #shopify-section-{{ section.id }} .sg-testimonials__summary strong {
    color: #111111;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sg-stars {
    display: inline-flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .sg-stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .sg-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__stars {
    color: #ff8600;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__quote {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.55;
    font-style: italic;
    color: #333333;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__footer {
    padding-top: 16px;
    border-top: 1px solid #eeeeee;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__author {
    font-size: 15px;
    font-weight: 600;
    color: #111111;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    background-color: #2563eb;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__badge svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .sg-testimonial-card__purchased {
    font-size: 13px;
    color: #ff8600;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sg-testimonials__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sg-testimonials {
      padding: 40px 20px;
    }

    #shopify-section-{{ section.id }} .sg-testimonials__heading {
      font-size: 24px;
    }
  }
{%- endstyle -%}

{%- capture full_star -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>{%- endcapture -%}
{%- capture half_star -%}<svg viewBox="0 0 24 24"><defs><linearGradient id="half-{{ section.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent" stop-opacity="0"/></linearGradient></defs><path fill="url(#half-{{ section.id }})" stroke="currentColor" stroke-width="1" d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>{%- endcapture -%}

<div class="sg-testimonials">
  <h2 class="sg-testimonials__heading">{{ section.settings.heading }}</h2>

  <div class="sg-testimonials__summary">
    <span class="sg-stars">
      {%- assign full = section.settings.summary_rating | floor -%}
      {%- assign has_half = false -%}
      {%- assign remainder = section.settings.summary_rating | minus: full -%}
      {%- if remainder >= 0.3 -%}{%- assign has_half = true -%}{%- endif -%}
      {%- assign half_index = full | plus: 1 -%}
      {%- for i in (1..5) -%}
        {%- if i <= full -%}
          {{ full_star }}
        {%- elsif has_half and i == half_index -%}
          {{ half_star }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>
        {%- endif -%}
      {%- endfor -%}
    </span>
    <strong>{{ section.settings.summary_rating }}/5</strong>
    <span>Based on {{ section.settings.summary_count }} reviews</span>
  </div>

  <ul class="sg-testimonials__grid">
    {%- for block in section.blocks -%}
      <li class="sg-testimonial-card" {{ block.shopify_attributes }}>
        <div class="sg-testimonial-card__stars sg-stars">
          {%- assign full = block.settings.star_rating | floor -%}
          {%- assign remainder = block.settings.star_rating | minus: full -%}
          {%- assign has_half = false -%}
          {%- if remainder >= 0.3 -%}{%- assign has_half = true -%}{%- endif -%}
          {%- assign half_index = full | plus: 1 -%}
          {%- for i in (1..5) -%}
            {%- if i <= full -%}
              {{ full_star }}
            {%- elsif has_half and i == half_index -%}
              {{ half_star }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <p class="sg-testimonial-card__quote">&quot;{{ block.settings.quote }}&quot;</p>

        <div class="sg-testimonial-card__footer">
          <div class="sg-testimonial-card__author-row">
            <span class="sg-testimonial-card__author">{{ block.settings.author }}</span>
            <span class="sg-testimonial-card__badge">
              <svg viewBox="0 0 24 24"><path d="M12 2l2.4 1.4 2.7-.3 1.1 2.5 2.5 1.1-.3 2.7L22 12l-1.4 2.4.3 2.7-2.5 1.1-1.1 2.5-2.7-.3L12 22l-2.4-1.4-2.7.3-1.1-2.5-2.5-1.1.3-2.7L2 12l1.4-2.4-.3-2.7 2.5-1.1 1.1-2.5 2.7.3z"/></svg>
              Verified Buyer
            </span>
          </div>
          <div class="sg-testimonial-card__purchased">Purchased: {{ block.settings.purchased_product }}</div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Custom: Testimonials",
  "tag": "section",
  "class": "cc-custom-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "summary_rating",
      "label": "Summary rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "summary_count",
      "label": "Summary review count",
      "default": "10,000+"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Excellent service and fast delivery."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Mark T."
        },
        {
          "type": "text",
          "id": "purchased_product",
          "label": "Purchased product",
          "default": "WOOX R6113 Smart Plug"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom: Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "quote": "Excellent service and fast delivery. The smart plugs work perfectly with my home setup.",
            "author": "Mark T.",
            "purchased_product": "WOOX R6113 Smart Plug"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "quote": "The indoor camera quality is superb. Setup took less than 5 minutes. Highly recommend this store.",
            "author": "Sarah M.",
            "purchased_product": "Xenon ProVision 4K"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "star_rating": 4.5,
            "quote": "Great mesh system. Finally have full Wi-Fi coverage across my entire apartment. Good price too.",
            "author": "David L.",
            "purchased_product": "MEARI Mesh WiFi 6"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
