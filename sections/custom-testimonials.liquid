{%- comment -%}
  Customer reviews block for the homepage. REAL data only:
  - the rating and count come from Judge.me's shop metafields (judgeme.all_reviews_rating / all_reviews_count)
  - the reviews themselves are Judge.me's featured carousel (judgeme.featured_carousel)
  Nothing here is typed in by hand, so it cannot drift from what is in Judge.me. If Judge.me has no data
  yet, the section renders nothing at all.
{%- endcomment -%}

{%- assign jdgm_count = shop.metafields.judgeme.all_reviews_count.value | plus: 0 -%}
{%- assign jdgm_rating = shop.metafields.judgeme.all_reviews_rating.value | plus: 0.0 -%}
{%- assign jdgm_carousel = shop.metafields.judgeme.featured_carousel.value -%}

{%- if jdgm_count > 0 and jdgm_rating > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .sg-testimonials {
      width: min(1280px, 100%);
      margin: 0 auto;
      padding: 56px 48px;
      border-top: 1px solid #e5e5e5;
    }

    #shopify-section-{{ section.id }} .sg-testimonials__heading {
      margin: 0 0 12px;
      font-size: 32px;
      font-weight: 700;
      color: #111111;
    }

    #shopify-section-{{ section.id }} .sg-testimonials__summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-bottom: 28px;
      font-size: 15px;
      color: #6b6b6b;
    }

    #shopify-section-{{ section.id }} .sg-testimonials__summary .sg-stars {
      color: #ff8600;
    }

    #shopify-section-{{ section.id }} .sg-testimonials__summary strong {
      color: #111111;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .sg-stars {
      display: inline-flex;
      gap: 2px;
    }

    #shopify-section-{{ section.id }} .sg-stars svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .sg-testimonials {
        padding: 40px 20px;
      }

      #shopify-section-{{ section.id }} .sg-testimonials__heading {
        font-size: 24px;
      }
    }
  {%- endstyle -%}

  {%- capture full_star -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>{%- endcapture -%}
  {%- capture half_star -%}<svg viewBox="0 0 24 24"><defs><linearGradient id="half-{{ section.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent" stop-opacity="0"/></linearGradient></defs><path fill="url(#half-{{ section.id }})" stroke="currentColor" stroke-width="1" d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>{%- endcapture -%}

  {%- assign is_nl = false -%}
  {%- if request.locale.iso_code contains 'nl' -%}{%- assign is_nl = true -%}{%- endif -%}

  <div class="sg-testimonials">
    {%- if section.settings.heading != blank -%}
      <h2 class="sg-testimonials__heading" data-cc-animate="fade-in">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sg-testimonials__summary" data-cc-animate="fade-in" data-cc-animate-delay="0.1s">
      <span class="sg-stars" aria-hidden="true">
        {%- assign full = jdgm_rating | floor -%}
        {%- assign remainder = jdgm_rating | minus: full -%}
        {%- assign has_half = false -%}
        {%- if remainder >= 0.3 -%}{%- assign has_half = true -%}{%- endif -%}
        {%- assign half_index = full | plus: 1 -%}
        {%- for i in (1..5) -%}
          {%- if i <= full -%}
            {{ full_star }}
          {%- elsif has_half and i == half_index -%}
            {{ half_star }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>
          {%- endif -%}
        {%- endfor -%}
      </span>
      {%- assign rating_text = jdgm_rating | round: 1 -%}
      {%- if is_nl -%}{%- assign rating_text = rating_text | replace: '.', ',' -%}{%- endif -%}
      <strong>{{ rating_text }}/5</strong>
      <span>
        {%- if is_nl -%}
          Gebaseerd op {{ jdgm_count }} beoordelingen via Judge.me
        {%- else -%}
          Based on {{ jdgm_count }} reviews via Judge.me
        {%- endif -%}
      </span>
    </div>

    {%- if jdgm_carousel != blank -%}
      <div class="sg-testimonials__carousel" data-cc-animate="fade-in" data-cc-animate-delay="0.2s">
        {{ jdgm_carousel }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom: Judge.me reviews",
  "tag": "section",
  "class": "cc-custom-testimonials",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the real Judge.me rating, review count and featured reviews. Nothing is typed in by hand; to change which reviews appear, feature them in Judge.me."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wat onze klanten zeggen"
    }
  ],
  "presets": [
    {
      "name": "Custom: Judge.me reviews"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
