<section id="MeariFeatures-{{ section.id }}" class="meari-features">
  <div class="meari-features__inner">

    <div class="meari-features__header">
      {% if section.settings.eyebrow != blank %}
        <p class="meari-features__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="meari-features__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="meari-features__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="meari-features__grid">
      {% for block in section.blocks %}
        <article class="meari-features__card" {{ block.shopify_attributes }}>

          <div class="meari-features__icon">
            {% case block.settings.icon %}
              {% when 'camera' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7.5h3l1.5-2h7l1.5 2h3v11H4z"/>
                  <circle cx="12" cy="13" r="3.25"/>
                </svg>

              {% when 'ai' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="7" y="7" width="10" height="10" rx="2"/>
                  <path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/>
                  <circle cx="10" cy="11" r=".7"/>
                  <circle cx="14" cy="11" r=".7"/>
                  <path d="M10 14h4"/>
                </svg>

              {% when 'moon' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 15.5A8 8 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5z"/>
                </svg>

              {% when 'audio' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 10v4h4l5 4V6l-5 4z"/>
                  <path d="M17 9a4 4 0 0 1 0 6M19.5 6.5a8 8 0 0 1 0 11"/>
                </svg>

              {% when 'rotate' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12a8 8 0 0 1 13.5-5.8L20 9"/>
                  <path d="M20 4v5h-5"/>
                  <path d="M20 12a8 8 0 0 1-13.5 5.8L4 15"/>
                  <path d="M4 20v-5h5"/>
                </svg>

              {% when 'privacy' %}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3l7 3v5c0 4.8-2.7 8.1-7 10-4.3-1.9-7-5.2-7-10V6z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
            {% endcase %}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="meari-features__title">
              {{ block.settings.title | escape }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="meari-features__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </article>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #MeariFeatures-{{ section.id }} {
    --meari-dark: #0d172b;
    --meari-muted: #667085;
    --meari-orange: #ff7900;
    --meari-card: #ffffff;
    --meari-border: rgba(13, 23, 43, 0.08);

    width: 100%;
    padding: 105px 0;
    background:
      radial-gradient(
        circle at 85% 12%,
        rgba(60, 135, 255, 0.10),
        transparent 32%
      ),
      #f5f8fc;
  }

  #MeariFeatures-{{ section.id }} .meari-features__inner {
    width: min(1500px, calc(100% - 64px));
    margin: 0 auto;
  }

  #MeariFeatures-{{ section.id }} .meari-features__header {
    max-width: 780px;
    margin-bottom: 48px;
  }

  #MeariFeatures-{{ section.id }} .meari-features__eyebrow {
    margin: 0 0 14px;
    color: var(--meari-orange);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  #MeariFeatures-{{ section.id }} .meari-features__heading {
    margin: 0;
    color: var(--meari-dark);
    font-size: clamp(38px, 4vw, 62px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  #MeariFeatures-{{ section.id }} .meari-features__description {
    max-width: 670px;
    margin-top: 20px;
    color: var(--meari-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  #MeariFeatures-{{ section.id }} .meari-features__description p,
  #MeariFeatures-{{ section.id }} .meari-features__text p {
    margin: 0;
  }

  #MeariFeatures-{{ section.id }} .meari-features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  #MeariFeatures-{{ section.id }} .meari-features__card {
    min-width: 0;
    padding: 30px;
    border: 1px solid var(--meari-border);
    border-radius: 24px;
    background: var(--meari-card);
    box-shadow: 0 14px 36px rgba(24, 39, 75, 0.07);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  #MeariFeatures-{{ section.id }} .meari-features__card:hover {
    border-color: rgba(255, 121, 0, 0.28);
    box-shadow: 0 22px 48px rgba(24, 39, 75, 0.12);
    transform: translateY(-4px);
  }

  #MeariFeatures-{{ section.id }} .meari-features__icon {
    display: flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border-radius: 16px;
    background: rgba(255, 121, 0, 0.10);
    color: var(--meari-orange);
  }

  #MeariFeatures-{{ section.id }} .meari-features__icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #MeariFeatures-{{ section.id }} .meari-features__title {
    margin: 0;
    color: var(--meari-dark);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.025em;
  }

  #MeariFeatures-{{ section.id }} .meari-features__text {
    margin-top: 11px;
    color: var(--meari-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  @media screen and (max-width: 1050px) {
    #MeariFeatures-{{ section.id }} {
      padding: 84px 0;
    }

    #MeariFeatures-{{ section.id }} .meari-features__inner {
      width: min(100% - 40px, 1200px);
    }

    #MeariFeatures-{{ section.id }} .meari-features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 680px) {
    #MeariFeatures-{{ section.id }} {
      padding: 64px 0;
    }

    #MeariFeatures-{{ section.id }} .meari-features__inner {
      width: calc(100% - 28px);
    }

    #MeariFeatures-{{ section.id }} .meari-features__header {
      margin-bottom: 30px;
    }

    #MeariFeatures-{{ section.id }} .meari-features__heading {
      font-size: clamp(36px, 10vw, 48px);
    }

    #MeariFeatures-{{ section.id }} .meari-features__description {
      font-size: 16px;
    }

    #MeariFeatures-{{ section.id }} .meari-features__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #MeariFeatures-{{ section.id }} .meari-features__card {
      padding: 25px 23px;
      border-radius: 21px;
    }

    #MeariFeatures-{{ section.id }} .meari-features__title {
      font-size: 22px;
    }

    #MeariFeatures-{{ section.id }} .meari-features__text {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MeariFeatures-{{ section.id }} .meari-features__card {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "MEARI S1 Features",
  "tag": "section",
  "class": "section-meari-s1-features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "SLIM ONTWORPEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alles wat u nodig heeft, in één compacte camera."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Van helder beeld tot slimme detectie: de MEARI S1 Plus helpt u dag en nacht verbonden te blijven.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "camera",
          "options": [
            {
              "value": "camera",
              "label": "Camera"
            },
            {
              "value": "ai",
              "label": "AI"
            },
            {
              "value": "moon",
              "label": "Night vision"
            },
            {
              "value": "audio",
              "label": "Audio"
            },
            {
              "value": "rotate",
              "label": "Pan and tilt"
            },
            {
              "value": "privacy",
              "label": "Privacy"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "2K QHD beeldkwaliteit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Bekijk meer details met een helder en scherp beeld, zowel overdag als 's avonds.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MEARI S1 Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "camera",
            "title": "2K QHD beeldkwaliteit",
            "text": "<p>Bekijk meer details met een helder en scherp beeld, zowel overdag als 's avonds.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "ai",
            "title": "Slimme AI-detectie",
            "text": "<p>Ontvang relevante meldingen bij beweging, geluid en belangrijke gebeurtenissen.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "moon",
            "title": "Nachtzicht",
            "text": "<p>Houd uw ruimte ook in het donker duidelijk in beeld.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "audio",
            "title": "Tweerichtingsaudio",
            "text": "<p>Luister en praat op afstand via de MEARI-app.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "rotate",
            "title": "Pan & tilt",
            "text": "<p>Bekijk een groter deel van de ruimte door de camera op afstand te draaien.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "privacy",
            "title": "Privacymodus",
            "text": "<p>Schakel de camera eenvoudig uit wanneer u volledige privacy wilt.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}