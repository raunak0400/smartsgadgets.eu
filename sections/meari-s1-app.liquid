<section id="MeariApp-{{ section.id }}" class="meari-app">

  <div class="meari-app__inner">

    <div class="meari-app__content">

      {% if section.settings.eyebrow != blank %}
        <p class="meari-app__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="meari-app__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="meari-app__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="meari-app__checks">

        {% for block in section.blocks %}

          <div class="meari-check" {{ block.shopify_attributes }}>

            <span class="meari-check__icon">

              <svg viewBox="0 0 24 24" fill="none">
                <path d="M20 6L9 17L4 12"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
              </svg>

            </span>

            <span class="meari-check__text">

              {{ block.settings.title }}

            </span>

          </div>

        {% endfor %}

      </div>

    </div>

    <div class="meari-app__image">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
          class: 'meari-phone',
          loading: 'lazy'
        }}

      {% endif %}

    </div>

  </div>

</section>

<style>

#meari-app-{{ section.id }},
#MeariApp-{{ section.id }}{

padding:120px 0;

background:#ffffff;

}

#MeariApp-{{ section.id }} .meari-app__inner{

max-width:1450px;

margin:auto;

padding:0 40px;

display:grid;

grid-template-columns:1fr 1.15fr;

align-items:center;

gap:80px;

}

#MeariApp-{{ section.id }} .meari-app__eyebrow{

font-size:13px;

font-weight:800;

letter-spacing:.14em;

text-transform:uppercase;

color:#ff7900;

margin-bottom:18px;

}

#MeariApp-{{ section.id }} .meari-app__heading{

font-size:58px;

line-height:1.05;

font-weight:800;

letter-spacing:-.04em;

color:#0d172b;

margin:0 0 24px;

max-width:620px;

}

#MeariApp-{{ section.id }} .meari-app__text{

font-size:18px;

line-height:1.8;

color:#667085;

max-width:560px;

margin-bottom:36px;

}

#MeariApp-{{ section.id }} .meari-app__checks{

display:grid;

grid-template-columns:1fr;

gap:18px;

}

#MeariApp-{{ section.id }} .meari-check{

display:flex;

align-items:center;

gap:16px;

font-size:18px;

font-weight:600;

color:#0d172b;

}

#MeariApp-{{ section.id }} .meari-check__icon{

width:34px;

height:34px;

border-radius:50%;

background:#fff4ea;

display:flex;

align-items:center;

justify-content:center;

color:#ff7900;

flex-shrink:0;

}

#MeariApp-{{ section.id }} .meari-check__icon svg{

width:18px;

height:18px;

}

#MeariApp-{{ section.id }} .meari-app__image{

display:flex;

justify-content:center;

align-items:center;

}

#MeariApp-{{ section.id }} .meari-phone{

width:100%;

max-width:760px;

display:block;

border-radius:34px;

box-shadow:

0 40px 80px rgba(20,33,61,.10);

transition:.35s;

}

#MeariApp-{{ section.id }} .meari-phone:hover{

transform:translateY(-6px);

}

@media(max-width:990px){

#MeariApp-{{ section.id }}{

padding:80px 0;

}

#MeariApp-{{ section.id }} .meari-app__inner{

grid-template-columns:1fr;

gap:50px;

}

#MeariApp-{{ section.id }} .meari-app__image{

order:-1;

}

#MeariApp-{{ section.id }} .meari-app__heading{

font-size:42px;

}

}

@media(max-width:749px){

#MeariApp-{{ section.id }}{

padding:60px 0;

}

#MeariApp-{{ section.id }} .meari-app__inner{

padding:0 20px;

}

#MeariApp-{{ section.id }} .meari-app__heading{

font-size:34px;

}

#MeariApp-{{ section.id }} .meari-app__text{

font-size:16px;

}

#MeariApp-{{ section.id }} .meari-check{

font-size:16px;

}

}
</style>
{% schema %}
{
  "name": "MEARI App Experience",
  "tag": "section",
  "class": "section-meari-app",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "BEDIEN ALLES VANUIT ÉÉN APP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uw woning altijd binnen handbereik."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Bekijk live beelden, ontvang meldingen, praat via de camera en beheer meerdere camera's eenvoudig vanuit de gratis MEARI-app.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Phone image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Checklist item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "Live beeld bekijken"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MEARI App Experience",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Live beeld bekijken"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Direct meldingen ontvangen"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Opnames terugkijken"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Meerdere camera's beheren"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Tweerichtingsaudio"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Overal toegang via de app"
          }
        }
      ]
    }
  ]
}
{% endschema %}