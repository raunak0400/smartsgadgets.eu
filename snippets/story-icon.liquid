{%- comment -%}
  Icons for sections/custom-product-story.liquid.
  Usage: {% render 'story-icon', name: 'aperture' %}
  Feature icons (outline): aperture, ai, talk, cloud, night, shield, wifi, battery.
  Hotspot icons (solid, drawn inside the white pin): dome, ptz, doorbell, bullet, battery-cam.
{%- endcomment -%}
{%- case name -%}
  {%- when 'aperture' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M15.5 12 17 20.66M13.75 15.03 7 20.66M10.25 15.03 2 12M8.5 12 7 3.34M10.25 8.97 17 3.34M13.75 8.97 22 12"/><path d="m15.5 12-1.75 3.03h-3.5L8.5 12l1.75-3.03h3.5z"/></svg>
  {%- when 'ai' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4.5" y="4.5" width="15" height="15" rx="3"/><path d="M9 2v2.5M15 2v2.5M9 19.5V22M15 19.5V22M2 9h2.5M2 15h2.5M19.5 9H22M19.5 15H22"/><text x="12" y="15.6" font-size="8.6" font-weight="800" text-anchor="middle" fill="currentColor" stroke="none" font-family="Arial, Helvetica, sans-serif">AI</text></svg>
  {%- when 'talk' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3.5h11a2.5 2.5 0 0 1 2.5 2.5v6a2.5 2.5 0 0 1-2.5 2.5h-5l-3.5 3v-3H4A2.5 2.5 0 0 1 1.5 12V6A2.5 2.5 0 0 1 4 3.5z"/><path d="M19.5 8.5h.5A2.5 2.5 0 0 1 22.5 11v6a2.5 2.5 0 0 1-2.5 2.5h-.5v3L16 19.5h-4"/><path d="M6 8.2h6.5M6 11h4"/></svg>
  {%- when 'cloud' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.8 18.5a4.3 4.3 0 0 1-.7-8.55 6 6 0 0 1 11.6 1.05 3.8 3.8 0 0 1-.4 7.5z"/><path d="M12 17.5V12M9.6 14.2 12 11.8l2.4 2.4"/></svg>
  {%- when 'night' -%}
