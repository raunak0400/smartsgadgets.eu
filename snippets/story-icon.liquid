  {%- when 'bullet' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.5 2.5v5.2M16.5 2.5v5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/><rect x="5.5" y="7.5" width="13" height="10" rx="3.4" fill="currentColor"/><circle cx="12" cy="12.5" r="2.2" fill="#fff"/><rect x="10.5" y="18.6" width="3" height="3" rx="1.2" fill="currentColor"/></svg>
  {%- when 'battery-cam' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="2.4" width="12" height="19.2" rx="3.8" fill="currentColor"/><circle cx="12" cy="8.6" r="2.8" fill="#fff"/><rect x="10.4" y="14.6" width="3.2" height="3.4" rx="1.1" fill="#fff"/></svg>
