  {%- when 'dome' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="10.5" r="7.6" fill="currentColor"/><circle cx="12" cy="11" r="2.8" fill="#fff"/><rect x="7" y="19" width="10" height="2.4" rx="1.2" fill="currentColor"/></svg>
