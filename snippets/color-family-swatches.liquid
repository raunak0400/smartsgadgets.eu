{%- comment -%}
  Parameters:
  - product {Object} - Product object.
  - context {String} - 'page' (default, full box with price) or 'card'
    (compact - smaller boxes, no price, for collection/homepage product cards).

  Renders an Amazon-style colour variant selector: bordered square boxes,
  each showing that colour's actual product photo, with the selected one
  highlighted by a blue border. Links to sibling products in the same
  colour family. Colours in this store are separate Shopify products (not
  variants of one product), so this reads a `custom.color_variants`
  list.product_reference metafield populated per-product in Shopify Admin.
  Renders nothing if the metafield is blank, so products without a colour
  family are unaffected.

  The current product's box is rendered as a non-interactive element (not
  a link) since clicking it should be a no-op.

  Usage:
  {% render 'color-family-swatches', product: product %}
  {% render 'color-family-swatches', product: product, context: 'card' %}
{%- endcomment -%}

{%- liquid
  assign color_family = product.metafields.custom.color_variants.value
  assign is_card = false
  if context == 'card'
    assign is_card = true
  endif
-%}

{%- if color_family != blank and color_family.size > 0 -%}
  {%- assign current_color_name = product.metafields.custom.color_label.value | default: product.title -%}
  <div class="color-family-swatches{% if is_card %} color-family-swatches--card{% endif %}">
    {%- unless is_card -%}
      <p class="color-family-swatches__label">
        {{ 'products.product.color' | t }}: <strong>{{ current_color_name }}</strong>
      </p>
    {%- endunless -%}
    <div class="color-family-swatches__list">
      <span
        class="color-family-swatches__item is-active"
        aria-current="true"
        aria-label="{{ current_color_name }}"
        title="{{ current_color_name }}"
      >
        <span class="color-family-swatches__image-wrap">
          {%- if product.featured_media -%}
            {%- render 'image', image: product.featured_media.preview_image, src_width: 160, srcset_2x: true, class: 'color-family-swatches__image' -%}
          {%- endif -%}
        </span>
        {%- unless is_card -%}
          <span class="color-family-swatches__price">{{ product.price | money }}</span>
        {%- endunless -%}
      </span>
      {%- for linked_product in color_family -%}
        {%- if linked_product != blank -%}
          {%- assign linked_color_name = linked_product.metafields.custom.color_label.value | default: linked_product.title -%}
          <a
            href="{{ linked_product.url }}"
            class="color-family-swatches__item"
            aria-label="{{ linked_color_name }}"
            title="{{ linked_color_name }}"
          >
            <span class="color-family-swatches__image-wrap">
              {%- if linked_product.featured_media -%}
                {%- render 'image', image: linked_product.featured_media.preview_image, src_width: 160, srcset_2x: true, class: 'color-family-swatches__image' -%}
              {%- endif -%}
            </span>
            {%- unless is_card -%}
              <span class="color-family-swatches__price">{{ linked_product.price | money }}</span>
            {%- endunless -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
