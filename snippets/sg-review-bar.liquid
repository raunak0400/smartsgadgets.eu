{%- comment -%}
  Mobile-only dismissible review trust bar (WebwinkelKeur score).

  Two different, page-type-appropriate mechanisms push the header below it
  (deliberately NOT a single one-size-fits-all hack — that's what kept
  regressing):

  - Homepage (`template-index`): the header overlays the hero via
    `position: absolute`. The bar floats `fixed` over everything, and ONLY
    the header's `top` is shifted to clear it. This never touches the hero's
    own box/flow, so it can't disturb the hero's own sizing. Confirmed
    correct in isolated testing.
  - Every other page (product, collection, etc.): the header is already in
    normal document flow there (not an overlay). So the bar is rendered as
    an ordinary, non-fixed block — literally the first element in <body>,
    before the header — and normal CSS flow pushes the header (and
    everything after it) down. No margin hack, no JS timing dependency:
    this is the same mechanism any "announcement bar above the header" uses.
    (An earlier `margin-top` hack on the header corrupted the product image
    gallery's own height measurement; a JS "wait for window.load, then
    dispatch resize" workaround was tried next but that resize event also
    retriggered the theme's own header-position script, undoing the shift.
    Both are removed — this static-flow approach needs neither.)

  The x button hides it and remembers the choice (localStorage).

  Does NOT touch #wwkPreactRoot (the app's own floating badge). That badge
  already never renders on mobile (confirmed empty container there), and
  hiding it via CSS made the app's own script misbehave and break the page
  layout — so it's left alone entirely.

  To update the numbers, edit sg_review_score / sg_review_count below.
{%- endcomment -%}

{%- assign sg_review_score = '9,5' -%}
{%- assign sg_review_count = '4' -%}

<script>
  (function () {
    try {
      var dismissed = localStorage.getItem('sgReviewBarDismissed') === '1';
      if (!dismissed && window.matchMedia('(max-width: 989px)').matches) {
        document.documentElement.classList.add('sg-review-bar-on');
      }
    } catch (e) {}
  })();
</script>

<div class="sg-review-bar" role="region" aria-label="Klantbeoordeling">
  <div class="sg-review-bar__inner">
    <span class="sg-review-bar__score">{{ sg_review_score }}</span>
    <span class="sg-review-bar__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <span class="sg-review-bar__count">{{ sg_review_count }} Reviews</span>
    <span class="sg-review-bar__brand">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      WebwinkelKeur
    </span>
  </div>
  <button type="button" class="sg-review-bar__close" aria-label="Sluiten">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
</div>

<style>
  .sg-review-bar { display: none; }

  @media (max-width: 989px) {
    :root { --sg-review-bar-h: 40px; }

    html.sg-review-bar-on .sg-review-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      width: 100%;
      height: var(--sg-review-bar-h);
      padding: 0 10px 0 12px;
      background: #e6007e;
      color: #ffffff;
      font-size: 13px;
      line-height: 1;
      box-sizing: border-box;
    }

    /* Homepage: float over everything; shift the header's `top` to clear it. */
    html.sg-review-bar-on body.template-index .sg-review-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 60;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
    }

    html.sg-review-bar-on body.template-index .sg-header {
      top: var(--sg-review-bar-h) !important;
    }

    /* Every other page: normal in-flow block, first in <body> — ordinary
       document flow pushes the (already in-flow) header down naturally. */
    html.sg-review-bar-on body:not(.template-index) .sg-review-bar {
      position: static;
    }

    .sg-review-bar__inner {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
    }

    .sg-review-bar__score {
      flex: none;
      background: #ffffff;
      color: #e6007e;
      font-weight: 700;
      border-radius: 999px;
      padding: 3px 8px;
      font-size: 12px;
    }

    .sg-review-bar__stars {
      flex: none;
      color: #ffd21e;
      letter-spacing: 1px;
      font-size: 13px;
    }

    .sg-review-bar__count { flex: none; font-weight: 600; }

    .sg-review-bar__brand {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sg-review-bar__brand svg { flex: none; width: 14px; height: 14px; }

    .sg-review-bar__close {
      flex: none;
      width: 30px;
      height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 0;
      color: #ffffff;
      cursor: pointer;
      padding: 0;
    }

    .sg-review-bar__close svg { width: 18px; height: 18px; }
  }

  /* Below the smallest phones, drop the brand label so the bar never wraps. */
  @media (max-width: 359px) {
    .sg-review-bar__brand { display: none; }
  }
</style>

<script>
  (function () {
    var bar = document.querySelector('.sg-review-bar');
    if (!bar) return;
    var closeBtn = bar.querySelector('.sg-review-bar__close');
    if (!closeBtn) return;
    closeBtn.addEventListener('click', function () {
      document.documentElement.classList.remove('sg-review-bar-on');
      try { localStorage.setItem('sgReviewBarDismissed', '1'); } catch (e) {}
    });
  })();
</script>
