{%- comment -%}
  Image for sections/custom-product-story.liquid: the image picked in the section settings, or the theme asset that ships
  with the section when nothing is picked.

  Usage:
    {% render 'story-image', image: section.settings.hero_image, asset: 'meari-story-hero.webp', width: 2400, height: 1241, sizes: '100vw', alt: '' %}

  - image   the image_picker value (can be blank)
  - asset   file name in assets/ used when image is blank, with its pixel width and height
  - sizes   the sizes attribute; class and loading are optional (loading defaults to lazy)
{%- endcomment -%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 1600 }}"
    srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2400 }} 2400w"
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    alt="{{ alt | default: image.alt | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    {% if class != blank %}class="{{ class }}"{% endif %}
  >
{%- else -%}
  <img
    src="{{ asset | asset_url }}"
    width="{{ width }}"
    height="{{ height }}"
    alt="{{ alt | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    {% if class != blank %}class="{{ class }}"{% endif %}
  >
{%- endif -%}
