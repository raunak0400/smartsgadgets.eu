{%- comment -%}
  Heading, optional text and two images side by side, for sections/custom-product-story.liquid.
  Both images get the same height: each one grows in proportion to its own aspect ratio, so a portrait and a landscape
  image still line up.

  Usage:
    {% render 'story-pair',
      modifier: 'audio',
      heading: section.settings.audio_heading,
      text: section.settings.audio_text,
      image_1: section.settings.audio_image_1, asset_1: 'meari-story-audio-1.webp', width_1: 960, height_1: 1248,
      image_2: section.settings.audio_image_2, asset_2: 'meari-story-audio-2.webp', width_2: 1843, height_2: 1248
    %}
{%- endcomment -%}
{%- liquid
  if image_1 != blank
    assign ratio_1 = image_1.aspect_ratio
  else
    assign ratio_1 = width_1 | times: 1.0 | divided_by: height_1
  endif
  if image_2 != blank
    assign ratio_2 = image_2.aspect_ratio
  else
    assign ratio_2 = width_2 | times: 1.0 | divided_by: height_2
  endif
-%}
<section class="sg-story__section sg-story__pair-section sg-story__pair-section--{{ modifier }}">
  <div class="sg-story__wrap">
    {%- if heading != blank -%}
      <h2 class="sg-story__h2">{{ heading }}</h2>
    {%- endif -%}
    {%- if text != blank -%}
      <p class="sg-story__sub">{{ text }}</p>
    {%- endif -%}
    <div class="sg-story__pair">
      <figure class="sg-story__pair-item" style="--ratio: {{ ratio_1 | round: 4 }}">
        {% render 'story-image', image: image_1, asset: asset_1, width: width_1, height: height_1, sizes: '(min-width: 750px) 50vw, 100vw', alt: heading %}
      </figure>
      <figure class="sg-story__pair-item" style="--ratio: {{ ratio_2 | round: 4 }}">
        {% render 'story-image', image: image_2, asset: asset_2, width: width_2, height: height_2, sizes: '(min-width: 750px) 60vw, 100vw', alt: heading %}
      </figure>
    </div>
  </div>
</section>
