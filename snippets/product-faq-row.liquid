{% doc %}
  Renders one FAQ accordion row using the theme's shared disclosure markup.
  @param {string} question - The question heading
  @param {string} answer - The answer text
  @example
  {% render 'product-faq-row', question: 'What is this?', answer: 'This is a thing.' %}
{% enddoc %}
<details-disclosure>
  <details class="disclosure disclosure--row">
    <summary>
      <div class="flex justify-between items-center">
        <h3 class="disclosure__title xs:regular-text h6 font-body flex flex-auto items-center mb-0 text-current">
          {{- question -}}
        </h3>
        <span class="disclosure__toggle">
          {%- if settings.disclosure_toggle == 'plus' -%}
            {% render 'icon-plus' %}
          {%- else -%}
            {% render 'icon-chevron-down' %}
          {%- endif -%}
        </span>
      </div>
    </summary>
    <div class="disclosure__panel has-motion">
      <div class="disclosure__content rte">
        <p>{{ answer }}</p>
      </div>
    </div>
  </details>
</details-disclosure>
