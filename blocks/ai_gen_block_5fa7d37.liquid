{% doc %}
  @prompt
    <div class="custom-payment-icons" {{ section.shopify_attributes }}>
      {{ 'paypal' | payment_type_svg_tag }}
      {{ 'ideal' | payment_type_svg_tag }}
      {{ 'visa' | payment_type_svg_tag }}
      {{ 'master' | payment_type_svg_tag }}
      {{ 'american_express' | payment_type_svg_tag }}
      {{ 'bancontact' | payment_type_svg_tag }}
      {{ 'apple_pay' | payment_type_svg_tag }}
      {{ 'google_pay' | payment_type_svg_tag }}
      {{ 'shop_pay' | payment_type_svg_tag }}
    </div>
    
    <style>
      .custom-payment-icons {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 18px 0;
      }
    
      .custom-payment-icons svg {
        width: auto;
        height: 32px;
        background: #ffffff;
        border-radius: 5px;
      }
    
      @media screen and (max-width: 749px) {
        .custom-payment-icons {
          gap: 8px;
          padding: 14px 10px;
        }
    
        .custom-payment-icons svg {
          height: 28px;
        }
      }
    </style>
    
    {% schema %}
    {
      "name": "Payment Method Icons",
      "settings": [],
      "presets": [
        {
          "name": "Payment Method Icons"
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-payment-icons-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_gap }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-payment-icons-wrapper-{{ ai_gen_id }} svg {
    width: auto;
    height: {{ block.settings.icon_height }}px;
    background: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-payment-icons-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_gap_mobile }}px;
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-payment-icons-wrapper-{{ ai_gen_id }} svg {
      height: {{ block.settings.icon_height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-payment-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-payment-icons-wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_paypal %}
      {{ 'paypal' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_ideal %}
      {{ 'ideal' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_visa %}
      {{ 'visa' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_mastercard %}
      {{ 'master' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_amex %}
      {{ 'american_express' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_bancontact %}
      {{ 'bancontact' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_apple_pay %}
      {{ 'apple_pay' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_google_pay %}
      {{ 'google_pay' | payment_type_svg_tag }}
    {% endif %}
    {% if block.settings.show_shop_pay %}
      {{ 'shop_pay' | payment_type_svg_tag }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Payment icons",
  "settings": [
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "PayPal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ideal",
      "label": "iDEAL",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "American Express",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bancontact",
      "label": "Bancontact",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_apple_pay",
      "label": "Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_google_pay",
      "label": "Google Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shop_pay",
      "label": "Shop Pay",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Gap between icons",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_gap_mobile",
      "label": "Gap on mobile",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon height",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "icon_height_mobile",
      "label": "Icon height on mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Icon corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show icon border",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e1e1e1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "label": "Vertical padding on mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Horizontal padding on mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Payment icons"
    }
  ]
}
{% endschema %}
