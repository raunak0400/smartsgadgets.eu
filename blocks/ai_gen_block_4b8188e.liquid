{% doc %}
  @prompt
    <div class="footer-logos-row">
      <div class="footer-logos-inner">
    
        <div class="footer-logo-group shipping-logos">
          {% for block in section.blocks %}
            {% if block.type == 'shipping_logo' and block.settings.logo != blank %}
              <img
                src="{{ block.settings.logo | image_url: width: 180 }}"
                alt="{{ block.settings.name }}"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        </div>
    
        <div class="footer-logo-divider"></div>
    
        <div class="footer-logo-group payment-logos">
          {{ 'paypal' | payment_type_svg_tag }}
          {{ 'ideal' | payment_type_svg_tag }}
          {{ 'visa' | payment_type_svg_tag }}
          {{ 'master' | payment_type_svg_tag }}
          {{ 'american_express' | payment_type_svg_tag }}
          {{ 'bancontact' | payment_type_svg_tag }}
          {{ 'apple_pay' | payment_type_svg_tag }}
          {{ 'google_pay' | payment_type_svg_tag }}
        </div>
    
      </div>
    </div>
    
    <style>
    .footer-logos-row {
      background: #151719;
      border-bottom: 8px solid #ff4b00;
      padding: 28px 15px;
    }
    
    .footer-logos-inner {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .footer-logo-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 26px;
      flex-wrap: wrap;
    }
    
    .shipping-logos img {
      max-height: 46px;
      max-width: 120px;
      object-fit: contain;
    }
    
    .payment-logos svg {
      height: 34px;
      width: auto;
      background: #ffffff;
      border-radius: 6px;
    }
    
    .footer-logo-divider {
      width: 1px;
      height: 52px;
      background: rgba(255,255,255,0.45);
    }
    
    @media screen and (max-width: 749px) {
      .footer-logos-row {
        padding: 22px 10px;
      }
    
      .footer-logos-inner {
        gap: 18px;
      }
    
      .footer-logo-group {
        gap: 14px;
      }
    
      .shipping-logos img {
        max-height: 34px;
        max-width: 90px;
      }
    
      .payment-logos svg {
        height: 28px;
      }
    
      .footer-logo-divider {
        display: none;
      }
    }
    </style>
    
    {% schema %}
    {
      "name": "Footer logos row",
      "settings": [],
      "blocks": [
        {
          "type": "shipping_logo",
          "name": "Shipping logo",
          "settings": [
            {
              "type": "image_picker",
              "id": "logo",
              "label": "Logo image"
            },
            {
              "type": "text",
              "id": "name",
              "label": "Logo name",
              "default": "Shipping company"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Footer logos row",
          "blocks": [
            { "type": "shipping_logo", "settings": { "name": "PostNL" } },
            { "type": "shipping_logo", "settings": { "name": "DHL" } },
            { "type": "shipping_logo", "settings": { "name": "DPD" } },
            { "type": "shipping_logo", "settings": { "name": "UPS" } },
            { "type": "shipping_logo", "settings": { "name": "GLS" } }
          ]
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-logos-{{ ai_gen_id }} {
    display: block;
    background: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.padding_desktop }}px 15px;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-footer-logos-inner-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.group_gap }}px;
    flex-wrap: wrap;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-footer-logo-group-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.logo_gap }}px;
    flex-wrap: wrap;
  }

  .ai-shipping-logos-{{ ai_gen_id }} img {
    max-height: {{ block.settings.shipping_logo_height }}px;
    max-width: {{ block.settings.shipping_logo_width }}px;
    object-fit: contain;
  }

  .ai-payment-logos-{{ ai_gen_id }} svg {
    height: {{ block.settings.payment_icon_height }}px;
    width: auto;
    background: {{ block.settings.payment_icon_bg }};
    border-radius: {{ block.settings.payment_icon_radius }}px;
  }

  .ai-footer-logo-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background: {{ block.settings.divider_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-footer-logos-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile }}px 10px;
    }

    .ai-footer-logos-inner-{{ ai_gen_id }} {
      gap: {{ block.settings.group_gap_mobile }}px;
    }

    .ai-footer-logo-group-{{ ai_gen_id }} {
      gap: {{ block.settings.logo_gap_mobile }}px;
    }

    .ai-shipping-logos-{{ ai_gen_id }} img {
      max-height: {{ block.settings.shipping_logo_height_mobile }}px;
      max-width: {{ block.settings.shipping_logo_width_mobile }}px;
    }

    .ai-payment-logos-{{ ai_gen_id }} svg {
      height: {{ block.settings.payment_icon_height_mobile }}px;
    }

    {% if block.settings.hide_divider_mobile %}
      .ai-footer-logo-divider-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-footer-logos-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-logos-inner-{{ ai_gen_id }}">

    <div class="ai-footer-logo-group-{{ ai_gen_id }} ai-shipping-logos-{{ ai_gen_id }}">
      {% if block.settings.shipping_logo_1 != blank %}
        <img
          src="{{ block.settings.shipping_logo_1 | image_url: width: 240 }}"
          alt="{{ block.settings.shipping_name_1 }}"
          loading="lazy"
          width="120"
          height="60"
        >
      {% endif %}
      {% if block.settings.shipping_logo_2 != blank %}
        <img
          src="{{ block.settings.shipping_logo_2 | image_url: width: 240 }}"
          alt="{{ block.settings.shipping_name_2 }}"
          loading="lazy"
          width="120"
          height="60"
        >
      {% endif %}
      {% if block.settings.shipping_logo_3 != blank %}
        <img
          src="{{ block.settings.shipping_logo_3 | image_url: width: 240 }}"
          alt="{{ block.settings.shipping_name_3 }}"
          loading="lazy"
          width="120"
          height="60"
        >
      {% endif %}
      {% if block.settings.shipping_logo_4 != blank %}
        <img
          src="{{ block.settings.shipping_logo_4 | image_url: width: 240 }}"
          alt="{{ block.settings.shipping_name_4 }}"
          loading="lazy"
          width="120"
          height="60"
        >
      {% endif %}
      {% if block.settings.shipping_logo_5 != blank %}
        <img
          src="{{ block.settings.shipping_logo_5 | image_url: width: 240 }}"
          alt="{{ block.settings.shipping_name_5 }}"
          loading="lazy"
          width="120"
          height="60"
        >
      {% endif %}
    </div>

    {% if block.settings.show_divider %}
      <div class="ai-footer-logo-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-footer-logo-group-{{ ai_gen_id }} ai-payment-logos-{{ ai_gen_id }}">
      {% if block.settings.show_paypal %}
        {{ 'paypal' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_ideal %}
        {{ 'ideal' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_visa %}
        {{ 'visa' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_mastercard %}
        {{ 'master' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_amex %}
        {{ 'american_express' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_bancontact %}
        {{ 'bancontact' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_apple_pay %}
        {{ 'apple_pay' | payment_type_svg_tag }}
      {% endif %}
      {% if block.settings.show_google_pay %}
        {{ 'google_pay' | payment_type_svg_tag }}
      {% endif %}
    </div>

  </div>
</div>

